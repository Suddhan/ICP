@file 197:
@file 198: # Create well taps
@file 199: # Explanation : We need to add well taps, to bias the bulk of the transistors to the correct potential
@file 200: #               According to the documentation, the maximum distance a cell can have to a well tap is 30um.
@file 201: #               This means that if we space the well taps with 60um, all cells will be within the 30um range of a tap.
@@file 202: add_well_taps -cell_interval 60
