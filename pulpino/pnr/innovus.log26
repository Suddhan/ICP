  rows(root)            # row*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .rows]
  run_abstract_abstract_blockage_cut_around_pin(root)
                        # string, read/write, default={}, indices={}
                        # For std cell, we do not want cover obs on pin. So:
                        # If -input_cell_type {std}, setting the value to all metal and via layer name list.
                        # If -input_cell_type {block} or -input_cell_type {io}, setting the value to all via layer name list.
  run_abstract_antenna_connectivity(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers for which connectivity is to be extracted. The syntax is {<layer1> <connect_layer> <layer2>}.
  run_abstract_antenna_diffusion_geometry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies diffusion layer, followed by expression to remove gate channel area from diffusion region.
  run_abstract_antenna_gate_geometry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies poly layer that forms a gate, and then the layer expression to derive the gate area. This option also triggers the creation of antenna models.
  run_abstract_blockage_detailed_layers(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers for which a detailed blockage model is to be created. The detailed blockage model generates blockages only where there are real shapes in the cell on the layer.
                        # This only applies to IO cells and block cells, it does not apply to standard cells.
  run_abstract_boundary_layers(root)
                        # string, read/write, default={}, indices={}
                        # By default this list is empty, and the prBoundary is used. The prBoundary comes from an explicit GDS layer that is used to compute the LEF SIZE (and OVERLAP OBS shapes for rectilinear
                        # boundaries). If there is no explicit GDS prBoundary layer, the boundary can be computed from the bounding box of geometries on this list of layers. Note, this option is almost never
                        # correct for core standard cells.
  run_abstract_cell_symmetry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies a property value for cell symmetry. The valid values for the property symmetry include: {R0 | X | Y | R90 | X Y | X R90 | Y R90 | X Y R90}. Default {X Y}
  run_abstract_export_lef_version(root)
                        # enum {5.3 5.4 5.5 5.6 5.7 5.8}, read/write, default=5.7, indices={}
                        # Version of LEF to export. The default version is the same  as the version of technology LEF file being imported.
  run_abstract_extract_layers_power(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers through which the extractor extracts  each power net. This is used to reduce the search space if abstract is taking too much run time for each cell. Usually not
                        # applicable to standard cells. For blocks it is common to only extract the power nets on the top one or two metal layers.
  run_abstract_extract_layers_signal(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers through which the extractor extracts  each net. This is used to reduce the search space if abstract is taking too much run time for each cell. Usually not
                        # applicable to standard cells.
  run_abstract_extract_pin_layers_power(root)
                        # string, read/write, default={}, indices={}
                        # Determines which of the shapes found by the extractor should be turned into pins. This argument is valid only if the associated layer, geometry specification and connectivity have been
                        # provided in the technology LEF. Usually not applicable to standard cells.
  run_abstract_extract_pin_layers_signal(root)
