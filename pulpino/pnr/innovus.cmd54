#@ Begin verbose source floorplan.tcl (pre)
set_db [get_db base_cells -if {.class == core}] .symmetry xy ;
set_db design_process_node 65
set_db design_top_routing_layer M7
set_db design_bottom_routing_layer M2 
set_db design_flow_effort standard ;
set_db design_power_effort low ;
set_db timing_analysis_cppr           both
set_db timing_analysis_type           ocv
set_preference CmdLogMode 2 ;
set core_dx [expr [get_db [lindex [get_db insts -if {.name == *sram*}] 0] .bbox.dx] * 10] ;
set core_dy 1390 ;
create_floorplan -site CORE -core_size $core_dx $core_dy 30 30 30 30
