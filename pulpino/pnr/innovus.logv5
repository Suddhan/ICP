[04/27 14:27:15     50s]   timing_check_timing_signal_level_high_to_low_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Threshold for warnig about difference in signal level between hight_drv and
[04/27 14:27:15     50s]                         # low_rcv
