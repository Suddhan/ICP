[04/27 14:27:15     50s]                         # When set to true, the aocv stage counts are recalculated when timing is reset.
[04/27 14:27:15     50s]   timing_apply_check_derate_to_external_output_delay(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Applies check derate to output external delay
[04/27 14:27:15     50s]   timing_apply_default_primary_input_assertion(root)
