[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Identifies self-loop paths at the specified threshold
[04/27 14:27:15     50s]   timing_set_clock_source_to_output_as_data(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, causes a clock source path leading to an output or bidi port
[04/27 14:27:15     50s]                         # to be treated as a data path if there is a set_output_delay or set_data_check
[04/27 14:27:15     50s]                         # assertion on the port
[04/27 14:27:15     50s]   timing_socv_preserve_variation_with_annotations(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   timing_socv_rc_variation_mode(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enable interconnect variation mode in SOCV mode
[04/27 14:27:15     50s]   timing_socv_statistical_min_max_mode(root)
[04/27 14:27:15     50s]                         # enum {statistical three_sigma_bounded mean_and_sigma_bounded
[04/27 14:27:15     50s]                         # mean_and_three_sigma_bounded max_mean_and_sigma}, read/write,
[04/27 14:27:15     50s]                         # default=mean_and_three_sigma_bounded, indices={}
[04/27 14:27:15     50s]                         # Controls worstcasing mode to be used for SOCV
[04/27 14:27:15     50s]   timing_socv_view_based_nsigma_multiplier_mode(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables setting of view-based separate setup and hold sigma multipliers
[04/27 14:27:15     50s]   timing_spatial_derate_chip_size(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1e+30, indices={}
[04/27 14:27:15     50s]   timing_spatial_derate_distance_mode(root)
[04/27 14:27:15     50s]                         # enum {bounding_box chip_size}, read/write, default=bounding_box, indices={}
[04/27 14:27:15     50s]   timing_suppress_escape_characters(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Suppresses the reporting of escape characters in timing object names
[04/27 14:27:15     50s]   timing_suppress_ilm_constraint_mismatches(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, the software suppresses all error and warning messages
[04/27 14:27:15     50s]                         # related to objects not found when loading SDC constraint files for the ILM flow
[04/27 14:27:15     50s]   timing_time_unit(root)
[04/27 14:27:15     50s]                         # string, read/write, default=none, indices={}
[04/27 14:27:15     50s]                         # This value is passed to set_library_unit -time to set the time units used in
[04/27 14:27:15     50s]                         # timing library and .sdc files and timing reports. Legal values are none, 1ns,
[04/27 14:27:15     50s]                         # 1ps, 10ps, 100ps.
[04/27 14:27:15     50s]   timing_use_clock_pin_attribute_for_clock_net_marking(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # To allow the propagation of clocks to pins with clock attributes regardless of
[04/27 14:27:15     50s]                         # the presence of check arcs or trigger arcs at the pins
[04/27 14:27:15     50s]   timing_use_incremental_si_transition(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, enables usage of incremental slew during DRV violation
[04/27 14:27:15     50s]                         # reporting
[04/27 14:27:15     50s]   timing_use_latch_early_launch_edge(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables the latch use early launch edge feature.
[04/27 14:27:15     50s]   timing_use_latch_time_borrow(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # When set to false, does not consider time borrowing during timing analysis.
[04/27 14:27:15     50s]                         # Time borrowing is the amount of time borrowed by a previous logic
[04/27 14:27:15     50s]   timing_waveform_aware_pulse_width_checks_high_voltage_level(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.95, indices={}
[04/27 14:27:15     50s]                         # User to specify high voltage level to be used for waveform aware pulse-width
[04/27 14:27:15     50s]                         # checks
[04/27 14:27:15     50s]   timing_waveform_aware_pulse_width_checks_low_voltage_level(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.05, indices={}
[04/27 14:27:15     50s]                         # User to specify low voltage level to be used for waveform aware pulse-width
[04/27 14:27:15     50s]                         # checks
[04/27 14:27:15     50s]   timing_write_sdf_no_escape_backslash(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Supports various patterns of the escape character.
[04/27 14:27:15     50s]   top_sdps(root)        # sdp*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all top level structured data path (sdp) objects.
[04/27 14:27:15     50s]   trace_obj_macro_pins(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # specify macro pin name patterns in regular expression
[04/27 14:27:15     50s]   trace_obj_max_fanin_fanout(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1000, indices={}
[04/27 14:27:15     50s]                         # Specify the maximum number of a pin's fanin/fanout,a pin will be ignored in
[04/27 14:27:15     50s]                         # tracing connectivity if its fanin/fanout larger than the specified number
[04/27 14:27:15     50s]   trace_obj_register_inputs(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify register input pin names
[04/27 14:27:15     50s]   trace_obj_register_outputs(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify register output pin names
[04/27 14:27:15     50s]   track_patterns(root)  # track_pattern*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the track_pattern objects in the design.
[04/27 14:27:15     50s]   trim_grids(root)      # trim_grid*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the trim_grid objects in the design from the LEF
[04/27 14:27:15     50s]                         # TRIMMETALTRACK statement.
[04/27 14:27:15     50s]   ui_precision(root)    # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed in timing reports
[04/27 14:27:15     50s]                         # for data with no specific type.
[04/27 14:27:15     50s]   ui_precision_capacitance(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed in timing reports
[04/27 14:27:15     50s]                         # for data of type capacitance.
[04/27 14:27:15     50s]   ui_precision_derating(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed in timing reports
[04/27 14:27:15     50s]                         # for derating factors such as those specified via set_timing_derate constraints
[04/27 14:27:15     50s]                         # or AOCV derating libraries.
[04/27 14:27:15     50s]   ui_precision_power(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed in timing reports
[04/27 14:27:15     50s]                         # for data of type power.
[04/27 14:27:15     50s]   ui_precision_sensitivities(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed in timing reports
[04/27 14:27:15     50s]                         # for statistical sensitivity values and SOCV sigma values.
[04/27 14:27:15     50s]   ui_precision_timing(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of significant digits to be displayed for timing reports
[04/27 14:27:15     50s]                         # for delay type values including cell and net delays, transitions, arrival and
[04/27 14:27:15     50s]                         # required times, and slacks.
[04/27 14:27:15     50s]   ui_units_capacitance(root)
[04/27 14:27:15     50s]                         # enum {1pf 1ff 10ff 100ff}, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # capacitance unit for CUI
[04/27 14:27:15     50s]   ui_units_capacitance_reporting(root)
[04/27 14:27:15     50s]                         # enum {1pf 1ff 10ff 100ff}, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Capacitance reporting unit for CUI
[04/27 14:27:15     50s]   ui_units_timing(root)
[04/27 14:27:15     50s]                         # enum {1ns 1ps 10ps 100ps}, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # timing uinit for CUI
[04/27 14:27:15     50s]   ui_units_timing_reporting(root)
[04/27 14:27:15     50s]                         # enum {1ns 1ps 10ps 100ps}, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Time reporting unit for CUI
[04/27 14:27:15     50s]   via_def_rules(root)   # via_def_rule*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # All the via_def_rules defined in the LEF or OpenAccess techfile.
[04/27 14:27:15     50s]   via_defs(root)        # via_def*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # All the via_defs (via master definitions).
[04/27 14:27:15     50s]   write_db_auto_save_user_globals(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, write_db automatically saves user created Tcl global variables. User
[04/27 14:27:15     50s]                         # globals are defined as any "info globals" names that do not exist at startup
[04/27 14:27:15     50s]                         # (e.g. created by user executed code). See the define_variables command to add
[04/27 14:27:15     50s]                         # or delete specific Tcl variables from the automatic save list.
[04/27 14:27:15     50s]   write_db_binary_timing_constraints(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If true, write_db will save timing constraints in binary format. The value of
[04/27 14:27:15     50s]                         # the global should be persistent in subsequent write_db and read_db operations.
[04/27 14:27:15     50s]   write_db_cmd_file_limit(root)
[04/27 14:27:15     50s]                         # int, read/write, default=10, indices={}
[04/27 14:27:15     50s]                         # write_db saves the complete .cmd history across multiple sessions in the
[04/27 14:27:15     50s]                         # inn.cmd.gz file inside the save directory up to this file length limit in units
[04/27 14:27:15     50s]                         # of Mb. If it is set to 0, no history is saved at all
[04/27 14:27:15     50s]   write_db_copy_timing_constraints_always(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether SDC files are always copied to the DB directory rather than
[04/27 14:27:15     50s]                         # links to external SDC files. By default they are only copied if the constraints
[04/27 14:27:15     50s]                         # were modified.
[04/27 14:27:15     50s]   write_db_create_read_file(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, 'write_db my_db' will also create a 'my_db.read' file with a 'read_db
[04/27 14:27:15     50s]                         # my_db' command inside it.  This is a Tcl file that can be passed to the Linux
[04/27 14:27:15     50s]                         # executable to make it easy to load the DB at startup like this: 'innovus -files
[04/27 14:27:15     50s]                         # my_db.read'. For OA usage, it would have the appropriate 'read_db
[04/27 14:27:15     50s]                         # -oa_lib_cell_view {<lib> <cell> <view>}' command inside it.
[04/27 14:27:15     50s]   write_db_include_metal_fill_rules(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # specify whether to save metalfill settings
[04/27 14:27:15     50s]   write_db_save_unused_lef_block_names(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether to remember a list of unused macros during saving
[04/27 14:27:15     50s]   write_def_compress_vias(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Compress the via statement in SPECIALNETS section. This variable controls
[04/27 14:27:15     50s]                         # write_def to sort vias with two dimension array, so it can use 'DO numX BY numY
[04/27 14:27:15     50s]                         # STEP stepX stepY' statement.
[04/27 14:27:15     50s]   write_def_hierarchy_delimiter(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify the write_def hierarchy delimiter.
[04/27 14:27:15     50s]   write_def_include_lef_ndr(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Output LEF NONDEFAULTRULES in DEF. This variable controls write_def to output
[04/27 14:27:15     50s]                         # LEF nondefault rule information. By default, write_def does not write out
[04/27 14:27:15     50s]                         # nondefaultrules defined in LEF. Set this variable to true to output nondefault
[04/27 14:27:15     50s]                         # rules defined in LEF .
[04/27 14:27:15     50s]   write_def_include_lef_vias(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Output LEF vias in DEF. This variable controls write_def to output LEF via
[04/27 14:27:15     50s]                         # information. By default, write_def does not write out via defined in LEF. Set
[04/27 14:27:15     50s]                         # this variable to true to output LEF via.
[04/27 14:27:15     50s]   write_def_lef_out_version(root)
[04/27 14:27:15     50s]                         # enum {5.5 5.6 5.7 5.8 6.0}, read/write, default=5.8, indices={}
[04/27 14:27:15     50s]                         # Specify LEF/DEF output version. Possible string value are 5.5, 5.6, 5.7, 5.8
[04/27 14:27:15     50s]                         # and 6.0. The default is 5.8.
[04/27 14:27:15     50s]   write_def_polygon_die_area(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # By default write_def writes out polygon DIEAREA if the design is rectilinear.
[04/27 14:27:15     50s]                         # To write out rectangular DIEAERA along with blockages in cut-out area for a
[04/27 14:27:15     50s]                         # rectilinear design, set this variable to false.
[04/27 14:27:15     50s]   write_def_stream_check_uncolored(root)
[04/27 14:27:15     50s]                         # enum {true 1 false 0 metal_only}, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify how to check and ignore uncolored shapes on DPT layers during DEF out
[04/27 14:27:15     50s]                         # and stream out. If true or 1, checks uncolored shapes on all DPT layers; if
[04/27 14:27:15     50s]                         # false or 0, doesn't do check; if metal_only, only checks uncolored shapes on
[04/27 14:27:15     50s]                         # metal layers, uncolored shapes on cut layers are ignored. It’s automatically
[04/27 14:27:15     50s]                         # set to metal_only for TSMC N5 and below nodes.
[04/27 14:27:15     50s]   write_lec_dft_constraints(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # This attribute is a TCL dict and holds the LEC dft pin constraints from the
[04/27 14:27:15     50s]                         # last LEC run by Genus. It is passed forward through write_design. The
[04/27 14:27:15     50s]                         # write_do_lec command will automatically include this constraints in the do
[04/27 14:27:15     50s]                         # file.
[04/27 14:27:15     50s]   write_lec_directory_naming_style(root)
[04/27 14:27:15     50s]                         # string, read/write, default=fv/invs/%s, indices={}
[04/27 14:27:15     50s]                         # The directory name where 'write_do_lec' will write verification files when the
[04/27 14:27:15     50s]                         # 'write_lec_files' attribute is 'true'. The directory will be created if it does
[04/27 14:27:15     50s]                         # not already exist, and will overwrite an existing directory of the same name. A
[04/27 14:27:15     50s]                         # %s in the string is replaced with the design name (e.g. it will overwrite the
[04/27 14:27:15     50s]                         # directory for the same design but not for a different design). A %d in the
[04/27 14:27:15     50s]                         # string is replaced with a unique integer to avoid overwriting any existing
[04/27 14:27:15     50s]                         # directory.
[04/27 14:27:15     50s]   write_lec_files(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies whether 'write_do_lec' should write intermediate files to the
[04/27 14:27:15     50s]                         # verification directory specified by the 'write_lec_directory_naming_style'
[04/27 14:27:15     50s]                         # attribute. If false, no files are written.
[04/27 14:27:15     50s]   write_lef_abstract_customer_header(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Write lef abstract files with customer specified header information.
[04/27 14:27:15     50s]   write_netlist_full_pin_out(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Output all pins.
[04/27 14:27:15     50s]   write_netlist_port_association_style(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Do implicit port mapping.
[04/27 14:27:15     50s]   write_stream_allow_path_type4(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If false, converts PATHTYPE4 to PATHTYPE0.
[04/27 14:27:15     50s]   write_stream_cell_instance_color(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # stream out the instance based color. The instance mask shift is honored in
[04/27 14:27:15     50s]                         # write_stream. When the option is on and -merge option is used, the merged gds
[04/27 14:27:15     50s]                         # files with mask shift suffix must be provided through option -merge.
[04/27 14:27:15     50s]   write_stream_cell_master_color(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # stream out the cell based color from innovus color engine.
[04/27 14:27:15     50s]   write_stream_cell_name_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Add a prefix to ALL cell names being written out, use user specified prefix can
[04/27 14:27:15     50s]                         # avoid potential conflict when integrating different macros, which potentially 2
[04/27 14:27:15     50s]                         # different cells (in 2 different libraries) with the same name.
[04/27 14:27:15     50s]   write_stream_cell_name_suffix(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Instead of appending color pattern to normal cell names, use user specified
[04/27 14:27:15     50s]                         # suffix. This applies to fixed color shift (flip) pattern only. i.e., only
[04/27 14:27:15     50s]                         # single shift (flip) pattern applied to the design.
[04/27 14:27:15     50s]   write_stream_check_map_file(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Check the specified map file. If the objects existed in innovus, but the
[04/27 14:27:15     50s]                         # objects have no objects mapping in map file, print the missed objects mapping
[04/27 14:27:15     50s]                         # and missed objects in log file, only the main objects mapping are checked by
[04/27 14:27:15     50s]                         # the option.
[04/27 14:27:15     50s]   write_stream_compatible(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Output instance only is FOREIGN is specified.
[04/27 14:27:15     50s]   write_stream_define_via_name(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices={}
[04/27 14:27:15     50s]                         # Specifies the naming convention that the write_stream command uses for via
[04/27 14:27:15     50s]                         # cells declared in the DEF file.
[04/27 14:27:15     50s]   write_stream_ignore_fixed_mask(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Ignore macro FIXEDMASK keywords, enable color flip function.
[04/27 14:27:15     50s]   write_stream_label_all_pin_shape(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, label pin name to its all shapes.
[04/27 14:27:15     50s]   write_stream_merge_append(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Append cell color information in current design to cell geometries that are
[04/27 14:27:15     50s]                         # from merging files. This option is for TSMC 10nm fixed-mask design. It is
[04/27 14:27:15     50s]                         # exclusive with write_stream_ignore_inst_color attribute and
[04/27 14:27:15     50s]                         # write_stream_ignore_inst_cce_color attribute, it will set those two attributes
[04/27 14:27:15     50s]                         # to false automatically when it is set to true.
[04/27 14:27:15     50s]   write_stream_merge_trim_shapes(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify the setting for trim shapes merge. layers, specify the layer list which
[04/27 14:27:15     50s]                         # need merge trim shapes. gap merge, the trim shapes when end to end gap is less
[04/27 14:27:15     50s]                         # the value. max_trim_num, specify the max trim shapes number are merged. masks,
[04/27 14:27:15     50s]                         # specify the trim shapes color need to be merged.
[04/27 14:27:15     50s]   write_stream_oasis_cell_offset(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Include cell offset table to declare the byte offset from the beginning of the
[04/27 14:27:15     50s]                         # file (byte 0) to where the corresponding CELL record appears in the file.
[04/27 14:27:15     50s]   write_stream_oasis_compression(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # CBLOCK compression is partial-selective encryption technology uses OASIS CBLOCK
[04/27 14:27:15     50s]                         # records to encrypt arbitrarily encapsulated sets of data records within an
[04/27 14:27:15     50s]                         # OASIS layout file.
[04/27 14:27:15     50s]                         # REPETITION compression supports an 'array' of cell placements, geometries, or
[04/27 14:27:15     50s]                         # text elements, instead of write each the element separate only different in
[04/27 14:27:15     50s]                         # position, this can save duplicate information for an OASIS layout file size.
[04/27 14:27:15     50s]   write_stream_oasis_layer_name(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Support LAYERNAME in OASIS file.
[04/27 14:27:15     50s]   write_stream_pin_text_orientation(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Output pin name on the boundary of design to improve readability.
[04/27 14:27:15     50s]   write_stream_remove_nets(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Don't output nets in the list.
[04/27 14:27:15     50s]   write_stream_snap_to_mfg(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Snap net's wire to manufacture grid if it is not.
[04/27 14:27:15     50s]   write_stream_stream_convert_rect_to_path(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When enabled, DEF SPECIALNETS path/rect and FILLS shapes are converted to
[04/27 14:27:15     50s]                         # GDSII/stream PATH data instead of BOUNDARY data. Conversion to path data can
[04/27 14:27:15     50s]                         # result in significantly smaller output database when there are many rectangle
[04/27 14:27:15     50s]                         # shapes (example: after metal fill is included).
[04/27 14:27:15     50s]   write_stream_stream_version(root)
[04/27 14:27:15     50s]                         # int, read/write, default=3, indices={}
[04/27 14:27:15     50s]                         # Specify GDSII version to output.
[04/27 14:27:15     50s]   write_stream_text_size(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.0, indices={}
[04/27 14:27:15     50s]                         # Changes the size of the text used in the text labels.
[04/27 14:27:15     50s]   write_stream_uniquify_cell_names_prefix(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Adds a prefix, instead of a suffix, to uniquified cell names.
[04/27 14:27:15     50s]   write_stream_via_names(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Determines the naming convention used for vias declared in the LEF file.
[04/27 14:27:15     50s]   write_stream_virtual_connection(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies whether a colon (:) label is appended to pin names for DEF pins with
[04/27 14:27:15     50s]                         # the .extraN syntax and to LEF pins with multiple ports (if -output_macros is
[04/27 14:27:15     50s]                         # specified for LEF pin ports that have disjoint shapes).
[04/27 14:27:15     50s] 
