[04/27 14:27:15     50s]   timing_analysis_honor_active_logic_view(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Honor Active Logic View
[04/27 14:27:15     50s]   timing_analysis_precision_ps(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.01, indices={}
