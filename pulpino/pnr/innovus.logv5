[04/27 14:27:15     50s]   design_tech_node(root)
[04/27 14:27:15     50s]                         # enum {N22 N12 N10 N7 N7Plus N6 N5 N5PlusPlus N4 N3 N3E N2 S11 S10 S8 S7 S5 S4
[04/27 14:27:15     50s]                         # S3 S2 G7 G5 ICF I7 I5 P1222 P1276 P1277 P1278 P1280 C12 C7 unspecified},
[04/27 14:27:15     50s]                         # read/write, default=unspecified, indices={}
[04/27 14:27:15     50s]                         # set design tech node
[04/27 14:27:15     50s]   design_top_routing_layer(root)
