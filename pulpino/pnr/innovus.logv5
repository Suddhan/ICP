[04/27 14:27:15     50s]   check_ac_limit_current_scale_table(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the layer-based scale table for current
[04/27 14:27:15     50s]   check_ac_limit_default_freq_for_unconstrained_nets(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1e+06, indices={}
