[04/27 14:27:15     50s]   timing_analysis_socv(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # SOCV Analysis
[04/27 14:27:15     50s]   timing_analysis_type(root)
[04/27 14:27:15     50s]                         # enum {single best_case_worst_case ocv}, read/write,
[04/27 14:27:15     50s]                         # default=best_case_worst_case, indices={}
[04/27 14:27:15     50s]                         # Single or BCWC or OCV TimingAnalysis type
[04/27 14:27:15     50s]   timing_aocv_analysis_mode(root)
[04/27 14:27:15     50s]                         # enum {launch_capture clock_only separate_data_clock combine_launch_capture},
[04/27 14:27:15     50s]                         # read/write, default=launch_capture, indices={}
[04/27 14:27:15     50s]                         # Controls handling of AOCV analysis modes
[04/27 14:27:15     50s]   timing_aocv_chip_size(root)
