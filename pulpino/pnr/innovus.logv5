[04/27 14:27:15     50s]                         # (CPPR) analysis is allowed to leave in the path
[04/27 14:27:15     50s]   timing_cppr_transition_sense(root)
[04/27 14:27:15     50s]                         # enum {normal same_transition same_transition_expanded}, read/write,
[04/27 14:27:15     50s]                         # default=normal, indices={}
