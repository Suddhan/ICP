[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify whether design boundary can be changed to rectilinear shape.
[04/27 14:27:15     50s]   floorplan_finfet_inst_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The finfet_inst grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin
[04/27 14:27:15     50s]                         # is lower left corner of core box.  (e.g. the core rows). The x_pitch is default
[04/27 14:27:15     50s]                         # technical site's width and separates the vertical grid lines. The y_pitch is
[04/27 14:27:15     50s]                         # FinFET pitch as defined in LEF and separates the horizontal grid lines.
[04/27 14:27:15     50s]   floorplan_finfet_manufacturing_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The finfet_manufacturing grid {x_origin y_origin x_pitch y_pitch}. The x_origin
[04/27 14:27:15     50s]                         # y_origin is lower left corner of die box (the design .boundary). The x_pitch is
[04/27 14:27:15     50s]                         # Manufacture Grid value and defined in LEF. The y_pitch is FinFET pitch and
[04/27 14:27:15     50s]                         # defined in LEF.
[04/27 14:27:15     50s]   floorplan_finfet_placement_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The finfet_placement grid {x_origin y_origin x_pitch y_pitch}. The x _origin
[04/27 14:27:15     50s]                         # y_origin is lower left corner of die box (the design .boundary). The x_pitch is
[04/27 14:27:15     50s]                         # the pitch of lowest vertical metal layer and separates the vertical grid lines.
[04/27 14:27:15     50s]                         # The y_pitch is FinFET pitch as defined in LEF and separates the horizontal grid
[04/27 14:27:15     50s]                         # lines.
[04/27 14:27:15     50s]   floorplan_include_io_when_init_area(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
