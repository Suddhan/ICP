[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # -place_global_activity_power_driven_effort mode
[04/27 14:27:15     50s]   place_global_align_macro(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
