[04/27 14:27:15     50s]                         # the library as non-sequential timing checks
[04/27 14:27:15     50s]   timing_disable_library_tieoffs(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Disables constant functions in a library
[04/27 14:27:15     50s]   timing_disable_netlist_constants(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, ignores constants defined in the Verilog netlist
[04/27 14:27:15     50s]   timing_disable_nochange_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables no change timing model checks during timing analysis
[04/27 14:27:15     50s]   timing_disable_non_sequential_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables the timing arcs between any data-to-clock or
[04/27 14:27:15     50s]                         # clock-to-clock checks
[04/27 14:27:15     50s]   timing_disable_output_as_clock_port(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Controls clock to output port to be treated as data or clock irrespective of
[04/27 14:27:15     50s]                         # constraints set on the port
[04/27 14:27:15     50s]   timing_disable_parallel_arcs(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # to control enabling/disabling both CTE's  parallel arc reduction, and the
[04/27 14:27:15     50s]                         # related task compression on the AAE side. Setting this variable to 'true'
