[04/27 14:27:15     50s]                         # tree only when launching and capturing clocks are different.
[04/27 14:27:15     50s]   timing_cppr_threshold_ps(root)
[04/27 14:27:15     50s]                         # double, read/write, default=20.0, indices={}
