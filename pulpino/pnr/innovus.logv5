[04/27 14:27:15     50s]   place_detail_context_aware_legal(root)
[04/27 14:27:15     50s]                         # enum* {none all optional required user ignore_soft}, read/write, default=all,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # specify the types of cell context rules the placer needs to honor. The argument
[04/27 14:27:15     50s]                         # values [optional, required, user ignore_soft] can be used separately or
