[04/27 14:27:15     50s]   categories(root)      # string, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # available categories of root attributes
[04/27 14:27:15     50s]   ccopt_auto_limit_insertion_delay_factor(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.5, indices={}
[04/27 14:27:15     50s]                         # CCOpt attempts to keep the insertion delays of each clock tree a fixed
[04/27 14:27:15     50s]                         # multiple
[04/27 14:27:15     50s]                         # of the longest insertion delay that would result from a global skew
[04/27 14:27:15     50s]                         # approach.
[04/27 14:27:15     50s]                         # This multiple can be modified by design timing and the presence of other
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # trees, but will start at a fixed fraction above the global skew insertion
[04/27 14:27:15     50s]                         # delay.
[04/27 14:27:15     50s]                         # This attribute specifies that fixed fraction.
[04/27 14:27:15     50s]                         # Valid values: real
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . ccopt_auto_limit_insertion_delay_factor_skew_group
[04/27 14:27:15     50s]   ccopt_merge_clock_gates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If set to true, clock gate merging is enabled. If this is false, merging of
[04/27 14:27:15     50s]                         # all
[04/27 14:27:15     50s]                         # clock gates is disabled, including clock gates which may have been cloned
[04/27 14:27:15     50s]                         # by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # Note that this attribute has no impact on 'ccopt_design -cts'. See also
[04/27 14:27:15     50s]                         # attribute
[04/27 14:27:15     50s]                         # cts_merge_clock_gates.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   ccopt_merge_clock_logic(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If set to true, clock logic merging is enabled. If this is false, merging of
[04/27 14:27:15     50s]                         # all
[04/27 14:27:15     50s]                         # clock logics is disabled, including clock logics which may have been cloned
[04/27 14:27:15     50s]                         # by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # Note that this attribute has no impact on 'ccopt_design -cts'. See also
[04/27 14:27:15     50s]                         # attribute
[04/27 14:27:15     50s]                         # cts_merge_clock_logic.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   check_ac_limit_additional_individual_violation_report(root)
