[04/27 14:27:15     50s]   place_detail_m3_stripe_push_down(root)
[04/27 14:27:15     50s]                         # int, read/write, default=-1, indices={}
[04/27 14:27:15     50s]                         # Width threshold in site-units for 'virtual' push-down of M3 stripe to M2 for M1
[04/27 14:27:15     50s]                         # pin-access. Value of 0 means all M3 stripes will be pushed-down.
[04/27 14:27:15     50s]   place_detail_m3_stripe_shrink(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
