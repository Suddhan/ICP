[04/27 14:27:15     50s]   check_drc_check_routing_halo_corner(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Check routing halo in the corner
[04/27 14:27:15     50s]   check_drc_disable_rules(root)
[04/27 14:27:15     50s]                         # enum* {jog2jog_spacing eol_spacing cut_spacing min_cut enclosure color min_step
[04/27 14:27:15     50s]                         # protrusion min_area out_of_die off_manufacturing_grid off_routing_track},
[04/27 14:27:15     50s]                         # read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Disable the rule that from the provided rule list. the rule list as follow:
[04/27 14:27:15     50s]                         # (jog2jog_spacing | eol_spacing cut_spacing min_cut enclosure color min_step
[04/27 14:27:15     50s]                         # protrusion min_area out_of_die off_manufacturing_grid off_routing_track)
[04/27 14:27:15     50s]   check_drc_exclude_pg_net(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Excludes the checking of power and ground nets.
[04/27 14:27:15     50s]   check_drc_ignore_cell_blockage(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Ignore geometries of cell blockage.
[04/27 14:27:15     50s]   check_drc_ignore_non_rectangle_shapes(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # ignore non-rectangle shapes.
[04/27 14:27:15     50s]   check_drc_ignore_trial_route(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Ignore trial route when check drc.
[04/27 14:27:15     50s]   check_drc_inside_via_def(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Check the cut spacing from the same via
[04/27 14:27:15     50s]   check_drc_layer_range(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Checks between the range of metal layers including cut layers in between
[04/27 14:27:15     50s]   check_drc_limit(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1000, indices={}
[04/27 14:27:15     50s]                         # Specifies the maximum number of errors to report
[04/27 14:27:15     50s]   check_drc_max_wrong_way_halo(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the maximum wrong way halo
[04/27 14:27:15     50s]   check_drc_ndr_spacing(root)
[04/27 14:27:15     50s]                         # enum {true false auto}, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # Specifies what kind of non-default rule spacing to be checked
[04/27 14:27:15     50s]   check_drc_report(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the report file that contains the violations information
[04/27 14:27:15     50s]   check_drc_short_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Exclude all DRC check except short.
[04/27 14:27:15     50s]   check_drc_trim_length(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Consider max length in the trim shape layer.
[04/27 14:27:15     50s]   check_drc_uncolored(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # report color change violation when the dpt layer shape is free color.
[04/27 14:27:15     50s]   check_drc_use_min_spacing_on_block_obs(root)
[04/27 14:27:15     50s]                         # enum {true false auto}, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # Use min spacing to check for block OBS.
[04/27 14:27:15     50s]   clock_tree_source_groups(root)
[04/27 14:27:15     50s]                         # clock_tree_source_group*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # list of clock_tree_source_group
[04/27 14:27:15     50s]   clock_trees(root)     # clock_tree*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # list of clock_tree
[04/27 14:27:15     50s]   clocks(root)          # clock*, read-only, default={}, indices=view
[04/27 14:27:15     50s]                         # clocks
[04/27 14:27:15     50s]   cmd_file(root)        # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The cmd file name of the program. It has each command run in the current
[04/27 14:27:15     50s]                         # session. It can be changed during the session to direct cmd file output to a
[04/27 14:27:15     50s]                         # different file. Type 'man log_file' for more details.
[04/27 14:27:15     50s]   constraint_modes(root)
[04/27 14:27:15     50s]                         # constraint_mode*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the constraint modes in the design.
[04/27 14:27:15     50s]   cts_add_port_driver_max_distance_from_port(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # This attribute specifies the allowable distance, in um if no units suffix is
[04/27 14:27:15     50s]                         # specified, that a port driver is allowed to be placed from the port being
[04/27 14:27:15     50s]                         # buffered. If the driver cannot be added close enough to the port it will not be
[04/27 14:27:15     50s]                         # added at all. This attribute, if set, overrides any value set in the attribute
[04/27 14:27:15     50s]                         # cts_add_port_driver_max_distance_from_port_rows.
[04/27 14:27:15     50s]   cts_add_port_driver_max_distance_from_port_rows(root)
[04/27 14:27:15     50s]                         # int, read/write, default=50, indices={}
[04/27 14:27:15     50s]                         # This attribute specifies the allowable distance, in standard cell row heights,
[04/27 14:27:15     50s]                         # that a port driver is allowed to be placed from the port being buffered. If the
[04/27 14:27:15     50s]                         # driver cannot be added close enough to the port it will not be added at all.
[04/27 14:27:15     50s]                         # The attribute cts_add_port_driver_max_distance_from_port, if set, overrides
[04/27 14:27:15     50s]                         # this value.
[04/27 14:27:15     50s]   cts_adjacent_rows_legal(root)
[04/27 14:27:15     50s]                         # string, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Defines the clock halo in the y direction. If set to true the y direction clock
[04/27 14:27:15     50s]                         # halo is zero and other clock instances are allowed in adjacent rows.
[04/27 14:27:15     50s]                         # The following attributes can be used to assign y direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_y
[04/27 14:27:15     50s]                         # cts_adjacent_rows_legal
[04/27 14:27:15     50s]                         # cts_cell_halo_rows
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_adjacent_rows_legal and
[04/27 14:27:15     50s]                         # cts_cell_halo_rows have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a
[04/27 14:27:15     50s]                         # non-auto value then cts_adjacent_rows_legal defines the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The attribute cts_cell_halo_rows has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_rows defines the clock halo in the y direction.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]   . cts_cell_halo_y
[04/27 14:27:15     50s]   . cts_cell_halo_rows
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_allow_non_std_clock_gate_inputs(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If this attribute is set, CTS will allow the use of clock gates with
[04/27 14:27:15     50s]                         # non-standard pins. CCOpt considers the following pin types to be standard:
[04/27 14:27:15     50s]                         # clock pins, enable pins, test enable pins, retention pins and power gating
[04/27 14:27:15     50s]                         # pins. Before starting CTS CCOpt will emit a warning, indicating which pin(s) it
[04/27 14:27:15     50s]                         # considers non-standard.
[04/27 14:27:15     50s]   cts_balance_mode(root)
[04/27 14:27:15     50s]                         # string, read/write, default=full, indices={}
[04/27 14:27:15     50s]                         # Replace CCOpt mode setting cts_opt_type {full | cluster | trial}. If not full,
[04/27 14:27:15     50s]                         # causes CCOpt and CCOpt CTS to halt before final completion of the clock tree to
[04/27 14:27:15     50s]                         # facilitate clock tree inspection.
[04/27 14:27:15     50s]                         # The possible values for this attribute are as follows:
[04/27 14:27:15     50s]                         # - full       - default value, a full CTS is performed.
[04/27 14:27:15     50s]                         # - cluster    - a cluster-only CTS is performed. The clock tree has no balancing
[04/27 14:27:15     50s]                         # delay applied.
[04/27 14:27:15     50s]                         # - trial      - The clock has only virtual (numeric annotation) balancing delays
[04/27 14:27:15     50s]                         # applied.
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_blackbox_default_driver_base_pin(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Base pin that will be used for all timing and capacitance modeling for clock
[04/27 14:27:15     50s]                         # roots with a source pin at a blackbox output.
[04/27 14:27:15     50s]   cts_blackbox_default_load_base_pin(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Base pin that will be used for all timing and capacitance modeling for clock
[04/27 14:27:15     50s]                         # sinks at blackbox inputs. Any cts_capacitance_override attribute will be used
[04/27 14:27:15     50s]                         # in preference to this.
[04/27 14:27:15     50s]   cts_buffer_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the buffer cells for CTS. If none are specified CCOpt will choose
[04/27 14:27:15     50s]                         # buffers from the libraries.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different buffer cells may be specified for any combination of clock tree and
[04/27 14:27:15     50s]                         # power domain.
[04/27 14:27:15     50s]                         # To use different buffers for each net type set the cts_buffer_cells_top and
[04/27 14:27:15     50s]                         # cts_buffer_cells_leaf attributes .
[04/27 14:27:15     50s]                         # Some examples follow:
[04/27 14:27:15     50s]                         # To specify buffer cells for all clock trees and all power domains:
[04/27 14:27:15     50s]                         # set_db cts_buffer_cells {bufAX* bufBX*}
[04/27 14:27:15     50s]                         # To specify buffer cells for a particular clock tree and all power domains:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_buffer_cells {bufX20 bufX18}
[04/27 14:27:15     50s]                         # To specify buffer cells for a particular clock tree and power domain:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_buffer_cells -index {power_domain <pd>} {bufX12
[04/27 14:27:15     50s]                         # bufX8}
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_buffer_cells_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the buffer cells available for CTS to use on leaf nets. If none are
[04/27 14:27:15     50s]                         # specified CCOpt will use the same buffers as on trunk nets
[04/27 14:27:15     50s]                         # (as specified in the cts_buffer_cells attribute).
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different leaf buffer cells may be specified for any combination of clock tree
[04/27 14:27:15     50s]                         # and power domain. 
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_buffer_cells_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the buffers cells available for CTS to use on top nets. If none are
[04/27 14:27:15     50s]                         # specified CCOpt will use the same buffers as on trunk nets
[04/27 14:27:15     50s]                         # (as specified in the cts_buffer_cells attribute).
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different top buffer cells may be specified for any combination of clock tree
[04/27 14:27:15     50s]                         # and power domain. 
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_cell_density(root)
[04/27 14:27:15     50s]                         # string, read/write, default=0.75, indices={}
[04/27 14:27:15     50s]                         # Specifies the clock halo in the x direction.
[04/27 14:27:15     50s]                         # Any x direction clock halo defined by this attribute is proportional to the
[04/27 14:27:15     50s]                         # cell width.
[04/27 14:27:15     50s]                         # The constant of proportionality is defined by the attribute value. For
[04/27 14:27:15     50s]                         # example:
[04/27 14:27:15     50s]                         # . If cts_cell_density = 0.25 then the x direction clock halo equals 3 * cell
[04/27 14:27:15     50s]                         # width.
[04/27 14:27:15     50s]                         # . If cts_cell_density = 0.5 then the x direction clock halo equals cell width.
[04/27 14:27:15     50s]                         # . If cts_cell_density = 0.75 then the x direction clock halo equals cell width
[04/27 14:27:15     50s]                         # / 3.
[04/27 14:27:15     50s]                         # . If cts_cell_density = 1 then the x direction clock halo equals zero.
[04/27 14:27:15     50s]                         # This attribute can specify the x direction clock halo for all clock trees via:
[04/27 14:27:15     50s]                         # set_db cts_cell_density 0.8
[04/27 14:27:15     50s]                         # This attribute can specify the x direction clock halo per-clock tree via:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_cell_density 0.9
[04/27 14:27:15     50s]                         # The following attributes can be used to assign x direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_x
[04/27 14:27:15     50s]                         # cts_cell_density
[04/27 14:27:15     50s]                         # cts_cell_halo_sites
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the x
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites
[04/27 14:27:15     50s]                         # have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto
[04/27 14:27:15     50s]                         # value then cts_cell_density defines the clock halo in the x direction. The
[04/27 14:27:15     50s]                         # attribute cts_cell_halo_sites has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_sites defines the clock halo in the x direction.
[04/27 14:27:15     50s]                         # Valid values: 0.01 to 1
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]   . cts_cell_halo_x
[04/27 14:27:15     50s]   . cts_cell_halo_sites
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_cell_halo_mode(root)
[04/27 14:27:15     50s]                         # string, read/write, default=max, indices={}
[04/27 14:27:15     50s]                         # Specifies how clock halos are used to determine the minimum legal separation
[04/27 14:27:15     50s]                         # between a pair of clock instances. There are two possible modes 'max' and
[04/27 14:27:15     50s]                         # 'sum'. When set to 'max' the minimum legal separation is the larger of the two
[04/27 14:27:15     50s]                         # clock halos. When set to 'sum' the minimum legal separation is the sum of the
[04/27 14:27:15     50s]                         # two clock halos.
[04/27 14:27:15     50s]                         # Valid values: max sum 
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . cts_cell_halo_x
[04/27 14:27:15     50s]                         # . cts_cell_halo_y
[04/27 14:27:15     50s]                         # . cts_cell_density
[04/27 14:27:15     50s]                         # . cts_adjacent_rows_legal
[04/27 14:27:15     50s]                         # . cts_cell_halo_sites
[04/27 14:27:15     50s]                         # . cts_cell_halo_rows
[04/27 14:27:15     50s]                         # . cts_effective_clock_halo_x
[04/27 14:27:15     50s]                         # . cts_effective_clock_halo_y
[04/27 14:27:15     50s]                         # . cts_effective_clock_halo_x_source
[04/27 14:27:15     50s]                         # . cts_effective_clock_halo_y_source
[04/27 14:27:15     50s]   cts_cell_halo_rows(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1, indices={}
[04/27 14:27:15     50s]                         # Specifies the clock halo in the y direction in rows for all clock cells.
[04/27 14:27:15     50s]                         # The following attributes can be used to assign y direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_y
[04/27 14:27:15     50s]                         # cts_adjacent_rows_legal
[04/27 14:27:15     50s]                         # cts_cell_halo_rows
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_adjacent_rows_legal and
[04/27 14:27:15     50s]                         # cts_cell_halo_rows have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a
[04/27 14:27:15     50s]                         # non-auto value then cts_adjacent_rows_legal defines the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The attribute cts_cell_halo_rows has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_rows defines the clock halo in the y direction.
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . cts_cell_halo_y
[04/27 14:27:15     50s]                         # . cts_adjacent_rows_legal
[04/27 14:27:15     50s]   cts_cell_halo_sites(root)
[04/27 14:27:15     50s]                         # int, read/write, default=4, indices={}
[04/27 14:27:15     50s]                         # Specifies the clock halo in the x direction in sites for all clock cells. 
[04/27 14:27:15     50s]                         # The following attributes can be used to assign x direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_x
[04/27 14:27:15     50s]                         # cts_cell_density
[04/27 14:27:15     50s]                         # cts_cell_halo_sites
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the x
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites
[04/27 14:27:15     50s]                         # have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto
[04/27 14:27:15     50s]                         # value then cts_cell_density defines the clock halo in the x direction. The
[04/27 14:27:15     50s]                         # attribute cts_cell_halo_sites has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_sites defines the clock halo in the x direction.
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . cts_cell_halo_x
[04/27 14:27:15     50s]                         # . cts_cell_density
[04/27 14:27:15     50s]   cts_cell_halo_x(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the clock halo distance in the x direction. The default value of this
[04/27 14:27:15     50s]                         # attribute is auto.
[04/27 14:27:15     50s]                         # The following attributes can be used to assign x direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_x
[04/27 14:27:15     50s]                         # cts_cell_density
[04/27 14:27:15     50s]                         # cts_cell_halo_sites
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the x
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites
[04/27 14:27:15     50s]                         # have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto
[04/27 14:27:15     50s]                         # value then cts_cell_density defines the clock halo in the x direction. The
[04/27 14:27:15     50s]                         # attribute cts_cell_halo_sites has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_sites defines the clock halo in the x direction.
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . cts_cell_density
[04/27 14:27:15     50s]                         # . cts_cell_halo_sites
[04/27 14:27:15     50s]   cts_cell_halo_y(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the clock halo distance in the y direction. The default value of this
[04/27 14:27:15     50s]                         # attribute is auto.
[04/27 14:27:15     50s]                         # The following attributes can be used to assign y direction clock halos within
[04/27 14:27:15     50s]                         # CCOpt:
[04/27 14:27:15     50s]                         # cts_cell_halo_y
[04/27 14:27:15     50s]                         # cts_adjacent_rows_legal
[04/27 14:27:15     50s]                         # cts_cell_halo_rows
[04/27 14:27:15     50s]                         # Only one of these attributes is used to determine the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The following rules determine which:
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y
[04/27 14:27:15     50s]                         # direction clock halo. The attributes cts_adjacent_rows_legal and
[04/27 14:27:15     50s]                         # cts_cell_halo_rows have no effect.
[04/27 14:27:15     50s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a
[04/27 14:27:15     50s]                         # non-auto value then cts_adjacent_rows_legal defines the clock halo in the y
[04/27 14:27:15     50s]                         # direction. The attribute cts_cell_halo_rows has no effect.
[04/27 14:27:15     50s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then
[04/27 14:27:15     50s]                         # cts_cell_halo_rows defines the clock halo in the y direction.
[04/27 14:27:15     50s]                         # See also:
[04/27 14:27:15     50s]                         # . cts_adjacent_rows_legal
[04/27 14:27:15     50s]                         # . cts_cell_halo_rows
[04/27 14:27:15     50s]   cts_clock_gate_movement_limit(root)
[04/27 14:27:15     50s]                         # string, read/write, default=10, indices={}
[04/27 14:27:15     50s]                         # Each clock gate is restricted to a Manhattan ball centered on its original
[04/27 14:27:15     50s]                         # location with CTS flow.
[04/27 14:27:15     50s]                         # The radius of the ball is a multiple of the clock gate height. 
[04/27 14:27:15     50s]                         # This controls the default value of that multiple. 
[04/27 14:27:15     50s]   cts_clock_gating_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the clock gates for CTS. If none are specified CCOpt will choose
[04/27 14:27:15     50s]                         # clock gates from the libraries.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different clock gates may be specified for any combination of clock tree and
[04/27 14:27:15     50s]                         # power domain.
[04/27 14:27:15     50s]                         # Some examples follow:
[04/27 14:27:15     50s]                         # To specify clock gates for all clock trees and all power domains:
[04/27 14:27:15     50s]                         # set_db cts_clock_gating_cells {cgAX* cgBX*}
[04/27 14:27:15     50s]                         # To specify clock gates for a particular clock tree and all power domains:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_clock_gating_cells {cgX20 cgX18}
[04/27 14:27:15     50s]                         # To specify clock gates for a particular clock tree and power domain:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_clock_gating_cells -index {power_domain <pd>}
[04/27 14:27:15     50s]                         # {cgX12 cgX8}
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_clock_source_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the cells available for CTS to size clock sources if the
[04/27 14:27:15     50s]                         # cts_size_clock_sources attribute is set to true. If none are specified the tool
[04/27 14:27:15     50s]                         # will choose cells from the libraries.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, the tool will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different cells may be specified for clock trees or power domains. Only clock
[04/27 14:27:15     50s]                         # sources that are buffers, inverters, logic and clock gating cells with a single
[04/27 14:27:15     50s]                         # output can be resized.
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_clock_tree_source_group_clock_trees(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # A list of the clock trees relevant to this source group.
[04/27 14:27:15     50s]                         # Valid values: list cts_clock_trees
[04/27 14:27:15     50s]   cts_clock_tree_source_input_max_transition_time(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0, indices=delay_corner
[04/27 14:27:15     50s]                         # The slew which will be assumed at the input of the root driver.
[04/27 14:27:15     50s]                         # Valid values: double
[04/27 14:27:15     50s]   cts_cloning_inst_name_suffix(root)
[04/27 14:27:15     50s]                         # string, read/write, default=clone, indices={}
[04/27 14:27:15     50s]                         # If set, the suffix will be used generally for all insts cloned by CTS, else the
[04/27 14:27:15     50s]                         # suffix will default to "clone".
[04/27 14:27:15     50s]   cts_cloning_inst_name_suffix_source_group_assignment(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Controls the suffix used by multi-tap cloning. If set to a non-empty string,
[04/27 14:27:15     50s]                         # that string will be used when naming cloned instances created by multi-tap
[04/27 14:27:15     50s]                         # cloning. Otherwise, the suffix will be controlled by the attribute
[04/27 14:27:15     50s]                         # cts_cloning_inst_name_suffix.
[04/27 14:27:15     50s]   cts_delay_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the delay cells available for CTS. If none are specified CCOpt will
[04/27 14:27:15     50s]                         # not use delay cells.
[04/27 14:27:15     50s]                         # Setting this attribute to the string 'auto' means that CCOpt will choose delay
[04/27 14:27:15     50s]                         # cells from the libraries to use. 
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different delay cells may be specified for any combination of clock tree and
[04/27 14:27:15     50s]                         # power domain, or by omitting those
[04/27 14:27:15     50s]                         # arguments a global setting can be applied.
[04/27 14:27:15     50s]                         # Some examples follow:
[04/27 14:27:15     50s]                         # To specify delay cells for all clock trees and power domains:
[04/27 14:27:15     50s]                         # set_db cts_delay_cells {delayAX* delayBX*}
[04/27 14:27:15     50s]                         # To specify delay cells for a particular clock tree and all power domains:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_delay_cells {delayX1 delayX2}
[04/27 14:27:15     50s]                         # To specify delay cells for a particular clock tree and power domain:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_delay_cells  -index {power_domain <pd>} {delayX2
[04/27 14:27:15     50s]                         # delayX3}
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names, or the string 'auto'
[04/27 14:27:15     50s]   cts_detailed_cell_warnings(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to true, CCOpt outputs detailed cell warning diagnostics when
[04/27 14:27:15     50s]                         # it
[04/27 14:27:15     50s]                         # encounters issues with library cell selection, power domains and/or
[04/27 14:27:15     50s]                         # signal
[04/27 14:27:15     50s]                         # levels.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_exit_if_no_placeable_area(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies that CTS should exit if the design has zero placeable area.
[04/27 14:27:15     50s]                         # Setting this attribute may be useful to temporarily work-around problems with
[04/27 14:27:15     50s]                         # row
[04/27 14:27:15     50s]                         # definition and/or blockages causing placeable area to be zero.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_exit_if_skew_target_over_constrained(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies that CCOpt should exit as current skew targets are
[04/27 14:27:15     50s]                         # likely to lead to poor results. By default, CCOpt computes a minimum
[04/27 14:27:15     50s]                         # skew
[04/27 14:27:15     50s]                         # target which should not lead to excessive buffering, and does not allow
[04/27 14:27:15     50s]                         # any
[04/27 14:27:15     50s]                         # skew target to be set lower than this minimum. This attribute overrides
[04/27 14:27:15     50s]                         # that
[04/27 14:27:15     50s]                         # check, and allows any skew target to be used.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_exit_if_stage_delay_sigma_target_over_constrained(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If set, allows any max stage delay sigma target to be set. If the target is too
[04/27 14:27:15     50s]                         # low, it is likely to lead to runtime problems.
[04/27 14:27:15     50s]   cts_exit_if_transition_target_over_constrained(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies that CCOpt should exit, as with current slew targets it is
[04/27 14:27:15     50s]                         # likely to lead to runtime problems. By default, CCOpt computes a minimum
[04/27 14:27:15     50s]                         # slew
[04/27 14:27:15     50s]                         # target which should not lead to runtime problems, and does not allow any
[04/27 14:27:15     50s]                         # slew
[04/27 14:27:15     50s]                         # target to be set lower than this minimum. This attribute overrides that
[04/27 14:27:15     50s]                         # check,
[04/27 14:27:15     50s]                         # and allows any slew target to be used.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_fix_clock_sinks(root)
[04/27 14:27:15     50s]                         # string, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to true, we will DEF lock clock tree sinks after routing in addition to
[04/27 14:27:15     50s]                         # any clock node locking (fixed).
[04/27 14:27:15     50s]                         # If set to soft, we will DEF lock clock tree sinks after routing in addition to
[04/27 14:27:15     50s]                         # any clock node soft_locking (softFixed).
[04/27 14:27:15     50s]                         # Valid values: true false soft
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_flexible_htree_placement_legalization_effort(root)
[04/27 14:27:15     50s]                         # string, read/write, default=low, indices={}
[04/27 14:27:15     50s]                         # The legalization effort for finding placement unblocked points on the synthesis
[04/27 14:27:15     50s]                         # grid for flexible H-trees. High placement legalization effort can avoid having
[04/27 14:27:15     50s]                         # to relax placement constraints when implementing H-trees but may lead to
[04/27 14:27:15     50s]                         # increased runtime.
[04/27 14:27:15     50s]                         # Valid values: low, high (default low)
[04/27 14:27:15     50s]   cts_ignore_problematic_skew_as_result_of_dont_touch_nets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set, sinks directly connected to nets that are causing unfixable skew
[04/27 14:27:15     50s]                         # problems will be ignored for skew balancing.
[04/27 14:27:15     50s]   cts_inst_name_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default=CTS, indices={}
[04/27 14:27:15     50s]                         # The name prefix of instances created by CTS. The default value is 
[04/27 14:27:15     50s]                         # "CTS". The default names of instances are CTS_*.
[04/27 14:27:15     50s]                         # Valid values: string
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_inverter_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the inverter cells available for CTS. If none are specified CCOpt
[04/27 14:27:15     50s]                         # will choose inverters from the libraries.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different inverter cells may be specified for any combination of clock tree and
[04/27 14:27:15     50s]                         # power domain. 
[04/27 14:27:15     50s]                         # To use different inverters for each net type set the cts_inverter_cells_top and
[04/27 14:27:15     50s]                         # cts_inverter_cells_leaf attributes .
[04/27 14:27:15     50s]                         # Some examples follow:
[04/27 14:27:15     50s]                         # To specify inverter cells for all clock trees and all power domains:
[04/27 14:27:15     50s]                         # set_db cts_inverter_cells {invAX* invBX*}
[04/27 14:27:15     50s]                         # To specify inverter cells for a particular clock tree and all power domains:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_inverter_cells {invX20 invX18}
[04/27 14:27:15     50s]                         # To specify inverter cells for a particular clock tree and power domain:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_inverter_cells -index {power_domain <pd>} {invX12
[04/27 14:27:15     50s]                         # invX8}
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_inverter_cells_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the inverter cells available for CTS to use on leaf nets. If none are
[04/27 14:27:15     50s]                         # specified CCOpt will use the same inverters as on trunk nets
[04/27 14:27:15     50s]                         # (as specified in the cts_inverter_cells attribute).
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different leaf inverter cells may be specified for any combination of clock
[04/27 14:27:15     50s]                         # tree and power domain. 
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_inverter_cells_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the inverter cells available for CTS to use on top nets. If none are
[04/27 14:27:15     50s]                         # specified CCOpt will use the same inverters as on trunk nets
[04/27 14:27:15     50s]                         # (as specified in the cts_inverter_cells attribute).
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different top inverter cells may be specified for any combination of clock tree
[04/27 14:27:15     50s]                         # and power domain. 
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_load_capacitance_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the load capacitance cells available for CTS. CTS will use cells from
[04/27 14:27:15     50s]                         # this collection for load capacitance optimizations.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names.
[04/27 14:27:15     50s]   cts_logic_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices=power_domain
[04/27 14:27:15     50s]                         # Specifies the clock logics for CTS. If none are specified CCOpt will choose
[04/27 14:27:15     50s]                         # clock logics from the libraries.
[04/27 14:27:15     50s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of
[04/27 14:27:15     50s]                         # patterns to be expanded to match names. 
[04/27 14:27:15     50s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells
[04/27 14:27:15     50s]                         # specified. 
[04/27 14:27:15     50s]                         # Different logic cells may be specified for any combination of clock tree and
[04/27 14:27:15     50s]                         # power domain.
[04/27 14:27:15     50s]                         # Some examples follow:
[04/27 14:27:15     50s]                         # To specify logic cells for all clock trees and all power domains:
[04/27 14:27:15     50s]                         # set_db cts_logic_cells {and* mux*}
[04/27 14:27:15     50s]                         # To specify logic cells for a particular clock tree and all power domains:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_logic_cells {andX20 andX18}
[04/27 14:27:15     50s]                         # To specify logic cells for a particular clock tree and power domain:
[04/27 14:27:15     50s]                         # set_db clock_tree:<clk> .cts_logic_cells -index {power_domain <pd>} {andX12
[04/27 14:27:15     50s]                         # andX8}
[04/27 14:27:15     50s]                         # Valid values: a list of library cell names, or a list of patterns to expand to
[04/27 14:27:15     50s]                         # library cell names
[04/27 14:27:15     50s]   cts_manage_power_intent_violations(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If this attribute is set, the CTS algorithm will work around power
[04/27 14:27:15     50s]                         # management
[04/27 14:27:15     50s]                         # illegalities in the clock tree, as opposed to failing with an error when
[04/27 14:27:15     50s]                         # it
[04/27 14:27:15     50s]                         # encounters them. This allows the clock tree to be synthesized, but any
[04/27 14:27:15     50s]                         # power
[04/27 14:27:15     50s]                         # management illegalities will remain in the exported design.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_max_fanout(root)  # int, read/write, default=100, indices={}
[04/27 14:27:15     50s]                         # The maximum fanout at any point in the clock tree.
[04/27 14:27:15     50s]                         # Valid values: integer ranged between 2 and 1000 inclusive
[04/27 14:27:15     50s]   cts_max_source_to_sink_net_length(root)
[04/27 14:27:15     50s]                         # string, read/write, default=top auto trunk auto leaf auto, indices={}
[04/27 14:27:15     50s]                         # The maximum routing length in microns between driving source pin and
[04/27 14:27:15     50s]                         # driven
[04/27 14:27:15     50s]                         # sink pin on each net that clock tree synthesis should observe.
[04/27 14:27:15     50s]                         # This constraint can be applied to either a pin, a clock tree, or a net
[04/27 14:27:15     50s]                         # type.
[04/27 14:27:15     50s]                         # By default (if this attribute is not set) no explicit clock tree net
[04/27 14:27:15     50s]                         # length
[04/27 14:27:15     50s]                         # constraint is enforced. However, other clock tree constraints such as
[04/27 14:27:15     50s]                         # maximum
[04/27 14:27:15     50s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[04/27 14:27:15     50s]                         # net length.
[04/27 14:27:15     50s]                         # Valid values: double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_max_source_to_sink_net_length_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # The maximum routing length in microns between driving source pin and
[04/27 14:27:15     50s]                         # driven
[04/27 14:27:15     50s]                         # sink pin on each net that clock tree synthesis should observe.
[04/27 14:27:15     50s]                         # This constraint can be applied to either a pin, a clock tree, or a net
[04/27 14:27:15     50s]                         # type.
[04/27 14:27:15     50s]                         # By default (if this attribute is not set) no explicit clock tree net
[04/27 14:27:15     50s]                         # length
[04/27 14:27:15     50s]                         # constraint is enforced. However, other clock tree constraints such as
[04/27 14:27:15     50s]                         # maximum
[04/27 14:27:15     50s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[04/27 14:27:15     50s]                         # net length.
[04/27 14:27:15     50s]                         # Valid values: double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_max_source_to_sink_net_length_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # The maximum routing length in microns between driving source pin and
[04/27 14:27:15     50s]                         # driven
[04/27 14:27:15     50s]                         # sink pin on each net that clock tree synthesis should observe.
[04/27 14:27:15     50s]                         # This constraint can be applied to either a pin, a clock tree, or a net
[04/27 14:27:15     50s]                         # type.
[04/27 14:27:15     50s]                         # By default (if this attribute is not set) no explicit clock tree net
[04/27 14:27:15     50s]                         # length
[04/27 14:27:15     50s]                         # constraint is enforced. However, other clock tree constraints such as
[04/27 14:27:15     50s]                         # maximum
[04/27 14:27:15     50s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[04/27 14:27:15     50s]                         # net length.
[04/27 14:27:15     50s]                         # Valid values: double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_max_source_to_sink_net_length_trunk(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # The maximum routing length in microns between driving source pin and
[04/27 14:27:15     50s]                         # driven
[04/27 14:27:15     50s]                         # sink pin on each net that clock tree synthesis should observe.
[04/27 14:27:15     50s]                         # This constraint can be applied to either a pin, a clock tree, or a net
[04/27 14:27:15     50s]                         # type.
[04/27 14:27:15     50s]                         # By default (if this attribute is not set) no explicit clock tree net
[04/27 14:27:15     50s]                         # length
[04/27 14:27:15     50s]                         # constraint is enforced. However, other clock tree constraints such as
[04/27 14:27:15     50s]                         # maximum
[04/27 14:27:15     50s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[04/27 14:27:15     50s]                         # net length.
[04/27 14:27:15     50s]                         # Valid values: double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_merge_clock_gates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to true, clock gate merging is enabled. If this is false, merging of
[04/27 14:27:15     50s]                         # all
[04/27 14:27:15     50s]                         # clock gates is disabled, including clock gates which may have been cloned
[04/27 14:27:15     50s]                         # by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # Note that this attribute only impacts 'ccopt_design -cts'. See also
[04/27 14:27:15     50s]                         # attribute
[04/27 14:27:15     50s]                         # ccopt_merge_clock_gates.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_merge_clock_logic(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to true, clock logic merging is enabled. If this is false, merging of
[04/27 14:27:15     50s]                         # all
[04/27 14:27:15     50s]                         # clock logics is disabled, including clock logics which may have been cloned
[04/27 14:27:15     50s]                         # by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # Note that this attribute only impacts 'ccopt_design -cts'. See also
[04/27 14:27:15     50s]                         # attribute
[04/27 14:27:15     50s]                         # ccopt_merge_clock_logic.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_mixed_fanout_net_type(root)
[04/27 14:27:15     50s]                         # string, read/write, default=leaf, indices={}
[04/27 14:27:15     50s]                         # Controls how CCOpt considers nets that have fanout consisting partially but not
[04/27 14:27:15     50s]                         # entirely of sinks. By default, having any sinks (eg. DFFs) will make the net be
[04/27 14:27:15     50s]                         # considered leaf, but when set to trunk, a net has to drive only sinks to be
[04/27 14:27:15     50s]                         # considered leaf. For example, a net driving a clock gate and a DFF would no
[04/27 14:27:15     50s]                         # longer count as a leaf net.
[04/27 14:27:15     50s]                         # Valid values: leaf trunk
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_move_clock_gates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If this attribute is set, the CTS algorithm will move clock gates that appear
[04/27 14:27:15     50s]                         # in the clock tree. Setting this attribute may cause the clock tree to have a
[04/27 14:27:15     50s]                         # lower insertion delay, but might break datapath timing. During optimization,
[04/27 14:27:15     50s]                         # this is not a problem, because the timing will be automatically recovered
[04/27 14:27:15     50s]                         # during the optimization process. If this attribute is false, CTS permits small
[04/27 14:27:15     50s]                         # movements of ICGs for legalization.
[04/27 14:27:15     50s]   cts_move_logic(root)  # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If this attribute is set, the CTS algorithm will move logic that appears in
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # clock tree. "Logic" does not include clock gates, buffers, and inverters in
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # clock tree, which are always moved unless they are locked, or clock
[04/27 14:27:15     50s]                         # generators
[04/27 14:27:15     50s]                         # that are above the root of the clock tree. Usually, this will
[04/27 14:27:15     50s]                         # affect
[04/27 14:27:15     50s]                         # multiplexers used for selecting one of a number of clocks, or for
[04/27 14:27:15     50s]                         # switching
[04/27 14:27:15     50s]                         # between a test clock and the main clock. Setting this attribute may cause
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # clock tree to have a lower insertion delay, but might break datapath
[04/27 14:27:15     50s]                         # timing.
[04/27 14:27:15     50s]                         # During optimization, this is not a problem, because the timing will
[04/27 14:27:15     50s]                         # be
[04/27 14:27:15     50s]                         # automatically recovered during the optimization process.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_net_name_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default=CTS, indices={}
[04/27 14:27:15     50s]                         # The name prefix of nets created by CTS. The default value is 
[04/27 14:27:15     50s]                         # "CTS". The default names of nets are CTS, CTS_1, CTS_2... ...
[04/27 14:27:15     50s]                         # Valid values: string
[04/27 14:27:15     50s]   cts_override_vias(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # When specified, this attribute defines the vias to be used in RC
[04/27 14:27:15     50s]                         # extraction
[04/27 14:27:15     50s]                         # from routing estimates. The listed vias will be used in place of those
[04/27 14:27:15     50s]                         # configured
[04/27 14:27:15     50s]                         # on the routing rules for the clock network.
[04/27 14:27:15     50s]                         # The order of the list is irrelevant.
[04/27 14:27:15     50s]                         # The vias may also be overridden for each non-default rule (NDR). In this
[04/27 14:27:15     50s]                         # case, the name of the NDR is given as the first element in the list with
[04/27 14:27:15     50s]                         # subsequent
[04/27 14:27:15     50s]                         # entries being the via names. Multiple NDRs can be specified, e.g.
[04/27 14:27:15     50s]                         # {via1d {NDR1 via2d} {NDR2 via2d}} will override via1d in the default rule,
[04/27 14:27:15     50s]                         # and
[04/27 14:27:15     50s]                         # both via1d and via2d in NDR1 and NDR2.
[04/27 14:27:15     50s]                         # Valid values: list via_call
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_post_route_enable(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enable post-conditioning optimization after clock nets are routed.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_post_route_enable_routing_eco(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to false, post-conditioning will skip its ECO-routing step.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_post_route_repair_drv(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If set to false, post-conditioning will skip its DRV-fixing step.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_post_route_repair_skew_by_buffering(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set to true, post-conditioning will attempt skew-fixing using
[04/27 14:27:15     50s]                         # rebuffering.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_primary_delay_corner(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # This specifies the delay corner in which clock tree balancing applies the
[04/27 14:27:15     50s]                         # slew and insertion delay targets. If more than one timing corner is
[04/27 14:27:15     50s]                         # defined,
[04/27 14:27:15     50s]                         # this must be set before running CCOpt. By default, this is set to the delay
[04/27 14:27:15     50s]                         # corner
[04/27 14:27:15     50s]                         # contained in the first member of the list of setup views provided to
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # set_analysis_view command.
[04/27 14:27:15     50s]                         # Valid values:  corner name, or empty
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_primary_reporting_skew_groups(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # The primary skew groups used for reporting. 
[04/27 14:27:15     50s]                         # By default, the value is specified as auto that automatically takes the skew
[04/27 14:27:15     50s]                         # group with maximum number of sinks 
[04/27 14:27:15     50s]                         # as the primary reporting skew group. For invalid values, the default (auto)
[04/27 14:27:15     50s]                         # will be considered.
[04/27 14:27:15     50s]                         # Valid values: a list of existing skew group names, auto or none
[04/27 14:27:15     50s]   cts_primary_reporting_skew_groups_log_min_max_sinks(root)
[04/27 14:27:15     50s]                         # string, read/write, default=logv, indices={}
[04/27 14:27:15     50s]                         # If set to on, the sinks with the shortest and longest paths in each primary
[04/27 14:27:15     50s]                         # reporting skew group will be logged. If set to logv, they will be logged only
[04/27 14:27:15     50s]                         # to the logv file.
[04/27 14:27:15     50s]                         # Valid values: on, off, logv
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_repair_drv_by_buffering(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If set, the standalone clock_post_route_repair command called after
[04/27 14:27:15     50s]                         # route_design and the clock_post_route_repair called inside opt_design
[04/27 14:27:15     50s]                         # -post_route will fix clock DRVs by adding buffers, otherwise the tool will not
[04/27 14:27:15     50s]                         # add buffers to fix DRVs.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_report_skew_groups_only_with_targets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # The skew groups report (run using the report_skew_groups command) displays
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # insertion delay, skew, and min/max path information for different combinations
[04/27 14:27:15     50s]                         # of skew group,
[04/27 14:27:15     50s]                         # timing corner, and early/late path.
[04/27 14:27:15     50s]                         # Set the cts_report_skew_groups_only_with_targets attribute to false (the
[04/27 14:27:15     50s]                         # default) to report on all skew group/timing corner/path 
[04/27 14:27:15     50s]                         # combinations regardless of whether a skew target has been set.
[04/27 14:27:15     50s]                         # Set the cts_report_skew_groups_only_with_targets attribute to true to report
[04/27 14:27:15     50s]                         # only on skew group/timing corner/path
[04/27 14:27:15     50s]                         # combinations where a skew target has been set (either explicitly or using the
[04/27 14:27:15     50s]                         # 'auto' setting).
[04/27 14:27:15     50s]   cts_route_clock_tree_nets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Perform detailed routing, during the final implementation clock routing
[04/27 14:27:15     50s]                         # phase.
[04/27 14:27:15     50s]                         # Valid values: true or false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_route_type_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices={}
[04/27 14:27:15     50s]                         # Specifies the route type. Setting this attribute binds an existing user-defined
[04/27 14:27:15     50s]                         # route_type to one or more types of clock tree nets. Binding a route_type to a
[04/27 14:27:15     50s]                         # type of clock tree nets means that all nets of that type (including the nets
[04/27 14:27:15     50s]                         # created by CTS) will be routed according to the specification of that
[04/27 14:27:15     50s]                         # route_type.
[04/27 14:27:15     50s]                         # In the most common usage, the route_type is bound to one of the three types of
[04/27 14:27:15     50s]                         # clock tree nets (top, trunk, or leaf) with the optional -net_type argument.
[04/27 14:27:15     50s]                         # Omitting the -net_type argument causes the route_type to be bound to all three
[04/27 14:27:15     50s]                         # types of clock tree nets. The optional -clock_tree <pattern> argument limits
[04/27 14:27:15     50s]                         # the binding to the clock trees whose name matches <pattern>. Omitting the
[04/27 14:27:15     50s]                         # -clock_tree argument causes the binding to apply to all clock trees.
[04/27 14:27:15     50s]                         # For a route_type to be used in CTS, it must be bound to at least one net type.
[04/27 14:27:15     50s]                         # If net type is not bound to any route_type, a default route_type will be
[04/27 14:27:15     50s]                         # created for that net type at the start of CTS.
[04/27 14:27:15     50s]                         # Valid values: names of route_types created with create_route_type
[04/27 14:27:15     50s]   cts_route_type_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices={}
[04/27 14:27:15     50s]                         # Specifies the route type. Setting this attribute binds an existing user-defined
[04/27 14:27:15     50s]                         # route_type to one or more types of clock tree nets. Binding a route_type to a
[04/27 14:27:15     50s]                         # type of clock tree nets means that all nets of that type (including the nets
[04/27 14:27:15     50s]                         # created by CTS) will be routed according to the specification of that
[04/27 14:27:15     50s]                         # route_type.
[04/27 14:27:15     50s]                         # In the most common usage, the route_type is bound to one of the three types of
[04/27 14:27:15     50s]                         # clock tree nets (top, trunk, or leaf) with the optional -net_type argument.
[04/27 14:27:15     50s]                         # Omitting the -net_type argument causes the route_type to be bound to all three
[04/27 14:27:15     50s]                         # types of clock tree nets. The optional -clock_tree <pattern> argument limits
[04/27 14:27:15     50s]                         # the binding to the clock trees whose name matches <pattern>. Omitting the
[04/27 14:27:15     50s]                         # -clock_tree argument causes the binding to apply to all clock trees.
[04/27 14:27:15     50s]                         # For a route_type to be used in CTS, it must be bound to at least one net type.
[04/27 14:27:15     50s]                         # If net type is not bound to any route_type, a default route_type will be
[04/27 14:27:15     50s]                         # created for that net type at the start of CTS.
[04/27 14:27:15     50s]                         # Valid values: names of route_types created with create_route_type
[04/27 14:27:15     50s]   cts_route_type_trunk(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices={}
[04/27 14:27:15     50s]                         # Specifies the route type. Setting this attribute binds an existing user-defined
[04/27 14:27:15     50s]                         # route_type to one or more types of clock tree nets. Binding a route_type to a
[04/27 14:27:15     50s]                         # type of clock tree nets means that all nets of that type (including the nets
[04/27 14:27:15     50s]                         # created by CTS) will be routed according to the specification of that
[04/27 14:27:15     50s]                         # route_type.
[04/27 14:27:15     50s]                         # In the most common usage, the route_type is bound to one of the three types of
[04/27 14:27:15     50s]                         # clock tree nets (top, trunk, or leaf) with the optional -net_type argument.
[04/27 14:27:15     50s]                         # Omitting the -net_type argument causes the route_type to be bound to all three
[04/27 14:27:15     50s]                         # types of clock tree nets. The optional -clock_tree <pattern> argument limits
[04/27 14:27:15     50s]                         # the binding to the clock trees whose name matches <pattern>. Omitting the
[04/27 14:27:15     50s]                         # -clock_tree argument causes the binding to apply to all clock trees.
[04/27 14:27:15     50s]                         # For a route_type to be used in CTS, it must be bound to at least one net type.
[04/27 14:27:15     50s]                         # If net type is not bound to any route_type, a default route_type will be
[04/27 14:27:15     50s]                         # created for that net type at the start of CTS.
[04/27 14:27:15     50s]                         # Valid values: names of route_types created with create_route_type
[04/27 14:27:15     50s]   cts_routing_preferred_layer_effort(root)
[04/27 14:27:15     50s]                         # string, read/write, default=standard, indices={}
[04/27 14:27:15     50s]                         # Control preferred layer effort for clock routing.
[04/27 14:27:15     50s]   cts_size_clock_gates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # When set to true (the default), the CTS algorithm sizes clock gates that appear
[04/27 14:27:15     50s]                         # in the clock tree. Setting this attribute may cause the clock tree to have a
[04/27 14:27:15     50s]                         # lower insertion delay, but might change the cell types of logic gates in the
[04/27 14:27:15     50s]                         # clock tree, which in turn may require them to be moved slightly to find a legal
[04/27 14:27:15     50s]                         # location for the new cell.
[04/27 14:27:15     50s]   cts_size_clock_sources(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, CTS will try to size the clock source. Only clock sources
[04/27 14:27:15     50s]                         # that are buffers, inverters, logic and clock gating cells with a single output
[04/27 14:27:15     50s]                         # will be sized. The cells available for CTS to size clock sources can be set
[04/27 14:27:15     50s]                         # specified using the attribute 'cts_clock_source_cells'.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_size_logic(root)  # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # When set to true (the default), the CTS algorithm sizes logic that appears
[04/27 14:27:15     50s]                         # in
[04/27 14:27:15     50s]                         # the clock tree. "Logic" does not include clock gates, buffers, and inverters
[04/27 14:27:15     50s]                         # in a clock tree, which are always sized unless they are locked, or
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # generators that are above the root of the clock tree. Usually, this
[04/27 14:27:15     50s]                         # affects
[04/27 14:27:15     50s]                         # multiplexers used for selecting one of a number of clocks, or for
[04/27 14:27:15     50s]                         # switching
[04/27 14:27:15     50s]                         # between a test clock and the main clock. Setting this attribute may cause
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # clock tree to have a lower insertion delay, but might change the cell types
[04/27 14:27:15     50s]                         # of
[04/27 14:27:15     50s]                         # logic gates in the clock tree, which in turn may require them to be
[04/27 14:27:15     50s]                         # moved
[04/27 14:27:15     50s]                         # slightly to find a legal location for the new cell.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_skew_group_report_columns(root)
[04/27 14:27:15     50s]                         # string, read/write, default=name lib_cell event increment time slew capacitance
[04/27 14:27:15     50s]                         # location distance fanout status, indices={}
[04/27 14:27:15     50s]                         # A Tcl list of columns to include in skew group reports produced by the
[04/27 14:27:15     50s]                         # skew group report. You can use this attribute to specify the columns you
[04/27 14:27:15     50s]                         # would like to include in the skew group report, and the order in which
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # columns should appear.
[04/27 14:27:15     50s]                         # Most of the legal values are straightforward. However, the set of legal
[04/27 14:27:15     50s]                         # values
[04/27 14:27:15     50s]                         # of the following form deserve further
[04/27 14:27:15     50s]                         # explanation:
[04/27 14:27:15     50s]                         # summaryType_summaryLocation[_event]
[04/27 14:27:15     50s]                         # These values let you report the delay value for other paths that go through
[04/27 14:27:15     50s]                         # the pin.
[04/27 14:27:15     50s]                         # summaryType is one of: max (show the longest delay), min (show the
[04/27 14:27:15     50s]                         # shortest
[04/27 14:27:15     50s]                         # delay), or skew (show the skew, that is the difference between the longest
[04/27 14:27:15     50s]                         # and
[04/27 14:27:15     50s]                         # the shortest delay).
[04/27 14:27:15     50s]                         # summaryLocation is one of: above (show the delay/skew above this pin),
[04/27 14:27:15     50s]                         # below
[04/27 14:27:15     50s]                         # (show the delay/skew below this pin), or through (show the delay/skew for
[04/27 14:27:15     50s]                         # paths through this pin).
[04/27 14:27:15     50s]                         # event is one of: rise (show the delay/skew for the rise event at this
[04/27 14:27:15     50s]                         # pin),
[04/27 14:27:15     50s]                         # fall (show the delay/skew for the fall event at this pin), or both (show
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # delay/skew for both events at this pin).
[04/27 14:27:15     50s]                         # Valid values:
[04/27 14:27:15     50s]                         # capacitance
[04/27 14:27:15     50s]                         # distance
[04/27 14:27:15     50s]                         # event
[04/27 14:27:15     50s]                         # fanout
[04/27 14:27:15     50s]                         # increment
[04/27 14:27:15     50s]                         # length
[04/27 14:27:15     50s]                         # lib_cell
[04/27 14:27:15     50s]                         # load_capacitance
[04/27 14:27:15     50s]                         # location
[04/27 14:27:15     50s]                         # max_above
[04/27 14:27:15     50s]                         # max_above_fall
[04/27 14:27:15     50s]                         # max_above_rise
[04/27 14:27:15     50s]                         # max_below
[04/27 14:27:15     50s]                         # max_below_fall
[04/27 14:27:15     50s]                         # max_below_rise
[04/27 14:27:15     50s]                         # max_through
[04/27 14:27:15     50s]                         # max_through_fall
[04/27 14:27:15     50s]                         # max_through_rise
[04/27 14:27:15     50s]                         # min_above
[04/27 14:27:15     50s]                         # min_above_fall
[04/27 14:27:15     50s]                         # min_above_rise
[04/27 14:27:15     50s]                         # min_below
[04/27 14:27:15     50s]                         # min_below_fall
[04/27 14:27:15     50s]                         # min_below_rise
[04/27 14:27:15     50s]                         # min_through
[04/27 14:27:15     50s]                         # min_through_fall
[04/27 14:27:15     50s]                         # min_through_rise
[04/27 14:27:15     50s]                         # name
[04/27 14:27:15     50s]                         # net
[04/27 14:27:15     50s]                         # pin
[04/27 14:27:15     50s]                         # resistance
[04/27 14:27:15     50s]                         # skew_above
[04/27 14:27:15     50s]                         # skew_above_fall
[04/27 14:27:15     50s]                         # skew_above_rise
[04/27 14:27:15     50s]                         # skew_below
[04/27 14:27:15     50s]                         # skew_below_fall
[04/27 14:27:15     50s]                         # skew_below_rise
[04/27 14:27:15     50s]                         # skew_through
[04/27 14:27:15     50s]                         # skew_through_fall
[04/27 14:27:15     50s]                         # skew_through_rise
[04/27 14:27:15     50s]                         # slew
[04/27 14:27:15     50s]                         # status
[04/27 14:27:15     50s]                         # time
[04/27 14:27:15     50s]                         # wire_capacitance
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_skew_group_report_histogram_bin_size(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # When set to a numeric value, that numeric value will be used as the
[04/27 14:27:15     50s]                         # histogram
[04/27 14:27:15     50s]                         # range size (in library units). For example, if the library time units are
[04/27 14:27:15     50s]                         # set
[04/27 14:27:15     50s]                         # to 1 nanosecond, a value of 0.010 for
[04/27 14:27:15     50s]                         # report_skew_groups_histogram_bin_size
[04/27 14:27:15     50s]                         # will result in histogram ranges of 10 picoseconds.
[04/27 14:27:15     50s]                         # When set to auto, the size of the histogram ranges are dependent on the
[04/27 14:27:15     50s]                         # skew
[04/27 14:27:15     50s]                         # targets that are set. If a skew target is set for a given half corner and
[04/27 14:27:15     50s]                         # skew
[04/27 14:27:15     50s]                         # group combination, then the histogram range size will be 10% of the skew
[04/27 14:27:15     50s]                         # target for that half corner and skew target combination. If no skew target
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # set for a half corner and skew group combination but a skew target is set
[04/27 14:27:15     50s]                         # for
[04/27 14:27:15     50s]                         # the primary half corner and skew group combination, then the histogram
[04/27 14:27:15     50s]                         # range
[04/27 14:27:15     50s]                         # size will be 10% of the skew target for the primary half corner and skew
[04/27 14:27:15     50s]                         # group
[04/27 14:27:15     50s]                         # combination.
[04/27 14:27:15     50s]                         # In the event that no skew targets are set
[04/27 14:27:15     50s]                         # and
[04/27 14:27:15     50s]                         # report_skew_groups_histogram_bin_size is set to auto, a default value of
[04/27 14:27:15     50s]                         # 10
[04/27 14:27:15     50s]                         # picoseconds will be used for the histogram range size.
[04/27 14:27:15     50s]                         # Valid values: auto | string
[04/27 14:27:15     50s]   cts_spec_config_base_pin_trace_through_to(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Clock tree definition will, by default, not continue through certain types
[04/27 14:27:15     50s]                         # of
[04/27 14:27:15     50s]                         # cell arc (for instance, the clock to Q arc in a DFF). This attribute allows
[04/27 14:27:15     50s]                         # you to override this default behavior, permitting the clock tree to trace
[04/27 14:27:15     50s]                         # through
[04/27 14:27:15     50s]                         # all instances of such a cell.
[04/27 14:27:15     50s]                         # This attribute serves the same function as trace_through_to,
[04/27 14:27:15     50s]                         # except that here the clock path is specified at the level of the library
[04/27 14:27:15     50s]                         # cell. 
[04/27 14:27:15     50s]                         # The attribute should be configured on the input library pin at
[04/27 14:27:15     50s]                         # which the clock will arrive. The value of the attribute specifies
[04/27 14:27:15     50s]                         # the output library pin to which the clock should propagate. The
[04/27 14:27:15     50s]                         # specified
[04/27 14:27:15     50s]                         # output pin must be another pin on the same library cell. The output pin may
[04/27 14:27:15     50s]                         # be
[04/27 14:27:15     50s]                         # specified either by its fully qualified name (i.e. inclusive of the cell
[04/27 14:27:15     50s]                         # name),
[04/27 14:27:15     50s]                         # or else simply by its local (cell-relative) name.
[04/27 14:27:15     50s]                         # There must be a pre-existing (library-defined) chain of one or more delay
[04/27 14:27:15     50s]                         # arcs
[04/27 14:27:15     50s]                         # that connect the input and output pins together. It is not possible to
[04/27 14:27:15     50s]                         # use
[04/27 14:27:15     50s]                         # library_trace_through_to to synthesize delay arcs.
[04/27 14:27:15     50s]                         # If multiple input pins are annotated on a given library cell, the value
[04/27 14:27:15     50s]                         # of
[04/27 14:27:15     50s]                         # library_trace_through_to at each of those pins must select the same output
[04/27 14:27:15     50s]                         # pin:
[04/27 14:27:15     50s]                         # i.e. the configuration must identify a single clock output for the cell.
[04/27 14:27:15     50s]                         # If
[04/27 14:27:15     50s]                         # multiple clock outputs are necessary then library_trace_through_to should
[04/27 14:27:15     50s]                         # not
[04/27 14:27:15     50s]                         # be used: instead for each instance of the library cell, define a
[04/27 14:27:15     50s]                         # generated
[04/27 14:27:15     50s]                         # clock tree at each of the clock-carrying outputs.
[04/27 14:27:15     50s]                         # If the configuration of library_trace_through_to settings for a given
[04/27 14:27:15     50s]                         # library
[04/27 14:27:15     50s]                         # cell does not meet these requirements, a warning will be issued and
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # settings for that cell will be ignored.
[04/27 14:27:15     50s]                         # All instances of the library cell will be affected by this setting. If
[04/27 14:27:15     50s]                         # both
[04/27 14:27:15     50s]                         # trace_through_to and library_trace_through_to are applicable at a
[04/27 14:27:15     50s]                         # given
[04/27 14:27:15     50s]                         # instance pin, the trace_through_to value will take precedence.
[04/27 14:27:15     50s]                         # Valid values: base_pin
[04/27 14:27:15     50s]   cts_spec_config_create_clock_tree_source_groups(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Causes create_clock_tree_spec to set up a clock tree source group for SDC
[04/27 14:27:15     50s]                         # clocks with
[04/27 14:27:15     50s]                         # multiple source pins. If this attribute is set to true, create_clock_tree_spec
[04/27 14:27:15     50s]                         # defines one clock tree for each
[04/27 14:27:15     50s]                         # source pin and then uses the create_clock_tree_source_group command to collect
[04/27 14:27:15     50s]                         # those clock trees together, so that
[04/27 14:27:15     50s]                         # CTS can distribute sinks between the clock trees.
[04/27 14:27:15     50s]   cts_spec_config_create_generator_skew_groups(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # This attribute will cause the create_clock_tree_spec command to create skew
[04/27 14:27:15     50s]                         # groups for sequential generators and their adjacent registers. Such skew groups
[04/27 14:27:15     50s]                         # will be specified with the same highest rank so that they can be balanced from
[04/27 14:27:15     50s]                         # the other normal skew groups that share some sinks of them. The adjacent
[04/27 14:27:15     50s]                         # registers of a generator are registers that have a datapath timing path to talk
[04/27 14:27:15     50s]                         # with the generator directly. When this attribute is set to true, one skew group
[04/27 14:27:15     50s]                         # will be created per sequential generator instance, master clock and generated
[04/27 14:27:15     50s]                         # clock tree triple. The resulting skew groups will by default be named in the
[04/27 14:27:15     50s]                         # pattern:
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # _clock_gen_<master_clock_name>_<generator_local_name><_optional_number>/<constraint_mode_name>.
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # For example, for a pair of generators, with the same local name "reg_clkgen",
[04/27 14:27:15     50s]                         # CCOpt creates generated clock trees from the same master clock named "fclk" in
[04/27 14:27:15     50s]                         # a constraint mode named "func" the skew groups emitted into the clock tree
[04/27 14:27:15     50s]                         # specification file would be named:
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # _clock_gen_fclk_reg_clkgen_1/func
[04/27 14:27:15     50s]                         # _clock_gen_fclk_reg_clkgen_2/func
[04/27 14:27:15     50s]                         # The prefix for the names of such skew groups is controlled by the
[04/27 14:27:15     50s]                         # cts_spec_config_create_generator_skew_groups_name_prefix CCOpt attribute and
[04/27 14:27:15     50s]                         # defaults to "_clock_gen" (the start underscore is used to group such skew
[04/27 14:27:15     50s]                         # groups at the end of any skew group listing ordered by name).
[04/27 14:27:15     50s]   cts_spec_config_create_generator_skew_groups_name_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default=_clock_gen, indices={}
[04/27 14:27:15     50s]                         # This attribute controls the skew group name prefix used for skew groups
[04/27 14:27:15     50s]                         # generated to balance generator flops with their adjacent flops. Default is
[04/27 14:27:15     50s]                         # "_clock_gen". The default has a start underscore at the beginning to cause
[04/27 14:27:15     50s]                         # listings of skew groups ordered by name to collect such skew groups together at
[04/27 14:27:15     50s]                         # the end of a list.
[04/27 14:27:15     50s]   cts_spec_config_create_reporting_only_skew_groups(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Controls whether spec creation will synthesize reporting-only skew groups.
[04/27 14:27:15     50s]                         # A reporting-only skew group is a skew group whose cts_skew_group_constrains
[04/27 14:27:15     50s]                         # attribute is set to 'none'. Such a skew
[04/27 14:27:15     50s]                         # group imposes no clock balancing constraint and will not be considered by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # The typical example is a generated clock that is synchronous to its
[04/27 14:27:15     50s]                         # master
[04/27 14:27:15     50s]                         # clock. The relationship between the two clocks implies that the sinks of
[04/27 14:27:15     50s]                         # both
[04/27 14:27:15     50s]                         # clocks should be balanced together. To model this, a clock spec created
[04/27 14:27:15     50s]                         # for
[04/27 14:27:15     50s]                         # such a design will have the skew group corresponding to the master clock
[04/27 14:27:15     50s]                         # span
[04/27 14:27:15     50s]                         # the domain of both the master clock and also the generated clock. The
[04/27 14:27:15     50s]                         # skew
[04/27 14:27:15     50s]                         # group of the generated clock is then a subset of the master clock skew
[04/27 14:27:15     50s]                         # group:
[04/27 14:27:15     50s]                         # as such it is a redundant constraint, and may be safely omitted. If
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # synthesized, such a skew group will be created as a reporting-only skew
[04/27 14:27:15     50s]                         # group.
[04/27 14:27:15     50s]                         # When this attribute is set to false, reporting-only skew groups
[04/27 14:27:15     50s]                         # are completely omitted from the generated spec. When set to
[04/27 14:27:15     50s]                         # true,
[04/27 14:27:15     50s]                         # reporting-only skew groups are included in the generated spec, but are
[04/27 14:27:15     50s]                         # marked
[04/27 14:27:15     50s]                         # with the cts_skew_group_constrains attribute set to
[04/27 14:27:15     50s]                         # 'none'. Either way, they impose no balancing constraint.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_target_max_capacitance(root)
[04/27 14:27:15     50s]                         # string, read/write, default=top auto trunk auto leaf auto,
[04/27 14:27:15     50s]                         # indices=delay_corner
[04/27 14:27:15     50s]                         # The target maximum capacitive load to allow during clock tree synthesis.
[04/27 14:27:15     50s]                         # This
[04/27 14:27:15     50s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # tree synthesis algorithm will allow any given base_pin to drive in a
[04/27 14:27:15     50s]                         # given
[04/27 14:27:15     50s]                         # clock tree when driving a given net_type. It is specified in library units.
[04/27 14:27:15     50s]                         # It
[04/27 14:27:15     50s]                         # currently only constrains the primary delay corner capacitance values -
[04/27 14:27:15     50s]                         # other
[04/27 14:27:15     50s]                         # delay corners can be specified but will not be constrained. This attribute
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # applied in addition to the max_capacitance constraints read from the
[04/27 14:27:15     50s]                         # liberty
[04/27 14:27:15     50s]                         # library data - the tightest (lowest) of the constraint specified by
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # attribute and the constraint present in the liberty data will be used. It
[04/27 14:27:15     50s]                         # also
[04/27 14:27:15     50s]                         # does not apply at the root pins of clock trees - to constrain those nets
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used
[04/27 14:27:15     50s]                         # instead.
[04/27 14:27:15     50s]                         # Valid values: auto | double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_target_max_capacitance_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=delay_corner
[04/27 14:27:15     50s]                         # The target maximum capacitive load to allow during clock tree synthesis.
[04/27 14:27:15     50s]                         # This
[04/27 14:27:15     50s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # tree synthesis algorithm will allow any given base_pin to drive in a
[04/27 14:27:15     50s]                         # given
[04/27 14:27:15     50s]                         # clock tree when driving a given net_type. It is specified in library units.
[04/27 14:27:15     50s]                         # It
[04/27 14:27:15     50s]                         # currently only constrains the primary delay corner capacitance values -
[04/27 14:27:15     50s]                         # other
[04/27 14:27:15     50s]                         # delay corners can be specified but will not be constrained. This attribute
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # applied in addition to the max_capacitance constraints read from the
[04/27 14:27:15     50s]                         # liberty
[04/27 14:27:15     50s]                         # library data - the tightest (lowest) of the constraint specified by
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # attribute and the constraint present in the liberty data will be used. It
[04/27 14:27:15     50s]                         # also
[04/27 14:27:15     50s]                         # does not apply at the root pins of clock trees - to constrain those nets
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used
[04/27 14:27:15     50s]                         # instead.
[04/27 14:27:15     50s]                         # Valid values: auto | double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_target_max_capacitance_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=delay_corner
[04/27 14:27:15     50s]                         # The target maximum capacitive load to allow during clock tree synthesis.
[04/27 14:27:15     50s]                         # This
[04/27 14:27:15     50s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # tree synthesis algorithm will allow any given base_pin to drive in a
[04/27 14:27:15     50s]                         # given
[04/27 14:27:15     50s]                         # clock tree when driving a given net_type. It is specified in library units.
[04/27 14:27:15     50s]                         # It
[04/27 14:27:15     50s]                         # currently only constrains the primary delay corner capacitance values -
[04/27 14:27:15     50s]                         # other
[04/27 14:27:15     50s]                         # delay corners can be specified but will not be constrained. This attribute
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # applied in addition to the max_capacitance constraints read from the
[04/27 14:27:15     50s]                         # liberty
[04/27 14:27:15     50s]                         # library data - the tightest (lowest) of the constraint specified by
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # attribute and the constraint present in the liberty data will be used. It
[04/27 14:27:15     50s]                         # also
[04/27 14:27:15     50s]                         # does not apply at the root pins of clock trees - to constrain those nets
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used
[04/27 14:27:15     50s]                         # instead.
[04/27 14:27:15     50s]                         # Valid values: auto | double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_target_max_capacitance_trunk(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=delay_corner
[04/27 14:27:15     50s]                         # The target maximum capacitive load to allow during clock tree synthesis.
[04/27 14:27:15     50s]                         # This
[04/27 14:27:15     50s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the
[04/27 14:27:15     50s]                         # clock
[04/27 14:27:15     50s]                         # tree synthesis algorithm will allow any given base_pin to drive in a
[04/27 14:27:15     50s]                         # given
[04/27 14:27:15     50s]                         # clock tree when driving a given net_type. It is specified in library units.
[04/27 14:27:15     50s]                         # It
[04/27 14:27:15     50s]                         # currently only constrains the primary delay corner capacitance values -
[04/27 14:27:15     50s]                         # other
[04/27 14:27:15     50s]                         # delay corners can be specified but will not be constrained. This attribute
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # applied in addition to the max_capacitance constraints read from the
[04/27 14:27:15     50s]                         # liberty
[04/27 14:27:15     50s]                         # library data - the tightest (lowest) of the constraint specified by
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # attribute and the constraint present in the liberty data will be used. It
[04/27 14:27:15     50s]                         # also
[04/27 14:27:15     50s]                         # does not apply at the root pins of clock trees - to constrain those nets
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used
[04/27 14:27:15     50s]                         # instead.
[04/27 14:27:15     50s]                         # Valid values: auto | double
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_target_max_stage_delay_sigma(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices=delay_corner
[04/27 14:27:15     50s]                         # The max per-stage SOCV delay sigma target to use for CTS.
[04/27 14:27:15     50s]   cts_target_max_transition_time(root)
[04/27 14:27:15     50s]                         # string, read/write, default=top default trunk default leaf default,
[04/27 14:27:15     50s]                         # indices=delay_corner, power_domain
[04/27 14:27:15     50s]                         # The target slew used for clock tree synthesis. This attribute specifies
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # maximum slew time that the clock tree synthesis algorithm will allow in
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate
[04/27 14:27:15     50s]                         # value
[04/27 14:27:15     50s]                         # based on the collection of allowed buffer sizes and library
[04/27 14:27:15     50s]                         # parameters,
[04/27 14:27:15     50s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[04/27 14:27:15     50s]                         # CTS does not constrain the corner.
[04/27 14:27:15     50s]                         # Valid values: default | auto | ignore | double
[04/27 14:27:15     50s]   cts_target_max_transition_time_leaf(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[04/27 14:27:15     50s]                         # The target slew used for clock tree synthesis. This attribute specifies
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # maximum slew time that the clock tree synthesis algorithm will allow in
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate
[04/27 14:27:15     50s]                         # value
[04/27 14:27:15     50s]                         # based on the collection of allowed buffer sizes and library
[04/27 14:27:15     50s]                         # parameters,
[04/27 14:27:15     50s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[04/27 14:27:15     50s]                         # CTS does not constrain the corner.
[04/27 14:27:15     50s]                         # Valid values: default | auto | ignore | double
[04/27 14:27:15     50s]   cts_target_max_transition_time_top(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[04/27 14:27:15     50s]                         # The target slew used for clock tree synthesis. This attribute specifies
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # maximum slew time that the clock tree synthesis algorithm will allow in
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate
[04/27 14:27:15     50s]                         # value
[04/27 14:27:15     50s]                         # based on the collection of allowed buffer sizes and library
[04/27 14:27:15     50s]                         # parameters,
[04/27 14:27:15     50s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[04/27 14:27:15     50s]                         # CTS does not constrain the corner.
[04/27 14:27:15     50s]                         # Valid values: default | auto | ignore | double
[04/27 14:27:15     50s]   cts_target_max_transition_time_trunk(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[04/27 14:27:15     50s]                         # The target slew used for clock tree synthesis. This attribute specifies
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # maximum slew time that the clock tree synthesis algorithm will allow in
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and
[04/27 14:27:15     50s]                         # 
[04/27 14:27:15     50s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate
[04/27 14:27:15     50s]                         # value
[04/27 14:27:15     50s]                         # based on the collection of allowed buffer sizes and library
[04/27 14:27:15     50s]                         # parameters,
[04/27 14:27:15     50s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[04/27 14:27:15     50s]                         # CTS does not constrain the corner.
[04/27 14:27:15     50s]                         # Valid values: default | auto | ignore | double
[04/27 14:27:15     50s]   cts_target_skew(root)
[04/27 14:27:15     50s]                         # string, read/write, default=default, indices=delay_corner
[04/27 14:27:15     50s]                         # This specifies the target skew for clock tree balancing. This may be set to
[04/27 14:27:15     50s]                         # a
[04/27 14:27:15     50s]                         # numeric value, or one of 'auto', 'ignore' or 'default'.
[04/27 14:27:15     50s]                         # If set to 'auto' this indicates that an appropriate skew target should
[04/27 14:27:15     50s]                         # be
[04/27 14:27:15     50s]                         # computed.
[04/27 14:27:15     50s]                         # If set to 'ignore' this indicates that skew should not be balanced for 
[04/27 14:27:15     50s]                         # this corner/path combination.
[04/27 14:27:15     50s]                         # If unspecified then the value of this attribute is 'default'.
[04/27 14:27:15     50s]                         # If the value of the attribute is 'default' the target skew for late delays in
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # primary delay corner is interpreted as 'auto' and as 'ignore' otherwise.
[04/27 14:27:15     50s]                         # Valid values: default | auto | ignore | double
[04/27 14:27:15     50s]   cts_timing_connectivity_based_skew_groups(root)
[04/27 14:27:15     50s]                         # string, read/write, default=off, indices={}
[04/27 14:27:15     50s]                         # SDC false path assertions may render a generated SDC clock asynchronous to
[04/27 14:27:15     50s]                         # its
[04/27 14:27:15     50s]                         # master clock. Under such a condition, the sinks of the generated clock need
[04/27 14:27:15     50s]                         # not
[04/27 14:27:15     50s]                         # be balanced against the sinks of the master clock: there are no timing
[04/27 14:27:15     50s]                         # paths
[04/27 14:27:15     50s]                         # between the two clocks that can be affected by inter-clock skew. This
[04/27 14:27:15     50s]                         # balancing 'relaxation' is realized by adjusting the skew groups that
[04/27 14:27:15     50s]                         # are
[04/27 14:27:15     50s]                         # generated for the two clocks.
[04/27 14:27:15     50s]                         # This attribute specifies which SDC assertions are considered when
[04/27 14:27:15     50s]                         # deciding
[04/27 14:27:15     50s]                         # whether a generated clock is asynchronous to its master. Valid values for
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # attribute are as follows:
[04/27 14:27:15     50s]                         # off               In this mode, every generated SDC clock is treated as
[04/27 14:27:15     50s]                         # being synchronous to its master SDC clock.
[04/27 14:27:15     50s]                         # clock_false_path  Only Clock/clock set_false_path and set_clock_group
[04/27 14:27:15     50s]                         # assertions
[04/27 14:27:15     50s]                         # are considered.
[04/27 14:27:15     50s]                         # Valid values: off clock_false_path
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_timing_connectivity_based_skew_groups_balance_master_clocks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # This attribute has no effect if cts_timing_connectivity_based_skew_groups is
[04/27 14:27:15     50s]                         # set to 'off'.
[04/27 14:27:15     50s]                         # With timing connectivity based skew groups enabled, this attribute controls
[04/27 14:27:15     50s]                         # how
[04/27 14:27:15     50s]                         # CCOpt will address the synchrony of disjoint (i.e. non-overlapping)
[04/27 14:27:15     50s]                         # master
[04/27 14:27:15     50s]                         # (i.e. non-generated) SDC clocks.
[04/27 14:27:15     50s]                         # When this attribute is set to false, all disjoint master clocks are assumed
[04/27 14:27:15     50s]                         # to
[04/27 14:27:15     50s]                         # be mutually asynchronous. The skew groups generated by
[04/27 14:27:15     50s]                         # create_clock_tree_spec
[04/27 14:27:15     50s]                         # will not constrain the sinks of two such clocks to be balanced together.
[04/27 14:27:15     50s]                         # When this attribute is set to true, the synchrony of disjoint master clocks
[04/27 14:27:15     50s]                         # is
[04/27 14:27:15     50s]                         # determined by consulting the SDC assertions in accordance with the value
[04/27 14:27:15     50s]                         # of
[04/27 14:27:15     50s]                         # attribute cts_timing_connectivity_based_skew_groups.
[04/27 14:27:15     50s]                         # Additional skew groups will be generated by create_clock_tree_spec,
[04/27 14:27:15     50s]                         # such that the sinks of each pair of synchronous disjoint master clocks
[04/27 14:27:15     50s]                         # will be balanced together by CTS.
[04/27 14:27:15     50s]                         # Valid values true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_timing_connectivity_info(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # This attribute is populated by clock spec creation when timing
[04/27 14:27:15     50s]                         # connectivity based skew groups are enabled. Configuration of this
[04/27 14:27:15     50s]                         # attribute
[04/27 14:27:15     50s]                         # will be written to the generated spec. It documents the clock/clock
[04/27 14:27:15     50s]                         # balancing
[04/27 14:27:15     50s]                         # relationships that were determined for the production of timing
[04/27 14:27:15     50s]                         # connectivity
[04/27 14:27:15     50s]                         # based skew groups. This attribute is documenting only.
[04/27 14:27:15     50s]                         # If timing connectivity based skew groups are not enabled, this
[04/27 14:27:15     50s]                         # attribute is not populated by spec creation.
[04/27 14:27:15     50s]                         # The value of the attribute is a set of nested Tcl dictionaries,
[04/27 14:27:15     50s]                         # four levels in total. The top-level dictionary indicates the
[04/27 14:27:15     50s]                         # information
[04/27 14:27:15     50s]                         # category. Currently there is only one such category: 'clock_relationships'.
[04/27 14:27:15     50s]                         # The
[04/27 14:27:15     50s]                         # second level is keyed on constrained mode name; the lowest level
[04/27 14:27:15     50s]                         # dictionaries
[04/27 14:27:15     50s]                         # are both keyed on SDC clock name. These keys taken together identify two
[04/27 14:27:15     50s]                         # SDC
[04/27 14:27:15     50s]                         # clocks in a given constraint mode. The leaf value specifies the
[04/27 14:27:15     50s]                         # resolved
[04/27 14:27:15     50s]                         # balancing relationships between the two SDC clocks. It an enum with
[04/27 14:27:15     50s]                         # the
[04/27 14:27:15     50s]                         # following members:
[04/27 14:27:15     50s]                         # - direct   - The two clocks are determined to belong to the same clock group 
[04/27 14:27:15     50s]                         # and must be balanced together.
[04/27 14:27:15     50s]                         # - indirect - The two clocks do not belong to the same clock group; however
[04/27 14:27:15     50s]                         # by transitive closure they must balance together.
[04/27 14:27:15     50s]                         # Clocks in a direct or indirect balancing relationship will share one or
[04/27 14:27:15     50s]                         # more
[04/27 14:27:15     50s]                         # skew groups so as to ensure that their sinks are balanced together by
[04/27 14:27:15     50s]                         # CTS.
[04/27 14:27:15     50s]                         # Missing entries should be taken as 'need not balance'; i.e. the pair of
[04/27 14:27:15     50s]                         # SDC
[04/27 14:27:15     50s]                         # clocks have neither a direct nor indirect balancing relationship.
[04/27 14:27:15     50s]                         # The indirect balancing relationship can be explored in more detail using
[04/27 14:27:15     50s]                         # this
[04/27 14:27:15     50s]                         # same Tcl dictionary to probe out the transitive closure over the
[04/27 14:27:15     50s]                         # direct
[04/27 14:27:15     50s]                         # balancing relationships that link two indirect balance clocks together.
[04/27 14:27:15     50s]                         # For
[04/27 14:27:15     50s]                         # example if clock A directly balances with clock B only, and clock B
[04/27 14:27:15     50s]                         # directly
[04/27 14:27:15     50s]                         # balances with clock C only; then clock A indirectly balances with clock
[04/27 14:27:15     50s]                         # C.
[04/27 14:27:15     50s]                         # Below is an example dict value, corresponding to clock groups {clkA clkB}
[04/27 14:27:15     50s]                         # {clkB
[04/27 14:27:15     50s]                         # clkC} in constraint mode cm1, and clock groups {clkP clkQ} {clkR clkS}
[04/27 14:27:15     50s]                         # in
[04/27 14:27:15     50s]                         # constraint mode cm2.
[04/27 14:27:15     50s]                         # {clock_relationships  {cm1 {clkA {clkB direct clkC indirect}  clkB {clkA direct
[04/27 14:27:15     50s]                         # clkC direct}  clkC {clkA indirect clkB direct}}  cm2 {clkP {clkQ direct}  clkQ
[04/27 14:27:15     50s]                         # {clkP direct}  clkR {clkS direct}  clkS {clkR direct}}}}
[04/27 14:27:15     50s]                         # Notice that although they are in separate clock groups, clkA and
[04/27 14:27:15     50s]                         # clkC
[04/27 14:27:15     50s]                         # nevertheless indirectly balance. This is due to fact that clkB is present
[04/27 14:27:15     50s]                         # in
[04/27 14:27:15     50s]                         # both clock groups. Note also that we omit information about the
[04/27 14:27:15     50s]                         # relationship
[04/27 14:27:15     50s]                         # between clkP and clkS: they are 'need not balance'.
[04/27 14:27:15     50s]   cts_top_fanout_threshold(root)
[04/27 14:27:15     50s]                         # string, read/write, default=unset, indices={}
[04/27 14:27:15     50s]                         # Minimum number of transitive fanout in the clock tree for a net to be routed
[04/27 14:27:15     50s]                         # as a top net. Nets with at least this many sinks in their transitive fanout
[04/27 14:27:15     50s]                         # in
[04/27 14:27:15     50s]                         # the clock tree will have the special routing rules applied to them.
[04/27 14:27:15     50s]                         # Valid values: integer
[04/27 14:27:15     50s]   cts_update_clock_latency(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Determine whether to update IO latencies within ccopt_design.
[04/27 14:27:15     50s]                         # Valid values: true false
[04/27 14:27:15     50s]   cts_use_inverters(root)
[04/27 14:27:15     50s]                         # string, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # Specifies whether clock tree synthesis should prefer to use inverters
[04/27 14:27:15     50s]                         # rather
[04/27 14:27:15     50s]                         # than buffers when balancing the clock tree. If set to true, CTS will
[04/27 14:27:15     50s]                         # use
[04/27 14:27:15     50s]                         # inverters for the clock tree balancing process. If set to false, CTS will
[04/27 14:27:15     50s]                         # use
[04/27 14:27:15     50s]                         # the minimum number of levels of inverters required to maintain
[04/27 14:27:15     50s]                         # logical
[04/27 14:27:15     50s]                         # correctness. If set to auto (the default) CTS will use what it considers to
[04/27 14:27:15     50s]                         # be
[04/27 14:27:15     50s]                         # the best combination of buffers and inverters to get optimal quality
[04/27 14:27:15     50s]                         # of
[04/27 14:27:15     50s]                         # results.
[04/27 14:27:15     50s]                         # Valid values: auto true false
[04/27 14:27:15     50s] 
[04/27 14:27:15     50s]   cts_use_receiver_model_capacitance_for_drv(root)
[04/27 14:27:15     50s]                         # string, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If auto, CCOpt will use receiver model capacitance for drv if global variable
[04/27 14:27:15     50s]                         # timing_report_use_receiver_model_capacitance is true.
[04/27 14:27:15     50s]                         # If true, CCOpt will use receiver model capacitance for drv even if
[04/27 14:27:15     50s]                         # timing_report_use_receiver_model_capacitance is false.
[04/27 14:27:15     50s]                         # If false, CCOpt will not use receiver model capacitance for drv.
[04/27 14:27:15     50s]                         # Valid values: auto true false
[04/27 14:27:15     50s]   current_design(root)  # design, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # current design
[04/27 14:27:15     50s]   dataflow_hinsts(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # specify hinst to be placed
[04/27 14:27:15     50s]   delay_corners(root)   # delay_corner*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the delay corners in the design.
[04/27 14:27:15     50s]   delaycal_accuracy_level(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # set accuracy level for delay calculation
[04/27 14:27:15     50s]   delaycal_advanced_node_pin_cap_settings(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enable advanced node pin cap settings.
[04/27 14:27:15     50s]   delaycal_advanced_pin_cap_mode(root)
[04/27 14:27:15     50s]                         # enum {0 1 2}, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Enable advanced receiver pin cap mode for base delay.
[04/27 14:27:15     50s]   delaycal_aging_activity_propagation_mode(root)
[04/27 14:27:15     50s]                         # enum {probabilistic worst_case}, read/write, default=probabilistic,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # activity (duty cycle and toggle rate) propagation mode
[04/27 14:27:15     50s]   delaycal_aging_constraints(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # enable aging constraints
[04/27 14:27:15     50s]   delaycal_aging_max_duty_cycle(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.0, indices={}
[04/27 14:27:15     50s]                         # default maximum duty cycle
[04/27 14:27:15     50s]   delaycal_aging_max_toggle_rate(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1e+08, indices={}
[04/27 14:27:15     50s]                         # default maximum toggle rate (number of transitions per second)
[04/27 14:27:15     50s]   delaycal_aging_min_duty_cycle(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # default minimum duty cycle
[04/27 14:27:15     50s]   delaycal_aging_min_toggle_rate(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # default minimum toggle rate (number of transitions per second)
[04/27 14:27:15     50s]   delaycal_aging_recovery(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # enable aging recovery analysis
[04/27 14:27:15     50s]   delaycal_aging_sequential_activity_propagation(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # enable activity propagation through sequentials
[04/27 14:27:15     50s]   delaycal_aging_sequential_max_duty_cycle(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.0, indices={}
[04/27 14:27:15     50s]                         # default sequential maximum duty cycle
[04/27 14:27:15     50s]   delaycal_aging_sequential_max_toggle_rate(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1e+08, indices={}
[04/27 14:27:15     50s]                         # default sequential maximum toggle rate (number of transitions per second)
[04/27 14:27:15     50s]   delaycal_aging_sequential_min_duty_cycle(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # default sequential minimum duty cycle
[04/27 14:27:15     50s]   delaycal_aging_sequential_min_toggle_rate(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # default sequential minimum toggle rate (number of transitions per second)
[04/27 14:27:15     50s]   delaycal_aging_type(root)
[04/27 14:27:15     50s]                         # enum {bti hci all}, read/write, default=all, indices={}
[04/27 14:27:15     50s]                         # type of aging analysis
[04/27 14:27:15     50s]   delaycal_aging_use_fixed_duty_cycle(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # enable fixed duty cycle instead of propagated duty cycle for aging
[04/27 14:27:15     50s]   delaycal_combine_mmmc(root)
[04/27 14:27:15     50s]                         # enum {none early_late early_late_corner}, read/write,
[04/27 14:27:15     50s]                         # default=early_late_corner, indices={}
[04/27 14:27:15     50s]                         # Specifies whether delay calculation runs are to be combined for delay
[04/27 14:27:15     50s]                         # calculation simulations
[04/27 14:27:15     50s]   delaycal_default_net_delay(root)
[04/27 14:27:15     50s]                         # string, read/write, default=1000ps, indices={}
[04/27 14:27:15     50s]                         # set default net delay.
[04/27 14:27:15     50s]   delaycal_default_net_load(root)
[04/27 14:27:15     50s]                         # string, read/write, default=0.5pf, indices={}
[04/27 14:27:15     50s]                         # set default net load.
[04/27 14:27:15     50s]   delaycal_degrade_slew_on_early_nets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Controls interconnect slew degradation for early paths.
[04/27 14:27:15     50s]   delaycal_early_irdrop_data_type(root)
[04/27 14:27:15     50s]                         # enum {best_average worst best average worst_average}, read/write,
[04/27 14:27:15     50s]                         # default=worst, indices={}
[04/27 14:27:15     50s]                         # IRDrop EIV DB EivMethod for early corner
[04/27 14:27:15     50s]   delaycal_enable_high_fanout(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables the default net delay which will be annotated on high fanout nets
[04/27 14:27:15     50s]   delaycal_enable_quiet_receivers_for_hold(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   delaycal_enable_si(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables SIAware delay calculation that also includes cross-talk induced delays.
[04/27 14:27:15     50s]   delaycal_enable_wire_load_model(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Enables support of  Liberty wire-load models and related SDC commands.
[04/27 14:27:15     50s]   delaycal_equivalent_waveform_model(root)
[04/27 14:27:15     50s]                         # enum {none no_propagation propagation}, read/write, default=none,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Controls the equivalent waveform model to be used
[04/27 14:27:15     50s]   delaycal_equivalent_waveform_model_for_timing_check(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enable EWM for timing check delay.
[04/27 14:27:15     50s]   delaycal_equivalent_waveform_type(root)
[04/27 14:27:15     50s]                         # enum {moments simulation}, read/write, default=moments, indices={}
[04/27 14:27:15     50s]                         # Equivalent waveform model type to be used
[04/27 14:27:15     50s]   delaycal_honor_slew_propagate_constraint(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Determines whether to propagate the slew from the disabled timing arcs to the
[04/27 14:27:15     50s]                         # output pin.
[04/27 14:27:15     50s]   delaycal_ignore_net_load(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Uses zero-cap, zero-resistance wire-load model for estimating delays.
[04/27 14:27:15     50s]   delaycal_input_transition_delay(root)
[04/27 14:27:15     50s]                         # string, read/write, default=0ps, indices={}
[04/27 14:27:15     50s]                         # set default input transition time.
[04/27 14:27:15     50s]   delaycal_irdrop_data_type(root)
[04/27 14:27:15     50s]                         # enum {best_average worst best average worst_average}, read/write,
[04/27 14:27:15     50s]                         # default=worst, indices={}
[04/27 14:27:15     50s]                         # IRDrop EIV DB EivMethod
[04/27 14:27:15     50s]   delaycal_irdrop_window_based(root)
[04/27 14:27:15     50s]                         # enum {none late early both}, read/write, default=both, indices={}
[04/27 14:27:15     50s]                         # Fetch window based EIV values from EIV DB
[04/27 14:27:15     50s]   delaycal_late_irdrop_data_type(root)
[04/27 14:27:15     50s]                         # enum {best_average worst best average worst_average}, read/write,
[04/27 14:27:15     50s]                         # default=worst, indices={}
[04/27 14:27:15     50s]                         # IRDrop EIV DB EivMethod for late corner
[04/27 14:27:15     50s]   delaycal_library_interpolation_mode(root)
[04/27 14:27:15     50s]                         # enum {linear non_linear}, read/write, default=linear, indices={}
[04/27 14:27:15     50s]                         # library scaling mode for interpolation flow
[04/27 14:27:15     50s]   delaycal_report_out_bound(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Generates a report that contains a list of index values (input transition) in
[04/27 14:27:15     50s]                         # the delay tables that are beyond the index range.
[04/27 14:27:15     50s]   delaycal_signoff_alignment_settings(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Turn on/off signoff alignment settings
[04/27 14:27:15     50s]   delaycal_skip_slew_merge_from_disabled_path(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enable slew merge from disable path
[04/27 14:27:15     50s]   delaycal_slew_out_bound_limit_high(root)
[04/27 14:27:15     50s]                         # double, read/write, default=3.40282e+38, indices={}
[04/27 14:27:15     50s]                         # Limits the maximum slew used in the analysis to the specified value.
[04/27 14:27:15     50s]   delaycal_slew_out_bound_limit_low(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.5, indices={}
[04/27 14:27:15     50s]                         # Limits the minimum slew used in the analysis to the specified value.
[04/27 14:27:15     50s]   delaycal_socv_accuracy_mode(root)
[04/27 14:27:15     50s]                         # enum {low medium high ultra}, read/write, default=low,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # level-based-accuracy-effort in AAE for delays and slews
[04/27 14:27:15     50s]   delaycal_socv_lvf_mode(root)
[04/27 14:27:15     50s]                         # enum {moments early_late}, read/write, default=early_late, indices={}
[04/27 14:27:15     50s]                         # Controls interpretation of LVF data.
[04/27 14:27:15     50s]   delaycal_socv_machine_learning_level(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Enable socv machine learning mode
[04/27 14:27:15     50s]   delaycal_socv_use_lvf_tables(root)
[04/27 14:27:15     50s]                         # string, read/write, default=all, indices={}
[04/27 14:27:15     50s]                         # Controls which type of variations are considered during analysis.
[04/27 14:27:15     50s]   delaycal_support_output_pin_cap(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # useOutputPinCap
[04/27 14:27:15     50s]   delaycal_support_wire_load_model(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Enables support of  Liberty wire-load models and related SDC commands.
[04/27 14:27:15     50s]   delaycal_timing_create_clock_use_ideal_slew(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, the software detects created clocks and uses zero input slew.
[04/27 14:27:15     50s]                         # Other slew values, including those set using set_annotated_transition command,
[04/27 14:27:15     50s]                         # will be ignored. When set to false, the software honors
[04/27 14:27:15     50s]                         # set_annotated_transition command settings. By default, this global variable is
[04/27 14:27:15     50s]                         # set to false.
[04/27 14:27:15     50s]   delaycal_use_default_delay_limit(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1000, indices={}
[04/27 14:27:15     50s]                         # set threshold to apply the default delay
[04/27 14:27:15     50s]   delaycal_write_set_inst_voltage_cmd(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enable set_inst_voltage cmd saving in persistant db
[04/27 14:27:15     50s]   design_bottom_routing_layer(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the lowest LEF layer name or layer number for global and detail
[04/27 14:27:15     50s]                         # routing. Layer number is from the LEF layer sequence. For example, 2 is
[04/27 14:27:15     50s]                         # equivalent to the second routing layer defined in LEF.
[04/27 14:27:15     50s]   design_compressed_pg_db(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether the compressed pg feature is enabled. When it's true, read_db
[04/27 14:27:15     50s]                         # will automatically compress the PG data when load the design. You can use
[04/27 14:27:15     50s]                         # "get_db current_design .is_pg_compressed" to check if PG in this design is
[04/27 14:27:15     50s]                         # compressed.
[04/27 14:27:15     50s]   design_cong_effort(root)
[04/27 14:27:15     50s]                         # enum {low medium high auto}, read/write, default=auto, indices={}
[04/27 14:27:15     50s]                         # Specify congestion effort level
[04/27 14:27:15     50s]   design_dual_rail_via_pitch(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Min stacked-via pitch for dual std-cell power-rails on first and third routing
[04/27 14:27:15     50s]                         # layers. Space separated min stacked-via pitch for dual std-cell power-rails on
[04/27 14:27:15     50s]                         # first and third routing layers.
