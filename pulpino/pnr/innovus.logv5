[04/27 14:27:15     50s]                         # tech for RMS limits. Default=5.
[04/27 14:27:15     50s]   check_ac_limit_delta_temperature_layer_list(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies layer based delta temperature for EM RMS currnet limit analysis
[04/27 14:27:15     50s]   check_ac_limit_detailed(root)
