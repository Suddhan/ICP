[04/27 14:27:15     50s]                         # minimum IO height is used.
[04/27 14:27:15     50s]   floorplan_minimum_sites(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Specify the number of minimal sites (N) that check_floorplan will check for the
[04/27 14:27:15     50s]                         # same length site rule. When same_length_site is specified in
[04/27 14:27:15     50s]                         # floorplan_check_types, this option is required.
[04/27 14:27:15     50s]   floorplan_move_macros_with_constraint(root)
[04/27 14:27:15     50s]                         # enum* {guide region fence none all}, read/write, default=fence,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify macros move with constraint modules at the same time.
[04/27 14:27:15     50s]   floorplan_move_preplaced_std_cell_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify only pre-placed std cells move with constraint modules at the same
[04/27 14:27:15     50s]                         # time.
[04/27 14:27:15     50s]   floorplan_move_std_cell_with_constraint(root)
[04/27 14:27:15     50s]                         # enum* {guide region fence none all}, read/write, default=none,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify std cells move with constraint modules at the same time.
[04/27 14:27:15     50s]   floorplan_narrow_channel_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Reports narrow channels whose width (in micros) is smaller than the specified
[04/27 14:27:15     50s]                         # value. When narrow_channel is specified in floorplan_check_types, this option
[04/27 14:27:15     50s]                         # is required.
[04/27 14:27:15     50s]   floorplan_no_cut_row(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify no need to do cut row before other operations.
[04/27 14:27:15     50s]   floorplan_placement_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The placement grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin
[04/27 14:27:15     50s]                         # is lower left corner of die box (the design .boundary). The x_pitch is the
[04/27 14:27:15     50s]                         # pitch of lowest  vertical metal layer and separates the vertical grid lines.
[04/27 14:27:15     50s]                         # The y_pitch is pitch of lowest horizontal metal layer and separates the
[04/27 14:27:15     50s]                         # horizontal grid lines.
[04/27 14:27:15     50s]   floorplan_power_rail_layer(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify the layers for calculating power/ground on bottom attribute of cell or
[04/27 14:27:15     50s]                         # techsite. By default, the lowest metal layer is used.
[04/27 14:27:15     50s]   floorplan_row_site_height(root)
[04/27 14:27:15     50s]                         # enum {any odd even}, read/write, default=any, indices={}
[04/27 14:27:15     50s]                         # Specify the odd even row height constraints.
[04/27 14:27:15     50s]   floorplan_row_site_width(root)
[04/27 14:27:15     50s]                         # enum {any odd even}, read/write, default=any, indices={}
[04/27 14:27:15     50s]                         # Specify the odd even row width constraints.
[04/27 14:27:15     50s]   floorplan_snap_all_corners_to_grid(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify to snap all corners of object to grid.
[04/27 14:27:15     50s]   floorplan_snap_block_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst
[04/27 14:27:15     50s]                         # finfet_manufacturing finfet_placement}, read/write, default=manufacturing,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify the block snap rules. It can be set to snap to manufacture grid,
[04/27 14:27:15     50s]                         # instance grid, placement grid, user-define grid, layer_track grid, finfet
[04/27 14:27:15     50s]                         # manufacture grid, finfet instance grid, finfet placement grid. The default is
[04/27 14:27:15     50s]                         # manufacturing_grid. For Finfet design, the default is
[04/27 14:27:15     50s]                         # finfet_manufacturing_grid.
[04/27 14:27:15     50s]   floorplan_snap_constraint_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst
[04/27 14:27:15     50s]                         # finfet_manufacturing finfet_placement}, read/write, default=inst,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify the constraint snap rules. It can be set to snap to manufacture grid,
[04/27 14:27:15     50s]                         # instance grid, placement grid, user-define grid, layer_track grid, finfet
[04/27 14:27:15     50s]                         # manufacture grid, finfet instance grid, finfet placement grid. The default is
[04/27 14:27:15     50s]                         # inst_grid. For Finfet design, the default is finfet_inst_grid.
[04/27 14:27:15     50s]   floorplan_snap_core_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst
[04/27 14:27:15     50s]                         # finfet_manufacturing finfet_placement}, read/write, default=placement,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify the core snap rules. It can be set to snap to manufacture grid,
[04/27 14:27:15     50s]                         # instance grid, placement grid, user-define grid, layer_track grid, finfet
[04/27 14:27:15     50s]                         # manufacture grid, finfet instance grid, finfet placement grid. The default is
[04/27 14:27:15     50s]                         # placement_grid. For Finfet design, the default is finfet_placement_grid.
[04/27 14:27:15     50s]   floorplan_snap_die_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst
[04/27 14:27:15     50s]                         # finfet_manufacturing finfet_placement}, read/write, default=placement,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify the die snap rules. It can be set to snap to manufacture grid, instance
[04/27 14:27:15     50s]                         # grid, placement grid, user-define grid, layer_track grid, finfet manufacture
[04/27 14:27:15     50s]                         # grid, finfet instance grid, finfet placement grid. The default is
[04/27 14:27:15     50s]                         # placement_grid. For Finfet design, the default is finfet_placement_grid.
[04/27 14:27:15     50s]   floorplan_snap_io_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst
[04/27 14:27:15     50s]                         # finfet_manufacturing finfet_placement}, read/write, default=manufacturing,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specify the IO snap rules. It can be set to snap to manufacture grid, instance
[04/27 14:27:15     50s]                         # grid, placement grid, user-define grid, layer_track grid, finfet manufacture
[04/27 14:27:15     50s]                         # grid, finfet instance grid, finfet placement grid. The default is
[04/27 14:27:15     50s]                         # manufacturing_grid. For Finfet design, the default is
[04/27 14:27:15     50s]                         # finfet_manufacturing_grid.
[04/27 14:27:15     50s]   floorplan_snap_place_blockage_grid(root)
[04/27 14:27:15     50s]                         # enum {manufacturing inst finfet_inst finfet_manufacturing}, read/write,
[04/27 14:27:15     50s]                         # default=inst, indices={}
[04/27 14:27:15     50s]                         # Specify the placement blockage snap rules. The default is inst_grid.
[04/27 14:27:15     50s]   floorplan_user_define_grid(root)
[04/27 14:27:15     50s]                         # rect, read/write, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # Specify the user-define grid. Format is {x_offset y_offset x_pitch y_pitch}.
[04/27 14:27:15     50s]                         # The x_offset y_offset is the offset of user-define grid. The x_pitch separates
[04/27 14:27:15     50s]                         # the vertical grid lines. The y_pitch separates the horizontal grid lines. The
[04/27 14:27:15     50s]                         # values are in microns.
[04/27 14:27:15     50s]   floorplan_vertical_row(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Specifies that the rows in the floorplan are vertical (1) or horizontal (0).
[04/27 14:27:15     50s]   flow_branch(root)     # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Branch being run for a hierarchical flow.
[04/27 14:27:15     50s]   flow_caller_data(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Data used by the caller of the tool to identify this flow.
[04/27 14:27:15     50s]   flow_db_directory(root)
[04/27 14:27:15     50s]                         # string, read/write, default=dbs, indices={}
[04/27 14:27:15     50s]                         # Flow directory where results databases are stored.
[04/27 14:27:15     50s]   flow_error_errorinfo(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Tcl error stack in error database.
[04/27 14:27:15     50s]   flow_error_message(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Tcl error message in error database.
[04/27 14:27:15     50s]   flow_error_write_db(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Write a database when a flow step results in an error condition.
[04/27 14:27:15     50s]   flow_exclude_time_for_init_flow(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Marks all snapshots created during the init_flow command as
[04/27 14:27:15     50s]                         # 'exclude_time_metric'. This includes user steps added to the init_flow internal
[04/27 14:27:15     50s]                         # plugin locations.
[04/27 14:27:15     50s]   flow_exit_when_done(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
