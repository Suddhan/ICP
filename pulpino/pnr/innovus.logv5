[04/27 14:27:15     50s]                         # Specifies the diagonal length of the core area, in microns
[04/27 14:27:15     50s]   timing_aocv_derate_mode(root)
[04/27 14:27:15     50s]                         # enum {aocv_multiplicative aocv_additive}, read/write,
