[04/27 14:27:15     50s]   check_drc_area(root)  # rect, read/write, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the coordinates of the area to verify
[04/27 14:27:15     50s]   check_drc_check_only(root)
