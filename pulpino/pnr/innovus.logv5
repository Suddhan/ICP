[04/27 14:27:15     50s]                         # -hier_delimiter parameter.
[04/27 14:27:15     50s]   power_honor_combinational_logic_on_clock_net(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
