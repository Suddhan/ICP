[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables resizing of power switch instances during optimization
[04/27 14:27:15     50s]   opt_sequential_genus_restructure_report_failure_reason(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # To enable printing SeqCRR failure reasons
[04/27 14:27:15     50s]   opt_setup_target_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies target slack value (in nano secs) for setup timing optimization
[04/27 14:27:15     50s]   opt_signoff_add_inst(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies whether timing optimizer is allowed to add buffer/delay/inverter cell
[04/27 14:27:15     50s]                         # instances.
[04/27 14:27:15     50s]   opt_signoff_add_load(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether Hold optimizer is allowed to add dummy cell instances
[04/27 14:27:15     50s]   opt_signoff_allow_skewing(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # useful skew based setup opt
[04/27 14:27:15     50s]   opt_signoff_along_route_buffering(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Allow buffer/inverter to be inserted along the route and not only at driver or
[04/27 14:27:15     50s]                         # sink terms.
[04/27 14:27:15     50s]   opt_signoff_buffer_cell_list(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies a list of buffer/delay cells that can be used for DRV and Hold
[04/27 14:27:15     50s]                         # optimizers, regardless of whether those cells have a "dont_use" attribute.
[04/27 14:27:15     50s]   opt_signoff_check_drv_from_hold_views(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # consider DRVs from hold views
[04/27 14:27:15     50s]   opt_signoff_check_type(root)
[04/27 14:27:15     50s]                         # enum {early late both}, read/write, default=both, indices={}
[04/27 14:27:15     50s]                         # Check type for path based analysis.
[04/27 14:27:15     50s]   opt_signoff_clock_cell_list(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Restricts the list of buffers/inverter/gating cells that are allowed to be used
[04/27 14:27:15     50s]                         # by ECO on the clock tree.
[04/27 14:27:15     50s]   opt_signoff_clock_max_level(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # max level allowed for clock tree
[04/27 14:27:15     50s]   opt_signoff_delete_inst(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # delete buffer for optimization
[04/27 14:27:15     50s]   opt_signoff_disable_geometry_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Performs Vth swapping without checking pins geometry.
[04/27 14:27:15     50s]   opt_signoff_drv_margin(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies a margin value by which ratio the drv check would be relaxed or
[04/27 14:27:15     50s]                         # tightened
[04/27 14:27:15     50s]   opt_signoff_eco_file_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the prefix name for the ECO files generated.
[04/27 14:27:15     50s]   opt_signoff_fix_clock_drv(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # fix max_cap/max_tran violations on clock nets
[04/27 14:27:15     50s]   opt_signoff_fix_data_drv(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # fix max_cap/max_tran violations on data nets
[04/27 14:27:15     50s]   opt_signoff_fix_glitch(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # fix nets with glitch
[04/27 14:27:15     50s]   opt_signoff_fix_hold_allow_setup_optimization(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # simultaneous hold and setup fixing
[04/27 14:27:15     50s]   opt_signoff_fix_hold_allow_setup_tns_degrade(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When active, the Setup Total Negative Slack can be degraded during Hold time
[04/27 14:27:15     50s]                         # violations fixing while still maintaining the Setup Worst Negative Slack in
[04/27 14:27:15     50s]                         # every Setup active views.
[04/27 14:27:15     50s]   opt_signoff_fix_hold_with_margin(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies a slack margin value in nanoseconds for Hold time violations fixing.
[04/27 14:27:15     50s]                         # The purpose is to overfix any Hold violations by the amount of the margin
[04/27 14:27:15     50s]                         # value. This margin is not applied on nets that are already meeting the Hold
[04/27 14:27:15     50s]                         # target slack. 
[04/27 14:27:15     50s]   opt_signoff_fix_ir_drop(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # fix ir-drop hotspots
[04/27 14:27:15     50s]   opt_signoff_fix_max_cap(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables max_cap violations fixing during DRV optimization.
[04/27 14:27:15     50s]   opt_signoff_fix_max_transition(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables max_tran violations fixing during DRV optimization.
[04/27 14:27:15     50s]   opt_signoff_fix_si_slew(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Performs SI Slew fixing during DRV fixing using resizing and buffering
[04/27 14:27:15     50s]                         # techniques.
[04/27 14:27:15     50s]   opt_signoff_fix_xtalk(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Reduces the crosstalk on the net that violates the thresholds set by the user.
[04/27 14:27:15     50s]   opt_signoff_hold_target_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies a target slack value in nanoseconds for hold timing optimize
[04/27 14:27:15     50s]   opt_signoff_hold_xtalk_delta_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.3, indices={}
[04/27 14:27:15     50s]                         # Crosstalk delta delay threshold for selecting nets in hold timing views when
[04/27 14:27:15     50s]                         # running Xtalk fixing.
[04/27 14:27:15     50s]   opt_signoff_hold_xtalk_slack_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1000.0, indices={}
[04/27 14:27:15     50s]                         # Slack threshold for selecting nets in hold timing views when running Xtalk
[04/27 14:27:15     50s]                         # fixing.
[04/27 14:27:15     50s]   opt_signoff_ignore_drv_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Ignores DRV checks during timing/area/power optimization.
[04/27 14:27:15     50s]   opt_signoff_keep_tmp_files(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # To keep all the temporary files generated by D-MMMC and Tempus clients for
[04/27 14:27:15     50s]                         # debugging purposes.
[04/27 14:27:15     50s]   opt_signoff_legal_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables/disables legal location checks during resizing and buffering
[04/27 14:27:15     50s]   opt_signoff_load_cell_list(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the list of load cells
[04/27 14:27:15     50s]   opt_signoff_max_cap_margin(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the ratio by which the max_cap check would be relaxed or tightened
[04/27 14:27:15     50s]   opt_signoff_max_paths(root)
[04/27 14:27:15     50s]                         # int, read/write, default=-1, indices={}
[04/27 14:27:15     50s]                         # Specifies how many paths are getting retimed for ECO DB generation in PBA mode.
[04/27 14:27:15     50s]   opt_signoff_max_runtime(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # If set to a positive value, would restrict the command runtime by that value,
[04/27 14:27:15     50s]                         # in minutes.
[04/27 14:27:15     50s]   opt_signoff_max_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the maximum GBA slack value to be used when selecting paths to be
[04/27 14:27:15     50s]                         # retimed for ECO DB generation in PBA mode.
[04/27 14:27:15     50s]   opt_signoff_max_transition_margin(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the ratio by which the max_tran check would be relaxed or tightened
[04/27 14:27:15     50s]   opt_signoff_num_report_paths(root)
[04/27 14:27:15     50s]                         # int, read/write, default=50, indices={}
[04/27 14:27:15     50s]                         # Number of paths printed after signoff timing analysis per view
[04/27 14:27:15     50s]   opt_signoff_nworst(root)
[04/27 14:27:15     50s]                         # int, read/write, default=-1, indices={}
[04/27 14:27:15     50s]                         # Specifies the number of paths to be retimed per endpoints for ECO DB generation
[04/27 14:27:15     50s]                         # in PBA mode.
[04/27 14:27:15     50s]   opt_signoff_optimize_core_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables the tool to optimize timing or recover area/power only on register to
[04/27 14:27:15     50s]                         # register paths.
[04/27 14:27:15     50s]   opt_signoff_optimize_replicated_modules(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Allows the tool to perform timing optimization inside replicated hierarchies
[04/27 14:27:15     50s]                         # while generating only one ECO file per sets of clones.  The cell name of the
[04/27 14:27:15     50s]                         # replicated hierarchies have to be listed in a file pointed by the
[04/27 14:27:15     50s]                         # opt_signoff_partition_list_file option.
[04/27 14:27:15     50s]   opt_signoff_optimize_sequential_cells(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies whether the timing/area/power optimizer is allowed to optimize
[04/27 14:27:15     50s]                         # sequential cells.
[04/27 14:27:15     50s]   opt_signoff_partition_list_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # File containing list of partitions in the design
[04/27 14:27:15     50s]   opt_signoff_pba_eco_route(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables PBA timing to be passed to ecoRoute for higher timing driven routing
[04/27 14:27:15     50s]                         # accuracy
[04/27 14:27:15     50s]   opt_signoff_pba_effort(root)
[04/27 14:27:15     50s]                         # enum {medium high}, read/write, default=medium, indices={}
[04/27 14:27:15     50s]                         # When enabling "high" effort mode, all the optimization engines will perform
[04/27 14:27:15     50s]                         # more aggressive timing closure or area/power recovery with respect to PBA
[04/27 14:27:15     50s]                         # timing and the expectation is to get better quality of results.
[04/27 14:27:15     50s]   opt_signoff_post_mask(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # enable post mask ECO mode
[04/27 14:27:15     50s]   opt_signoff_post_mask_decap_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify list of PF decap cells that are allowed to be removed in post mask mode
[04/27 14:27:15     50s]   opt_signoff_post_mask_filler_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify list of PF filler cells that are allowed to be removed/reinserted in
[04/27 14:27:15     50s]                         # post mask mode
[04/27 14:27:15     50s]   opt_signoff_post_mask_gate_array_filler_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # original of enable post mask mode to use cells from the specified list at GA
[04/27 14:27:15     50s]                         # filler sites
[04/27 14:27:15     50s]   opt_signoff_post_mask_logic_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify list of PF filler logic/ECO cells that are allowed to be used during
[04/27 14:27:15     50s]                         # optimization in post mask mode
[04/27 14:27:15     50s]   opt_signoff_post_sta_tcl(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # File containing the TCL code that will be executed immediately after signoff
[04/27 14:27:15     50s]                         # timing analysis per view
[04/27 14:27:15     50s]   opt_signoff_power_aware(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # power awareness in all optimizers and transforms
[04/27 14:27:15     50s]   opt_signoff_power_opt_focus(root)
[04/27 14:27:15     50s]                         # enum {total leakage dynamic leakageOnly dynamicOnly}, read/write,
[04/27 14:27:15     50s]                         # default=total, indices={}
[04/27 14:27:15     50s]                         # focus for power optimization
[04/27 14:27:15     50s]   opt_signoff_pre_sta_tcl(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # File containing the TCL code that will be executed immediately prior to signoff
[04/27 14:27:15     50s]                         # timing analysis per view
[04/27 14:27:15     50s]   opt_signoff_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default=ESO, indices={}
[04/27 14:27:15     50s]                         # Specifies the prefix to be assigned to the new instances inserted.
[04/27 14:27:15     50s]   opt_signoff_preserve_filler(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # To enable preserve and restore of fillers
[04/27 14:27:15     50s]   opt_signoff_read_eco_opt_db(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Path of directory where ECO Timing DB files must be loaded from.
[04/27 14:27:15     50s]   opt_signoff_read_irdrop_db(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Path of directory where command debug_irdrop generated IR drop DB files are
[04/27 14:27:15     50s]                         # kept
[04/27 14:27:15     50s]   opt_signoff_resize_inst(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # enable/disable resizing transform
[04/27 14:27:15     50s]   opt_signoff_retime(root)
[04/27 14:27:15     50s]                         # enum {none aocv path_slew_propagation aocv_path_slew_propagation}, read/write,
[04/27 14:27:15     50s]                         # default=none, indices={}
[04/27 14:27:15     50s]                         # To enable PBA-based timing report and optimization for of all optimizers.
[04/27 14:27:15     50s]   opt_signoff_routing_congestion_aware(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Check routing congestion before adding buffers
[04/27 14:27:15     50s]   opt_signoff_select_drv_net_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # list of nets to be optimized during DRV fixing
[04/27 14:27:15     50s]   opt_signoff_select_drv_pin_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # list of pins to be optimized during DRV fixing
[04/27 14:27:15     50s]   opt_signoff_select_hold_endpoints(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # select end points for hold fixing
[04/27 14:27:15     50s]   opt_signoff_select_setup_endpoints(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # select end points for setup fixing
[04/27 14:27:15     50s]   opt_signoff_set_hold_endpoints_margin(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # specify end point specific margin for hold fixing
[04/27 14:27:15     50s]   opt_signoff_set_setup_endpoints_margin(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # specify end point specific margin for setup fixing
[04/27 14:27:15     50s]   opt_signoff_setup_recovery(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Forces Setup fixing to perform Setup timing recovery by using Vth swapping
[04/27 14:27:15     50s]                         # only. Useful feature to recover timing degradation after large ECO change
[04/27 14:27:15     50s]                         # during Power optimization.
[04/27 14:27:15     50s]   opt_signoff_setup_target_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # Specifies a target slack value in nanoseconds for setup timing optimize
[04/27 14:27:15     50s]   opt_signoff_setup_xtalk_delta_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.3, indices={}
[04/27 14:27:15     50s]                         # Crosstalk delta delay threshold for selecting nets in setup timing views when
[04/27 14:27:15     50s]                         # running Xtalk fixing.
[04/27 14:27:15     50s]   opt_signoff_setup_xtalk_slack_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1000.0, indices={}
[04/27 14:27:15     50s]                         # Slack threshold for selecting nets in setup timing views when running Xtalk
[04/27 14:27:15     50s]                         # fixing.
[04/27 14:27:15     50s]   opt_signoff_skip_drv_net_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # list of nets to be excluded during DRV fixing
[04/27 14:27:15     50s]   opt_signoff_swap_inst(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables/disables VT swap resizing. Setup/leakage optimizers do not honor this
[04/27 14:27:15     50s]                         # option and always perform VT-swapping.
[04/27 14:27:15     50s]   opt_signoff_verbose(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether the command should output log file reporting with verbosity
[04/27 14:27:15     50s]                         # or not.
[04/27 14:27:15     50s]   opt_signoff_write_eco_opt_db(root)
[04/27 14:27:15     50s]                         # string, read/write, default=ecoTimingDB, indices={}
[04/27 14:27:15     50s]                         # Path of directory where ECO Timing DB files are saved.
[04/27 14:27:15     50s]   opt_skew(root)        # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables triggering the skew_clock command from within opt_design
[04/27 14:27:15     50s]   opt_skew_ccopt(root)  # enum {none standard extreme}, read/write, default=standard, indices={}
[04/27 14:27:15     50s]                         # Effort for useful skew optimization within ccopt_design
[04/27 14:27:15     50s]   opt_skew_delay_pre_cts(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # delaying mode in pre_cts
[04/27 14:27:15     50s]   opt_skew_macro_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # skew hard blocks
[04/27 14:27:15     50s]   opt_skew_max_allowed_delay(root)
