[04/27 14:27:15     50s]   rc_corners(root)      # rc_corner*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the rc corners in the design.
[04/27 14:27:15     50s]   read_db_directory(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the directory of current loaded DB.
[04/27 14:27:15     50s]   read_db_file_check(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # By default, read_db will check all files inside the saved DB directory are
[04/27 14:27:15     50s]                         # unchanged. If any files have been edited, renamed or deleted, then an error
[04/27 14:27:15     50s]                         # will occur unless this value is set to false.
[04/27 14:27:15     50s]   read_db_stop_at_design_in_memory(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # By default, tool will error and stop if call read_db more than once in the same
[04/27 14:27:15     50s]                         # Innovus session unless this value is set to false.
[04/27 14:27:15     50s]   read_db_tool_name(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Indicates the tool name of the tool that created the restored db on the disk
[04/27 14:27:15     50s]                         # database
[04/27 14:27:15     50s]   read_db_version(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Indicates the version of the tool that generates an on disk database
[04/27 14:27:15     50s]   read_def_check_mask_shifts(root)
[04/27 14:27:15     50s]                         # enum {off on bypass}, read/write, default=off, indices={}
[04/27 14:27:15     50s]                         # If on/bypass, will check for conflicts between DEF COMPONENT MASKSHIFT and
[04/27 14:27:15     50s]                         # MACRO MASKSHIFT values with the LEF FIXEDMASK and LAYERMASKSHIFT values in the
[04/27 14:27:15     50s]                         # technology and MACRO sections, error out if on and error without out if bypass
[04/27 14:27:15     50s]   read_physical_check_colored_shape(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specify how to check and ignore colored shapes on colorless layers during
[04/27 14:27:15     50s]                         # reading lef or def data. If true, error out if a colored shape is on a
[04/27 14:27:15     50s]                         # colorless layer; if false, give error message and ignored the color.
[04/27 14:27:15     50s]   read_physical_check_mask_shifts(root)
[04/27 14:27:15     50s]                         # enum {off on bypass}, read/write, default=off, indices={}
[04/27 14:27:15     50s]                         # If on/bypass, will check for conflicts between LEF FIXEDMASK and LAYERMASKSHIFT
[04/27 14:27:15     50s]                         # values in the technology section and MACRO section when reading in any LEF
[04/27 14:27:15     50s]                         # files, error out if on and error without out if bypass
[04/27 14:27:15     50s]   read_physical_extend_cell_obs_shapes_under_trim(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # A list of routing layer. LEF OBS shapes on each <layer> that are overlapped
[04/27 14:27:15     50s]                         # partially by a shape on TRIMMETAL layer that trims the routing layer, will be
[04/27 14:27:15     50s]                         # extended in the preferred routing direction to be fully covered by the trim
[04/27 14:27:15     50s]                         # shape. This is a workaround for some advanced node libraries to avoid trim/OBS
[04/27 14:27:15     50s]                         # short violations.
[04/27 14:27:15     50s]   read_physical_extend_polygon_cell_shapes(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # A list of {{<layer> <value>} ...} pairs. LEF PIN/OBS shapes on each <layer>
[04/27 14:27:15     50s]                         # that are polygons (not simple rects), will be extended with OBS SPACING 0 rects
[04/27 14:27:15     50s]                         # by <value> (in microns) in the preferred routing direction. This is a
[04/27 14:27:15     50s]                         # workaround for some advanced node libraries to avoid spacing violations during
[04/27 14:27:15     50s]                         # routing.
[04/27 14:27:15     50s]   read_physical_merge_multi_port_to_single_port(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, multiple ports in a LEF PIN will be merged into single port.
[04/27 14:27:15     50s]   read_physical_must_join_all_ports(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If false, the LEF_MUSTJOINALLPORTS property on a LEF PIN auto-creates MUSTJOIN
[04/27 14:27:15     50s]                         # pins for each PORT. If true, the MUSTJOIN pins are not created, but the router
[04/27 14:27:15     50s]                         # must connect to every port with a signal wire or signal via that physically
[04/27 14:27:15     50s]                         # overlaps all the ports.
[04/27 14:27:15     50s]   read_write_lef_check_uncolored_shapes(root)
[04/27 14:27:15     50s]                         # enum {on off pin_only}, read/write, default=off, indices={}
[04/27 14:27:15     50s]                         # Specifies whether to check for uncolored LEF PIN and OBS shapes on multi-mask
[04/27 14:27:15     50s]                         # routing layers when reading or writing LEF files. If the check is on, LEF read
[04/27 14:27:15     50s]                         # or write commands will error out if there are any uncolored routing layer
[04/27 14:27:15     50s]                         # shapes (cut layers are not checked). If set to pin_only, only check LEF PIN
[04/27 14:27:15     50s]                         # shapes and ignore LEF OBS shapes.
[04/27 14:27:15     50s]   reorder_scan_add_scan_port_prefix(root)
