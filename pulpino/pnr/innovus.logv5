[04/27 14:27:15     50s]                         # edges at common pin
[04/27 14:27:15     50s]   timing_cppr_propagate_thru_latches(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, the cppr of a timing path crossing a latch (or latches) is
[04/27 14:27:15     50s]                         # calculated using the common pin of its origin flop and the capture device at
[04/27 14:27:15     50s]                         # the end of the path. Otherwise the usual segment-based cppr calculation is
[04/27 14:27:15     50s]                         # performed. This cppr setting is considered only when the latch thru analysis
[04/27 14:27:15     50s]                         # mode is enabled.
[04/27 14:27:15     50s]   timing_cppr_remove_clock_to_data_pessimism(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
