[04/27 14:27:15     50s]                         # When set to true, calculates constants on the outputs of sequential elements
[04/27 14:27:15     50s]   timing_case_analysis_propagation(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Overrides sequential and ICG propagation behaviors.
[04/27 14:27:15     50s]   timing_check_timing_report_all_checks(root)
