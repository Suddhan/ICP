[04/27 14:27:15     50s]                         # paths
[04/27 14:27:15     50s]   timing_cppr_self_loop_mode(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # When set to true in case of self-loop paths, computes CPPR adjustment by taking
[04/27 14:27:15     50s]                         # the difference between early and late clock arrival time of the common point
[04/27 14:27:15     50s]   timing_cppr_skip_clock_reconvergence(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
