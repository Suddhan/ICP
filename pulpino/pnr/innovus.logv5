[04/27 14:27:15     50s]   place_global_cpg_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]   place_global_enable_distributed_place(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # enable distributed placement platform
[04/27 14:27:15     50s]   place_global_ignore_scan(root)
[04/27 14:27:15     50s]                         # enum {true 1 false 0 auto}, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # ignore scan net during placement
[04/27 14:27:15     50s]   place_global_ignore_spare(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # discard spare cell connections during global placement
[04/27 14:27:15     50s]   place_global_max_density(root)
