[04/27 14:27:15     50s]                         # A transition is defined as a glitch when the time difference between two
[04/27 14:27:15     50s]                         # sequential toggles are less than half of the rise transition time + fall
[04/27 14:27:15     50s]                         # transition time in the vector-based static power calculation.
[04/27 14:27:15     50s]   power_handle_tristate(root)
