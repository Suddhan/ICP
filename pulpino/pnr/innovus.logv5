[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # signal pins as PG pins
[04/27 14:27:15     50s]   route_special_split_long_via(root)
[04/27 14:27:15     50s]                         # string, read/write, default=0 0 -1 -1, indices={}
[04/27 14:27:15     50s]                         # Split vias longer than <threshold> into smaller vias with specified <step> and
[04/27 14:27:15     50s]                         # bottom/left end <offset> and vertical/horizontal <height>
[04/27 14:27:15     50s]   route_special_target_number(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # number of target to connect
[04/27 14:27:15     50s]   route_special_target_search_distance(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # target search distance
[04/27 14:27:15     50s]   route_special_time_limit(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.0, indices={}
[04/27 14:27:15     50s]                         # time limit (in seconds) that the router is allowed in routing each port
[04/27 14:27:15     50s]   route_special_via_connect_to_shape(root)
[04/27 14:27:15     50s]                         # enum* {padring ring stripe blockring blockpin coverpin noshape blockwire
[04/27 14:27:15     50s]                         # corewire followpin iowire}, read/write, default=padring ring stripe blockring
[04/27 14:27:15     50s]                         # blockpin coverpin noshape blockwire corewire followpin iowire, indices={}
[04/27 14:27:15     50s]                         # Make via connection to specified shapes
[04/27 14:27:15     50s]   route_special_via_through_to_closest_ring(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # A via should connect only to closest ring layer when multiple rings overlap
[04/27 14:27:15     50s]   route_special_welltap_as_endcap(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # route_special treat Welltap macro as Endcap macro
[04/27 14:27:15     50s]   route_trial_max_print_ignored_pad_nets(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Number of nets to be printed connecting a pad term to a fterm without geometry
[04/27 14:27:15     50s]   route_types(root)     # route_type*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # All the route_types from create_route_type command.
[04/27 14:27:15     50s]   rows(root)            # row*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .rows]
[04/27 14:27:15     50s]   run_abstract_abstract_blockage_cut_around_pin(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # For std cell, we do not want cover obs on pin. So:
[04/27 14:27:15     50s]                         # If -input_cell_type {std}, setting the value to all metal and via layer name
[04/27 14:27:15     50s]                         # list.
[04/27 14:27:15     50s]                         # If -input_cell_type {block} or -input_cell_type {io}, setting the value to all
[04/27 14:27:15     50s]                         # via layer name list.
[04/27 14:27:15     50s]   run_abstract_antenna_connectivity(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the layers for which connectivity is to be extracted. The syntax is
[04/27 14:27:15     50s]                         # {<layer1> <connect_layer> <layer2>}.
[04/27 14:27:15     50s]   run_abstract_antenna_diffusion_geometry(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies diffusion layer, followed by expression to remove gate channel area
[04/27 14:27:15     50s]                         # from diffusion region.
[04/27 14:27:15     50s]   run_abstract_antenna_gate_geometry(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies poly layer that forms a gate, and then the layer expression to derive
[04/27 14:27:15     50s]                         # the gate area. This option also triggers the creation of antenna models.
[04/27 14:27:15     50s]   run_abstract_blockage_detailed_layers(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the layers for which a detailed blockage model is to be created. The
[04/27 14:27:15     50s]                         # detailed blockage model generates blockages only where there are real shapes in
[04/27 14:27:15     50s]                         # the cell on the layer. This only applies to IO cells and block cells, it does
[04/27 14:27:15     50s]                         # not apply to standard cells.
[04/27 14:27:15     50s]   run_abstract_boundary_layers(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # By default this list is empty, and the prBoundary is used. The prBoundary comes
[04/27 14:27:15     50s]                         # from an explicit GDS layer that is used to compute the LEF SIZE (and OVERLAP
[04/27 14:27:15     50s]                         # OBS shapes for rectilinear boundaries). If there is no explicit GDS prBoundary
[04/27 14:27:15     50s]                         # layer, the boundary can be computed from the bounding box of geometries on this
[04/27 14:27:15     50s]                         # list of layers. Note, this option is almost never correct for core standard
[04/27 14:27:15     50s]                         # cells.
[04/27 14:27:15     50s]   run_abstract_cell_symmetry(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies a property value for cell symmetry. The valid values for the property
[04/27 14:27:15     50s]                         # symmetry include: {R0 | X | Y | R90 | X Y | X R90 | Y R90 | X Y R90}. Default
[04/27 14:27:15     50s]                         # {X Y}
[04/27 14:27:15     50s]   run_abstract_export_lef_version(root)
[04/27 14:27:15     50s]                         # enum {5.3 5.4 5.5 5.6 5.7 5.8}, read/write, default=5.7, indices={}
[04/27 14:27:15     50s]                         # Version of LEF to export. The default version is the same  as the version of
[04/27 14:27:15     50s]                         # technology LEF file being imported.
[04/27 14:27:15     50s]   run_abstract_extract_layers_power(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the layers through which the extractor extracts  each power net. This
[04/27 14:27:15     50s]                         # is used to reduce the search space if abstract is taking too much run time for
[04/27 14:27:15     50s]                         # each cell. Usually not applicable to standard cells. For blocks it is common to
[04/27 14:27:15     50s]                         # only extract the power nets on the top one or two metal layers.
[04/27 14:27:15     50s]   run_abstract_extract_layers_signal(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the layers through which the extractor extracts  each net. This is
[04/27 14:27:15     50s]                         # used to reduce the search space if abstract is taking too much run time for
[04/27 14:27:15     50s]                         # each cell. Usually not applicable to standard cells.
[04/27 14:27:15     50s]   run_abstract_extract_pin_layers_power(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Determines which of the shapes found by the extractor should be turned into
[04/27 14:27:15     50s]                         # pins. This argument is valid only if the associated layer, geometry
[04/27 14:27:15     50s]                         # specification and connectivity have been provided in the technology LEF.
[04/27 14:27:15     50s]                         # Usually not applicable to standard cells.
[04/27 14:27:15     50s]   run_abstract_extract_pin_layers_signal(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Determines which of the shapes found by the extractor  should be turned into
[04/27 14:27:15     50s]                         # pins. This argument is valid only if the associated layer, geometry
[04/27 14:27:15     50s]                         # specification and connectivity have been provided in the technology LEF.
[04/27 14:27:15     50s]                         # Usually not applicable to standard cells.
[04/27 14:27:15     50s]   run_abstract_input_cell_type(root)
[04/27 14:27:15     50s]                         # enum {std io block}, read/write, default=std, indices={}
[04/27 14:27:15     50s]                         # Choose the cell type being translated with abstract. The tool adjusts its
[04/27 14:27:15     50s]                         # settings based on this selection. Optional.
[04/27 14:27:15     50s]   run_abstract_input_lef_tech_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Input technology LEF file. This is used to get all the layer names, their types
[04/27 14:27:15     50s]                         # (routing, cut, etc.) and the layer order for extracting connectivity. Required.
[04/27 14:27:15     50s]   run_abstract_input_stream_layer_map_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify the file that maps GDS layer number / data type to LEF layer names in
[04/27 14:27:15     50s]                         # the Virtuoso format. Required.
[04/27 14:27:15     50s]                         # For example, the gds file is not colorized, you could use the common virtuoso
[04/27 14:27:15     50s]                         # format gds layer map to stream gds file.
[04/27 14:27:15     50s]                         # #layer name #purpose name #stream layer #stream data type
[04/27 14:27:15     50s]                         # V0 drawing 35 0
[04/27 14:27:15     50s]                         # V0 drawing 35 235
[04/27 14:27:15     50s]                         # V0 drawing 35 236
[04/27 14:27:15     50s]                         # M1 drawing 15 0
[04/27 14:27:15     50s]                         # M1 drawing 15 235
[04/27 14:27:15     50s]                         # M1 drawing 15 236
[04/27 14:27:15     50s]                         # M1 drawing 15 239
[04/27 14:27:15     50s]                         # For example, the gds file is colorized, you could specify the mask color in gds
[04/27 14:27:15     50s]                         # layer map to stream gds file.
[04/27 14:27:15     50s]                         # #layer name #purpose name #stream layer #stream data type #photo mask color
[04/27 14:27:15     50s]                         # #color state
[04/27 14:27:15     50s]                         # V0 drawing 35 0
[04/27 14:27:15     50s]                         # V0 drawing 35 235 mask1Color unlocked
[04/27 14:27:15     50s]                         # V0 drawing 35 236 mask2Color unlocked
[04/27 14:27:15     50s]                         # M1 drawing 15 0
[04/27 14:27:15     50s]                         # M1 drawing 15 235 mask1Color unlocked
[04/27 14:27:15     50s]                         # M1 drawing 15 236 mask2Color unlocked
[04/27 14:27:15     50s]                         # M1 drawing 15 239 mask3Color unlocked
[04/27 14:27:15     50s]   run_abstract_keep_output_files(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Do not clean up temporary files/libraries that are created in the process after
[04/27 14:27:15     50s]                         # command finishes.
[04/27 14:27:15     50s]   run_abstract_pins_analog_names(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Identifies analog  pin names based on label strings in the Abstract to set the
[04/27 14:27:15     50s]                         # LEF "USE ANALOG" property. Enter a list of possible names for the analog pins.
[04/27 14:27:15     50s]                         # This can be a list of regular expressions, each separated by a space.
[04/27 14:27:15     50s]   run_abstract_pins_clock_names(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Identifies clock pin names based on label strings in the Abstract to set the
[04/27 14:27:15     50s]                         # LEF "USE CLOCK" property. Enter a list of possible names for the clock pins.
[04/27 14:27:15     50s]                         # This can be a list of regular expressions, each separated by a space.
[04/27 14:27:15     50s]   run_abstract_pins_ground_names(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Identifies ground pins based on label strings in the Abstract to set the LEF
[04/27 14:27:15     50s]                         # "USE GROUND" property. Enter a list of possible names for the ground pins. This
[04/27 14:27:15     50s]                         # can be a list of regular expressions, each separated by a space.
[04/27 14:27:15     50s]   run_abstract_pins_output_names(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Identifies output pins based on label strings in the GDS to set the LEF
[04/27 14:27:15     50s]                         # direction to OUTPUT. Enter a list of regular expressions separated by spaces.
[04/27 14:27:15     50s]   run_abstract_pins_power_names(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Identifies power pin names based on label strings in the Abstract to set the
[04/27 14:27:15     50s]                         # LEF "USE POWER" property. Enter a list of possible names for the power pins.
[04/27 14:27:15     50s]                         # This can be a list of regular expressions, each separated by a space.
[04/27 14:27:15     50s]   run_abstract_pins_text_pin_map(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Maps text labels to pins on nets. Specify the layer purpose pairs based on
[04/27 14:27:15     50s]                         # which you want the abstract generator to search for geometry of any given
[04/27 14:27:15     50s]                         # layer-purpose pair with a text label.
[04/27 14:27:15     50s]   run_abstract_pre_abstract_script(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # a skill file that will be executed in abstract before the auto-generated script
[04/27 14:27:15     50s]                         # is executed. Optional.
[04/27 14:27:15     50s]   run_abstract_selected_cells(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Select cells to create abstract for using regex style expressions. Optional.
[04/27 14:27:15     50s]   run_abstract_site_name(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Site to be used for macros. This site will be added to all the cells.
[04/27 14:27:15     50s]   run_abstract_verbose(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Verbose mode with extra print.
[04/27 14:27:15     50s]   script_search_path(root)
[04/27 14:27:15     50s]                         # string, read/write, default=., indices={}
[04/27 14:27:15     50s]                         # The variable provides a set of directories for the software to search for files
[04/27 14:27:15     50s]                         # that sourced using the Tcl 'source' command.  The software will search in each
[04/27 14:27:15     50s]                         # search path directory for the specified file. 
[04/27 14:27:15     50s]   selected(root)        # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The list of currently selected objects. It can be set to a list of objects as
[04/27 14:27:15     50s]                         # long as they are selectable.
[04/27 14:27:15     50s]   set_db_verbose(root)  # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies additional messages are issued describing what attribute is being set
[04/27 14:27:15     50s]                         # on what object.
[04/27 14:27:15     50s]   setup_views(root)     # analysis_view*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the setup analysis views in the design.
[04/27 14:27:15     50s]   si_accumulated_small_aggressor_factor(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the multiplication factor that controls the effect of the cap mode
[04/27 14:27:15     50s]                         # accumulated small attacker.
[04/27 14:27:15     50s]   si_accumulated_small_aggressor_mode(root)
[04/27 14:27:15     50s]                         # enum {cap current zero_mean}, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the multiplication factor that controls the effect of the cap mode
[04/27 14:27:15     50s]                         # accumulated small attacker.
[04/27 14:27:15     50s]   si_accumulated_small_aggressor_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=10.01, indices={}
[04/27 14:27:15     50s]                         # Specifies whether to use the current-matching based method for accumulated
[04/27 14:27:15     50s]                         # small attackers.
[04/27 14:27:15     50s]   si_aggressor_alignment(root)
[04/27 14:27:15     50s]                         # enum {path path_overlap timing_aware_edge}, read/write, default=path,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specifies the attacker alignment.
[04/27 14:27:15     50s]   si_clock_synchronicity(root)
[04/27 14:27:15     50s]                         # enum {asynchronous synchronous}, read/write, default=synchronous,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specifies the value above which the clock delta delay should be calculated.
[04/27 14:27:15     50s]   si_delay_clock_delta_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies the value above which the clock delta delay should be calculated.
[04/27 14:27:15     50s]   si_delay_delta_annotation_mode(root)
[04/27 14:27:15     50s]                         # enum {lumpedOnNet arc}, read/write, default=arc, indices={}
[04/27 14:27:15     50s]                         # Calculates the delay for each arc (cell arc and net arc) in a path.
[04/27 14:27:15     50s]   si_delay_delta_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # delta delay analysis threshold
[04/27 14:27:15     50s]   si_delay_enable_double_clocking_check(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables double clocking check in AAE.
[04/27 14:27:15     50s]   si_delay_enable_logical_correlation(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables the AAE-SI logical correlation.
[04/27 14:27:15     50s]   si_delay_enable_report(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables SI delay reports.
[04/27 14:27:15     50s]   si_delay_separate_on_data(root)
[04/27 14:27:15     50s]                         # string, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Separates the delta delay on data (delta delay is always separated for clock).
[04/27 14:27:15     50s]   si_enable_bus_attacker_correlation(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   si_enable_drv_with_delta_slew(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables SI slews reporting.
[04/27 14:27:15     50s]   si_enable_glitch_overshoot_undershoot(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables overshoot/undershoot analysis and reporting.
[04/27 14:27:15     50s]   si_enable_glitch_propagation(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables glitch propagation and driver weakening through single stage cells.
[04/27 14:27:15     50s]   si_enable_glitch_propagation_spice_deck(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables glitch propagation in spice deck.
[04/27 14:27:15     50s]   si_enable_logical_correlation_for_bus(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   si_enable_two_stage_driver_weakening(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]   si_enable_user_defined_bus_merging(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables bus merging feature - if a net is in two groups, then the groups are
[04/27 14:27:15     50s]                         # merged
[04/27 14:27:15     50s]   si_enable_virtual_attacker_constituent_report(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   si_glitch_analysis_type(root)
[04/27 14:27:15     50s]                         # enum {source full_propagation}, read/write, default=source, indices={}
[04/27 14:27:15     50s]   si_glitch_constrained_input_threshold_failure_point(root)
[04/27 14:27:15     50s]                         # enum {input both}, read/write, default=input, indices={}
[04/27 14:27:15     50s]   si_glitch_enable_dynamic_receiver_peak_limits(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   si_glitch_enable_report(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enables AAE SI glitch analysis.
[04/27 14:27:15     50s]   si_glitch_input_full_propagation_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.75, indices={}
[04/27 14:27:15     50s]   si_glitch_input_full_propagation_voltage_high_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.75, indices={}
[04/27 14:27:15     50s]   si_glitch_input_full_propagation_voltage_low_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.75, indices={}
[04/27 14:27:15     50s]   si_glitch_input_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.4, indices={}
[04/27 14:27:15     50s]                         # Specifies the input glitch failure threshold value during AAE analysis.
[04/27 14:27:15     50s]   si_glitch_input_voltage_high_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.4, indices={}
[04/27 14:27:15     50s]                         # Specifies the input glitch vh failure threshold value during AAE analysis.
[04/27 14:27:15     50s]   si_glitch_input_voltage_low_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.4, indices={}
[04/27 14:27:15     50s]                         # Specifies the input glitch vl failure threshold value during AAE analysis.
[04/27 14:27:15     50s]   si_glitch_receiver_clock_peak_limit(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.05, indices={}
[04/27 14:27:15     50s]                         # Defines the glitch check limit for clock inputs in receiver peak mode. This
[04/27 14:27:15     50s]                         # parameter is specified as a ratio of vdd.
[04/27 14:27:15     50s]   si_glitch_receiver_latch_peak_limit(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.1, indices={}
[04/27 14:27:15     50s]                         # Defines the glitch check limit for latch inputs in receiver peak mode. This
[04/27 14:27:15     50s]                         # parameter is specified as a ratio of vdd.
[04/27 14:27:15     50s]   si_glitch_receiver_peak_limit(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.15, indices={}
[04/27 14:27:15     50s]                         # Defines the receiver peak/glitch peak limit at all nodes. The value specified
[04/27 14:27:15     50s]                         # for this parameter is a ratio of vdd.
[04/27 14:27:15     50s]   si_individual_aggressor_clock_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.015, indices={}
[04/27 14:27:15     50s]                         # Sets the glitch tolerance for individual attacker nets on victim clock nets.
[04/27 14:27:15     50s]   si_individual_aggressor_simulation_filter(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Enables electrical filtering based on attackers' simulated glitch peaks.
[04/27 14:27:15     50s]   si_individual_aggressor_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.015, indices={}
[04/27 14:27:15     50s]                         # AAE virtual attacker threshold
[04/27 14:27:15     50s]   si_max_bus_attacker_count(root)
[04/27 14:27:15     50s]                         # int, read/write, default=999, indices={}
[04/27 14:27:15     50s]                         # Max number of bus attacker per victim net
[04/27 14:27:15     50s]   si_max_virtual_attacker_constituents(root)
[04/27 14:27:15     50s]                         # int, read/write, default=5, indices={}
[04/27 14:27:15     50s]   si_nonlinear_aggressor_slew(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Uses a non-linear attacker. If set to false , it uses a linear attacker.
[04/27 14:27:15     50s]   si_num_iteration(root)
[04/27 14:27:15     50s]                         # int, read/write, default=2, indices={}
[04/27 14:27:15     50s]                         # Specifies the maximum number of timing window iterations that should be
[04/27 14:27:15     50s]                         # performed during SI delay analysis.
[04/27 14:27:15     50s]   si_pessimistic_mode(root)
[04/27 14:27:15     50s]                         # enum {advanced advanced_node reduced_pessimism increased_pessimism
[04/27 14:27:15     50s]                         # high_pessimism}, read/write, default=advanced, indices={}
[04/27 14:27:15     50s]                         # Pessimistic Mode Settings
[04/27 14:27:15     50s]   si_reselection(root)  # enum {delta_delay slack xcap_ratio}, read/write, default=slack,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Specifies the SI reselection criteria during timing window iterations.
[04/27 14:27:15     50s]   si_reselection_delay_threshold(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1e-11, indices={}
[04/27 14:27:15     50s]                         # Allows to change the delay reselection criteria.
[04/27 14:27:15     50s]   si_reselection_hold_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1e-12, indices={}
[04/27 14:27:15     50s]                         # Specifies the slack reselection threshold for hold.
[04/27 14:27:15     50s]   si_reselection_setup_slack(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1e-12, indices={}
[04/27 14:27:15     50s]                         # Specifies the slack reselection threshold for setup.
[04/27 14:27:15     50s]   si_secondary_attacker_decoupling_factor(root)
[04/27 14:27:15     50s]                         # double, read/write, default=1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies decoupling factor for secondary aggressors.
[04/27 14:27:15     50s]   si_skip_noise_model_check(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies a list of pins for which noise model check will not take place.
[04/27 14:27:15     50s]   si_skip_timing_window(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the list of nets for which timing window is to be skipped.
[04/27 14:27:15     50s]   si_switch_probability(root)
[04/27 14:27:15     50s]                         # double, read/write, default=0.3, indices={}
[04/27 14:27:15     50s]                         # Sets the attacker switching probability.
[04/27 14:27:15     50s]   si_unconstrained_net_use_infinite_timing_window(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Specifies that unconstrained nets will have an infinite timing window.
[04/27 14:27:15     50s]   si_use_infinite_timing_window(root)
[04/27 14:27:15     50s]                         # enum {true false}, read/write, default=false, indices={}
[04/27 14:27:15     50s]   sites(root)           # site*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # All the sites defined in LEF or OA.
[04/27 14:27:15     50s]   skew_groups(root)     # skew_group*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # list of skew_group
[04/27 14:27:15     50s]   soft_stack_size_limit(root)
[04/27 14:27:15     50s]                         # string, read/write, default=8, indices={}
[04/27 14:27:15     50s]                         # Soft stacksize limit in mbytes. When the tool is launched, auto-enlarge the
[04/27 14:27:15     50s]                         # soft stacksize limit to 0.2%RAM. If 0.2%RAM is larger than hard limit, set to
[04/27 14:27:15     50s]                         # the hard limit.
[04/27 14:27:15     50s]   source_continue_on_error(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Enable/Disable 'source' to continue the script on TCL_ERROR. If true, the
[04/27 14:27:15     50s]                         # source command will ignore Tcl errors, and continue processing the script
[04/27 14:27:15     50s]                         # files. If false, a Tcl error will halt the script.
[04/27 14:27:15     50s]   source_echo_filename(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # This will display 'sourcing a.tcl' after a 'source $file' command in the log
[04/27 14:27:15     50s]                         # file. This is useful to see the actual filename rather than the Tcl variable
[04/27 14:27:15     50s]                         # name. It is ignored if source_verbose is true, since that will also write out
[04/27 14:27:15     50s]                         # the filename anyway. Type 'man log_file' for more details.
[04/27 14:27:15     50s]   source_verbose(root)  # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Writes out each command inside the source script to the log and cmd files. Type
[04/27 14:27:15     50s]                         # 'man log_file' for more details.
[04/27 14:27:15     50s]   source_verbose_line_length_limit(root)
[04/27 14:27:15     50s]                         # int, read/write, default=-1, indices={}
[04/27 14:27:15     50s]                         # Limits the command printed to stdout and the .log file to the specified number
[04/27 14:27:15     50s]                         # of characters for verbose script source. This is normally only needed if you
[04/27 14:27:15     50s]                         # log commands "post Tcl expansion" when long Tcl lists may occur in the command
[04/27 14:27:15     50s]                         # args. Type 'man log_file' for more details.
[04/27 14:27:15     50s]   stack_via_rules(root)
[04/27 14:27:15     50s]                         # stack_via_rule*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # The stack_via_rules available in this design from the LEF or
[04/27 14:27:15     50s]                         # create_stack_via_rules.
[04/27 14:27:15     50s]   tcl_error_info(root)  # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If user set the value to true, application can print following error info if
[04/27 14:27:15     50s]                         # meet a tcl error.
[04/27 14:27:15     50s]   tcl_partial_cmd_argument_matching(root)
[04/27 14:27:15     50s]                         # enum {quiet warn error}, read/write, default=quiet, indices={}
[04/27 14:27:15     50s]                         # Use this switch to control command argument partial matching as well as enum
[04/27 14:27:15     50s]                         # value partial matching. When it's turned on, argument '-opt' will match
[04/27 14:27:15     50s]                         # '-option' if no other argument name begins with -opt. Default is 'quiet', which
[04/27 14:27:15     50s]                         # means to silently allow partial-matching when there's no ambiguity. 'warn'
[04/27 14:27:15     50s]                         # means allow partial-matching with a warning message. 'error' means to disable
[04/27 14:27:15     50s]                         # partial-matching, and error out.
[04/27 14:27:15     50s]   tcl_return_display_length_limit(root)
[04/27 14:27:15     50s]                         # int, read/write, default=10000, indices={}
[04/27 14:27:15     50s]                         # Limits the number of characters displayed to stdout and the .log file. The Tcl
[04/27 14:27:15     50s]                         # return value itself is not affected--only the display is truncated. A value of
[04/27 14:27:15     50s]                         # -1 indicates that there is no display limit. This is useful to limit the output
[04/27 14:27:15     50s]                         # to the display of any command that can return long lists of objects or values.
[04/27 14:27:15     50s]   tech_db_units(root)   # int, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Database units per micron from LEF or OA techfile, unless
[04/27 14:27:15     50s]                         # init_min_dbu_per_micron is larger.
[04/27 14:27:15     50s]   tech_finfet_grid_direction(root)
[04/27 14:27:15     50s]                         # enum {vertical horizontal}, read/write, default=vertical, indices={}
[04/27 14:27:15     50s]                         # An enum value indicating the direction of the finfet grid from the LEF FINFET
[04/27 14:27:15     50s]                         # statement or OA.
[04/27 14:27:15     50s]   tech_finfet_grid_offset(root)
[04/27 14:27:15     50s]                         # coord, read/write, default=no_value, indices={}
[04/27 14:27:15     50s]                         # The finfet grid offset from 0 in microns from the LEF FINFET statement or OA.
[04/27 14:27:15     50s]   tech_finfet_grid_pitch(root)
[04/27 14:27:15     50s]                         # coord, read/write, default=no_value, indices={}
[04/27 14:27:15     50s]                         # Returns a single floating point number indicating the pitch of the FINFET grid
[04/27 14:27:15     50s]                         # as described in LEF.
[04/27 14:27:15     50s]   tech_inst_mask_shift_layers(root)
[04/27 14:27:15     50s]                         # layer*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Ordered list of layer pointers to layers that allow instance mask shifting.
[04/27 14:27:15     50s]                         # This is the list of layers that will show up in the DEF COMPONENTMASK statement
[04/27 14:27:15     50s]                         # for layers that can have mask values shifted in standard cells.
[04/27 14:27:15     50s]   tech_mfg_grid(root)   # coord, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Manufacturing grid from LEF or OA techfile.  Note, this is the default value
[04/27 14:27:15     50s]                         # for each layer, but it can be overridden for specific layers. In some
[04/27 14:27:15     50s]                         # technologies the mfg_grid for higher metal layers is coarser than for the lower
[04/27 14:27:15     50s]                         # layers.
[04/27 14:27:15     50s]   texts(root)           # text, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the text objects in the current_design.
