[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # clock power driven
[04/27 14:27:15     50s]   place_global_clock_power_driven_effort(root)
[04/27 14:27:15     50s]                         # enum {low standard high}, read/write, default=low,
[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # -place_global_clock_power_driven_effort mode
[04/27 14:27:15     50s]   place_global_cong_effort(root)
