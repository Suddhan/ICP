[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # route_trim_pull_back_distance_from_boundary {<layer>:<value> ...}
[04/27 14:27:15     50s]   route_design_trunk_with_cluster_target_size(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1, indices={}
[04/27 14:27:15     50s]                         # global control of trunk routing pattern for nets with TRUNK pattern attribute.
[04/27 14:27:15     50s]                         # 0: nets with TRUNK pattern will be routed as Steiner tree; 1: default, nets
[04/27 14:27:15     50s]                         # will be routed as traditional trunk pattern, i.e., each pin directly connects
[04/27 14:27:15     50s]                         # to SNET trunk separately; >1: define a proximate max cluster size (in number of
[04/27 14:27:15     50s]                         # pins), and nets will be routed as fishbone style, i.e., several pins in a
[04/27 14:27:15     50s]                         # column are clustered together, and then connects to SNET trunk.
