[04/27 14:27:15     50s]                         # outside of die and snap it by default. If this option is set to false, don't
[04/27 14:27:15     50s]                         # cut and snap it.
[04/27 14:27:15     50s]   floorplan_default_blockage_name_prefix(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
