[04/27 14:27:15     50s]                         # in task compression mode '0'
[04/27 14:27:15     50s]   timing_disable_pulse_width_same_edge_si_cppr_mode(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
