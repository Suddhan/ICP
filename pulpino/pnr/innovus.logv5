[04/27 14:27:15     50s]                         # indices={}
[04/27 14:27:15     50s]                         # Timing arc attributes effect on timing analysis
[04/27 14:27:15     50s]   timing_analysis_clock_source_paths(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # clkSrcPath
[04/27 14:27:15     50s]   timing_analysis_cppr(root)
