[04/27 14:27:15     50s]                         # units, splitting value to each side, starting on left. e.g. value of 1 shrinks
[04/27 14:27:15     50s]                         # by 1 site on left, 2 shrinks by 1 site on each side, value of 3 shrinks 2 sites
[04/27 14:27:15     50s]                         # on left and 1 on right.
[04/27 14:27:15     50s]   place_detail_max_shifter_column_depth(root)
