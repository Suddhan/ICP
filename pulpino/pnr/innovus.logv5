[04/27 14:27:15     50s]                         # reference path doesn't affect signal path
[04/27 14:27:15     50s]   timing_cap_unit(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # If set, this value is passed to set_library_unit -cap to set the capacitance
[04/27 14:27:15     50s]                         # units used in timing library and .sdc files and timing reports. Legal values
[04/27 14:27:15     50s]                         # are 1pf and 1ff.
[04/27 14:27:15     50s]   timing_case_analysis_for_icg_propagation(root)
