[04/27 14:27:15     50s]   timing_defer_mmmc_obj_updates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # You can set the timing_defer_mmmc_object_updates global to true, so that the
[04/27 14:27:15     50s]                         # software allows a sequence of MMMC updates to be accumulated before new data is
[04/27 14:27:15     50s]                         # loaded and analyzed
[04/27 14:27:15     50s]   timing_derate_aocv_dynamic_delays(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # This global controls whether or not  AOCV derating factors are applied to the
[04/27 14:27:15     50s]                         # dynamic, SI-induced delay component or not. With a value of '1',  the AOCV
[04/27 14:27:15     50s]                         # derating factor will be applied to both the static and dynamic components of
[04/27 14:27:15     50s]                         # the delay arc. When set to '0', the AOCV derate will only apply to the static
[04/27 14:27:15     50s]                         # component of the delay.
[04/27 14:27:15     50s]   timing_derate_aocv_reference_point(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1, indices={}
[04/27 14:27:15     50s]                         # Allows specification of reference point for AOCV factors
[04/27 14:27:15     50s]   timing_derate_dynamic_compatibility(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # This global controls how the set_timing_derate factors that are not specified
[04/27 14:27:15     50s]                         # using either -static or -dynamic options are applied to the delay.  When this
[04/27 14:27:15     50s]                         # global is set to '1' the behavior will be compatible with previous releases. In
[04/27 14:27:15     50s]                         # this mode,  the static and dynamic components will be summed before  applying
[04/27 14:27:15     50s]                         # derating.  With a setting of '0',  the static and dynamic components will be
[04/27 14:27:15     50s]                         # derated separately and then combined. A setting of '0' is equivalent to using
[04/27 14:27:15     50s]                         # separate derate assertions with  the -dynamic and -static options explicitly
[04/27 14:27:15     50s]                         # specified.
[04/27 14:27:15     50s]   timing_derate_incremental_adjust_additive_mode(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # By default or with a setting of 'false', successive application of incremental
[04/27 14:27:15     50s]                         # derating using the -increment option (or deprecated -incremental_adjust option)
[04/27 14:27:15     50s]                         # will overwrite any existing derate value with the new value. When this global
[04/27 14:27:15     50s]                         # is set to 'true', successive application of the derates will be accumulated
[04/27 14:27:15     50s]                         # into a final derate value.
[04/27 14:27:15     50s]   timing_derate_negative_delay_backward_compatibility(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
