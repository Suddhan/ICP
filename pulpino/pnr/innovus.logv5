[04/27 14:27:15     50s]   check_ac_limit_check_thermal_aware_em(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # check thermal aware EM
[04/27 14:27:15     50s]   check_ac_limit_current_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specify current file to provide currents for cell/instance's pin.
[04/27 14:27:15     50s]   check_ac_limit_current_scale_factor(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Scale Signal EM current, syntax: -current_scale_factor { [rms <rms_value>]
