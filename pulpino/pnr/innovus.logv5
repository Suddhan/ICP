[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The inst grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin is
[04/27 14:27:15     50s]                         # lower left corner of core box (e.g. the core rows). The x_pitch is default
[04/27 14:27:15     50s]                         # technical site's width and separates the vertical grid lines. The y_pitch is
[04/27 14:27:15     50s]                         # default technical site¡¯s height and separates the horizontal grid lines.
[04/27 14:27:15     50s]   floorplan_keep_rows_when_moving_power_domain(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # specify whether to keep all existing rows in disjoint power domain when moving,
[04/27 14:27:15     50s]                         # resizing or reshaping a power domain on GUI or by command. 
[04/27 14:27:15     50s]   floorplan_layer_track_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[04/27 14:27:15     50s]                         # The layer_track grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin
[04/27 14:27:15     50s]                         # is lower left corner of die box  (the design .boundary). The x_pitch is the
[04/27 14:27:15     50s]                         # pitch of lowest vertical metal layer and separates the vertical grid lines. The
[04/27 14:27:15     50s]                         # y_pitch is the pitch of lowest horizontal metal layer and separates the
[04/27 14:27:15     50s]                         # horizontal grid lines.
[04/27 14:27:15     50s]   floorplan_manufacturing_grid(root)
[04/27 14:27:15     50s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
