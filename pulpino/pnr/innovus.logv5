[04/27 14:27:15     50s]                         # input port to the internal register.
[04/27 14:27:15     50s]   budget_snap_negative_only(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Considers the only negative slack paths when used with
