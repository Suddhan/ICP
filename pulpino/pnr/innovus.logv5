[04/27 14:27:15     50s]   timing_disable_clock_period_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables timing model clock period checks during timing
[04/27 14:27:15     50s]                         # analysis
[04/27 14:27:15     50s]   timing_disable_constant_propagation_for_sequential_cells(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables constant prop. across sequential cells if
[04/27 14:27:15     50s]                         # sequential_prop global is false
[04/27 14:27:15     50s]   timing_disable_drv_report_on_constant_nets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Disables DRV checks for nets having disabled constant propagation:
[04/27 14:27:15     50s]   timing_disable_floating_bus_check(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables propagation of minimum delay through three state
[04/27 14:27:15     50s]                         # disable timing arcs and maximum delay through three state enable arcs. These
[04/27 14:27:15     50s]                         # checks are only valid during floating bus conditions
[04/27 14:27:15     50s]   timing_disable_genclk_combinational_blocking(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Disables blocking of generated clocks with '-combinational' option which are
[04/27 14:27:15     50s]                         # downstream of another generated clock
[04/27 14:27:15     50s]   timing_disable_inferred_clock_gating_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # When set to true, disables clock gating checks that are inferred on
[04/27 14:27:15     50s]                         # combinational elements in the clock path. Explicit clock gating checks that are
[04/27 14:27:15     50s]                         # described in the timing library are not affected by this global variable
[04/27 14:27:15     50s]   timing_disable_inout_output_side_timing_checks(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # When set to false, timing checks on both the input and output sides of the
[04/27 14:27:15     50s]                         # bidirectional pin are analyzed
[04/27 14:27:15     50s]   timing_disable_internal_inout_cell_paths(root)
