[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .place_blockages]
[04/27 14:27:15     50s]   place_cell_edge_spacing(root)
[04/27 14:27:15     50s]                         # string, read-only, default={}, indices={}
