[04/27 14:27:15     50s]                         # during legalizing
[04/27 14:27:15     50s]   place_detail_wire_length_opt_effort(root)
[04/27 14:27:15     50s]                         # enum {none medium high}, read/write, default=medium, indices={}
[04/27 14:27:15     50s]                         # selects which wire-length optimization effort level to use during refinePlace
[04/27 14:27:15     50s]   place_global_activity_power_driven(root)
