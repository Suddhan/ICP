[04/27 14:27:15     50s]                         # When set to false, enables internal bidirectional feedback paths that are
[04/27 14:27:15     50s]                         # completely contained in one instance
[04/27 14:27:15     50s]   timing_disable_internal_inout_net_arcs(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
