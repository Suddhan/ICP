[04/27 14:27:15     50s]   place_global_allow_3d_stack(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]   place_global_auto_blockage_in_channel(root)
[04/27 14:27:15     50s]                         # enum {none soft partial}, read/write, default=partial, indices={}
