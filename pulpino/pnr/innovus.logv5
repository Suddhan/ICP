[04/27 14:27:15     50s]                         # partition boundary facing block on layers with OBS, in the places where channel
[04/27 14:27:15     50s]                         # width between partition boundary and block is less than the value specified.
[04/27 14:27:15     50s]                         # For channel width below specified value: OBS area on the layer, channel length
[04/27 14:27:15     50s]                         # and channel width considered to allow suitable number of pins on boundary
[04/27 14:27:15     50s]                         # facing this channel.
[04/27 14:27:15     50s]   assign_pins_strict_abutment(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # To relax abutment violations, for placing multi partition pin of a net and non
[04/27 14:27:15     50s]                         # neighbor pins of a net on abutted edges
[04/27 14:27:15     50s]   attributes(root)      # attribute*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db obj_types .attributes]
[04/27 14:27:15     50s]   auto_file_dir(root)   # string, read/write, default=./, indices={}
