[04/27 14:27:15     50s]   gui_rects(root)       # gui_rect*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the gui_rect objects in the design.
[04/27 14:27:15     50s]   gui_shapes(root)      # gui_rect* gui_line*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the gui_shape objects in the design.
[04/27 14:27:15     50s]   gui_texts(root)       # gui_text*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut to all the gui_text objects in the design.
[04/27 14:27:15     50s]   gui_verbose(root)     # enum {all db none}, read/write, default=db, indices={}
[04/27 14:27:15     50s]                         # Controls which GUI actions are logged. The choices are:
[04/27 14:27:15     50s]                         # all: all GUI actions;
[04/27 14:27:15     50s]                         # db: GUI actions that affect the DB like gui_select, set_layer_preference, but
[04/27 14:27:15     50s]                         # not display-only actions like gui_zoom, gui_pan;
[04/27 14:27:15     50s]                         # none: no gui_* commands are logged, so the .log and .cmd file are incomplete
[04/27 14:27:15     50s]   hdl_unconnected_marking_done(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether the undriven signals have been connected based on the value
[04/27 14:27:15     50s]                         # of the 'hdl_unconnected_value' attribute.
[04/27 14:27:15     50s]   hinsts(root)          # hinst*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .hinsts]
[04/27 14:27:15     50s]   hnets(root)           # hnet*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .hnets]
[04/27 14:27:15     50s]   hpins(root)           # hpin*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .hpins]
[04/27 14:27:15     50s]   hports(root)          # hport*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db hinsts .hports]
[04/27 14:27:15     50s]   hybrid_hier_anchor_buffer(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the name of anchor buffer cell for master-clone flow
[04/27 14:27:15     50s]   hybrid_hier_feedthru_after_drv_opt(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies to enable or disable feed-though insertion after drv optimization
[04/27 14:27:15     50s]   hybrid_hier_feedthru_disable(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies to enable or disable feed-though insertion
[04/27 14:27:15     50s]   hybrid_hier_feedthru_exclude_nets_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the file name with net names. Feedthrough insertion will not be tried
[04/27 14:27:15     50s]                         # on these nets
[04/27 14:27:15     50s]   hybrid_hier_feedthru_include_nets_file(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the file name with net names. Feedthrough insertion if any will be
[04/27 14:27:15     50s]                         # done only on these nets
[04/27 14:27:15     50s]   hybrid_hier_feedthru_plugin_tcl(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the file name having customized feed-through flow from user
[04/27 14:27:15     50s]   hybrid_hier_hold_uncertainty_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies hold uncertainty for cts
[04/27 14:27:15     50s]   hybrid_hier_hold_uncertainty_post_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies hold uncertainty for postcts
[04/27 14:27:15     50s]   hybrid_hier_hold_uncertainty_pre_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies hold uncertainty for prects
[04/27 14:27:15     50s]   hybrid_hier_legalize_io(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies to legalize illegal IOs and place unplaced IOs
[04/27 14:27:15     50s]   hybrid_hier_net_derates(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies to enable or disble net derating
[04/27 14:27:15     50s]   hybrid_hier_no_inst_in_top(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies design has no instance in top
[04/27 14:27:15     50s]   hybrid_hier_out_dir(root)
[04/27 14:27:15     50s]                         # string, read/write, default=., indices={}
[04/27 14:27:15     50s]                         # Specifies directory name for feedthru, budget and pin assignment reports
[04/27 14:27:15     50s]   hybrid_hier_partition_place_halo(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies placement halo in microns to be applied around all partition in
[04/27 14:27:15     50s]                         # design. Default: "pinDepth + 2*minSpacing" of rouing layer M4
[04/27 14:27:15     50s]   hybrid_hier_partition_route_halo(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies routing halo in microns to be applied around all partition in design.
[04/27 14:27:15     50s]                         # Default: "pinDepth + 2*minSpacing" of rouing layer M4
[04/27 14:27:15     50s]   hybrid_hier_pin_assign_plugin_tcl(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the file name having customized pin-assignment flow from user
[04/27 14:27:15     50s]   hybrid_hier_pin_assign_timing_aware_priority(root)
[04/27 14:27:15     50s]                         # enum {tns wns}, read/write, default=wns, indices={}
[04/27 14:27:15     50s]                         # Specifies timing aware priority of pin assignment.
[04/27 14:27:15     50s]   hybrid_hier_setup_uncertainty_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies setup uncertainty for cts
[04/27 14:27:15     50s]   hybrid_hier_setup_uncertainty_post_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies setup uncertainty for postcts
[04/27 14:27:15     50s]   hybrid_hier_setup_uncertainty_pre_cts(root)
[04/27 14:27:15     50s]                         # double, read/write, default=-1.0, indices={}
[04/27 14:27:15     50s]                         # Specifies setup uncertainty for prects
[04/27 14:27:15     50s]   hybrid_hier_timing_budget_plugin_tcl(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Specifies the file name having customized time-budgeting flow from user
[04/27 14:27:15     50s]   ignore_max_via_stack_rule(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, the MaxVIASTACK rule in tlef file is ignored.
[04/27 14:27:15     50s]   ilm_filter_internal_path(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # filterInternalPath
[04/27 14:27:15     50s]   ilm_keep_async(root)  # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Keep paths from asynchronous input ports
[04/27 14:27:15     50s]   ilm_keep_flatten(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Instruct Innovus to keep in flattened state
[04/27 14:27:15     50s]   ilm_keep_high_fanout_ports(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Keep high fanout input port paths
[04/27 14:27:15     50s]   ilm_keep_inst_in_sdc(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Keep instances which have constraints on it
[04/27 14:27:15     50s]   ilm_keep_loopback(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Keep loop back paths
[04/27 14:27:15     50s]   ilm_max_num_insts(root)
[04/27 14:27:15     50s]                         # int, read/write, default=1000, indices={}
[04/27 14:27:15     50s]                         # Specify the maximum number of instances
[04/27 14:27:15     50s]   ilm_max_num_registers(root)
[04/27 14:27:15     50s]                         # int, read/write, default=40, indices={}
[04/27 14:27:15     50s]                         # Specify the maximum number of registers
[04/27 14:27:15     50s]   ilm_slack_driven(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # slackDriven
[04/27 14:27:15     50s]   init_check_netlist(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # After reading in the netlist, will do the same checks as check_design -netlist
[04/27 14:27:15     50s]   init_check_output_pin_constant(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # Stops the Verilog reader if any output (or inout) signal pins have any 1'b0 or
[04/27 14:27:15     50s]                         # 1'b1 constants that would cause shorts to power/ground.
[04/27 14:27:15     50s]   init_delete_floating_hnets(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If true, an hnet (Verilog wire statement) that has nothing connected to it, is
[04/27 14:27:15     50s]                         # deleted from the netlist. The default value is false in Innovus to allow for
[04/27 14:27:15     50s]                         # netlist repair, but true in Tempus to delete non-timed nets and reduce memory.
[04/27 14:27:15     50s]   init_design_netlist_type(root)
[04/27 14:27:15     50s]                         # string, read/write, default=Verilog, indices={}
[04/27 14:27:15     50s]                         # Specifies the source of the design netlist. You can specify either "Verilog" or
[04/27 14:27:15     50s]                         # "OA".
[04/27 14:27:15     50s]   init_design_uniquify(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Specifies whether the top is uniquified. When set to 1 (true) the design will
[04/27 14:27:15     50s]                         # be uniquified during the read and flatten process. Optimization is not allowed
[04/27 14:27:15     50s]                         # on a non-unique design. For use in a master/clone partitioning flow, the value
[04/27 14:27:15     50s]                         # should be 0 (false). Default = 0 (false).
[04/27 14:27:15     50s]   init_ground_nets(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of global Ground nets.
[04/27 14:27:15     50s]   init_ignore_pg_pin_polarity_check(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of leaf cell pin names to ignore power/ground pin polarity check. By
[04/27 14:27:15     50s]                         # default connect_global_net and CPF check for matching polarity between the net
[04/27 14:27:15     50s]                         # and pin.
[04/27 14:27:15     50s]   init_keep_empty_modules(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # By default, usage of an empty Verilog module that has no matching library cell
[04/27 14:27:15     50s]                         # name becomes an empty hinst.  If this value is false, a dummy library cell is
[04/27 14:27:15     50s]                         # created, and usage of it becomes an inst.  You should then use other commands
[04/27 14:27:15     50s]                         # to 'fix' the dummy library cell before proceeding in the flow.
[04/27 14:27:15     50s]   init_lef_files(root)  # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of LEF files to be read. Mutually exclusive with init_oa_ref_lib.
[04/27 14:27:15     50s]   init_min_dbu_per_micron(root)
[04/27 14:27:15     50s]                         # int, read/write, default=0, indices={}
[04/27 14:27:15     50s]                         # Minimum DBU per micron
[04/27 14:27:15     50s]   init_mmmc_files(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # Path to MMMC View Definition file.
[04/27 14:27:15     50s]   init_no_new_assigns(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Turns on an assign-free flow. By default, applications like optimization can
[04/27 14:27:15     50s]                         # add Verilog assigns to remove unnecessary buffers and reduce power. If you have
[04/27 14:27:15     50s]                         # external tools that do not support Verilog assigns, you can set this value to
[04/27 14:27:15     50s]                         # true to prevent applications from adding any new assign statements to the
[04/27 14:27:15     50s]                         # Verilog netlist. If there are existing assigns in the Verilog netlist you can
[04/27 14:27:15     50s]                         # remove them with the delete_assigns command.
[04/27 14:27:15     50s]   init_oa_abstract_views(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of OpenAccess view names to be processed as abstracts (LEF MACRO
[04/27 14:27:15     50s]                         # equivalent). The read_netlist command uses init_oa_abstract_views list for
[04/27 14:27:15     50s]                         # on-demand loading of missing cells. Used by the read_physical and read_netlist
[04/27 14:27:15     50s]                         # commands.
[04/27 14:27:15     50s]   init_oa_default_rule(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The default rule to be used in OpenAccess. Typically used to specify a metal
[04/27 14:27:15     50s]                         # stack LEFDefaultRouteSpec type constraint group to read from the technology
[04/27 14:27:15     50s]                         # library if the library contains multiple metal stacks. Used by the
[04/27 14:27:15     50s]                         # read_physical command.
[04/27 14:27:15     50s]   init_oa_design_cell(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # OpenAccess design cell name that was read. Set by the read_netlist
[04/27 14:27:15     50s]                         # -oa_cell_view command.
[04/27 14:27:15     50s]   init_oa_design_lib(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # OpenAccess design lib name that was read. Set by the read_netlist -oa_cell_view
[04/27 14:27:15     50s]                         # command.
[04/27 14:27:15     50s]   init_oa_design_view(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # OpenAccess design view name that was read. Set by the read_netlist
[04/27 14:27:15     50s]                         # -oa_cell_view command.
[04/27 14:27:15     50s]   init_oa_foundry_rule(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The foundry constraint group to be used in OpenAccess. Typically used to
[04/27 14:27:15     50s]                         # specify a foundry_innovus_XXXX  constraint group to read from the technology
[04/27 14:27:15     50s]                         # library if the library contains multiple foundry_innovus_XXXX constraint
[04/27 14:27:15     50s]                         # groups. Used by the read_physical command.
[04/27 14:27:15     50s]   init_oa_layout_views(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of OpenAccess view names to be processed for cell layout viewing (GDSII
[04/27 14:27:15     50s]                         # equivalent). Also used in the case where a Verilog netlist is read and views
[04/27 14:27:15     50s]                         # from the init_oa_layout_views list are used in the Quick Abstract Inference
[04/27 14:27:15     50s]                         # flow to derive abstract information from layout views for cells that were not
[04/27 14:27:15     50s]                         # processed from the libraries in the read_physical -oa_ref_libs list. The
[04/27 14:27:15     50s]                         # read_netlist command uses init_oa_layout_view list for on-demand loading of
[04/27 14:27:15     50s]                         # missing cells. Used by the read_physical and read_netlist commands.
[04/27 14:27:15     50s]   init_oa_ref_libs(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of OpenAccess reference libraries. The first library in the list indicates
[04/27 14:27:15     50s]                         # the library that  was used for technology information unless read_physical
[04/27 14:27:15     50s]                         # -oa_tech_lib is specified. All cells from the specified libraries are read. It
[04/27 14:27:15     50s]                         # is important to include the standard cell library in the list to make sure that
[04/27 14:27:15     50s]                         # cells that are not in the current netlist are read and available for
[04/27 14:27:15     50s]                         # optimization. The init_oa_abstract_views and init_oa_layout_views lists specify
[04/27 14:27:15     50s]                         # which views of the cells are read. Set by the read_physical -oa_ref_libs
[04/27 14:27:15     50s]                         # command.
[04/27 14:27:15     50s]   init_oa_search_libs(root)
[04/27 14:27:15     50s]                         # string, read/write, default=*, indices={}
[04/27 14:27:15     50s]                         # List of OpenAccess reference libraries to be searched when cells are used in
[04/27 14:27:15     50s]                         # the Verilog netlist that are not found in the list of cells read from the
[04/27 14:27:15     50s]                         # libraries specified by read_physical -oa_ref_libs command, by default all
[04/27 14:27:15     50s]                         # libraries in the cds.lib are searched. The init_oa_abstract_views and
[04/27 14:27:15     50s]                         # init_oa_layout_views lists are used to indicate which view names are looked for
[04/27 14:27:15     50s]                         # during the search. Applies only when read_netlist command is used to process a
[04/27 14:27:15     50s]                         # Verilog netlist specify the connectivity to be read. Set by the read_physical
[04/27 14:27:15     50s]                         # -oa_search_libs command and used by the read_netlist command.
[04/27 14:27:15     50s]   init_oa_special_rule(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The special rule to be used in OpenAccess to define the via search order for
[04/27 14:27:15     50s]                         # power routing. Typically used to specify a metal stack LEFSpecialRouteRouteSpec
[04/27 14:27:15     50s]                         # type constraint group to read from the technology library if the library
[04/27 14:27:15     50s]                         # contains multiple metal stacks. Used by the read_physical command.
[04/27 14:27:15     50s]   init_oa_tech_lib(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # OpenAccess library to use as source of technology information. If not
[04/27 14:27:15     50s]                         # specified, the first library in the read_physical -oa_ref_libs list will be
[04/27 14:27:15     50s]                         # used. Applies only when read_netlist is used to process a Verilog netlist. Set
[04/27 14:27:15     50s]                         # by the read_physical -oa_tech_lib command.
[04/27 14:27:15     50s]   init_power_intent_files(root)
[04/27 14:27:15     50s]                         # string*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Power intent files(s) read by last 'read_power_intent' command.
[04/27 14:27:15     50s]   init_power_nets(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # List of global Power nets.
[04/27 14:27:15     50s]   init_read_netlist_allow_port_mismatch(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # If false, a Verilog instance with ports that do not match the Verilog module or
[04/27 14:27:15     50s]                         # library cell definition will cause an error and exit.  If true, an error
[04/27 14:27:15     50s]                         # message occurs, but the extra ports are added to the module or library cell
[04/27 14:27:15     50s]                         # definition to allow the inconsistent netlist to be read in and debugged
[04/27 14:27:15     50s]                         # further. The default is true for Innovus to allow repair of 'dirty netlists',
[04/27 14:27:15     50s]                         # but false for Tempus that normally does not tolerate 'dirty netlists'.
[04/27 14:27:15     50s]   init_read_netlist_allow_undefined_cells(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # If false, a Verilog reference to an undefined cell (e.g. a Verilog module name
[04/27 14:27:15     50s]                         # that has no matching library cell and no Verilog module definition) causes an
[04/27 14:27:15     50s]                         # error and an exit after parsing the netlist. If true, an empty Verilog module
[04/27 14:27:15     50s]                         # is created with a warning.  The default value is true in Innovus to allow
[04/27 14:27:15     50s]                         # repair of 'dirty netlists' while it is false in Tempus to stop on 'dirty
[04/27 14:27:15     50s]                         # netlists'. An empty module will become an hinst or inst depending on the value
[04/27 14:27:15     50s]                         # of init_keep_empty_modules.
[04/27 14:27:15     50s]   init_read_netlist_files(root)
[04/27 14:27:15     50s]                         # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # A list of Verilog files read in during initialization. read_netlist will set
[04/27 14:27:15     50s]                         # this root attribute to the list of input files given to it. The original input
[04/27 14:27:15     50s]                         # file names are retained thru the flow for reference, and used by write_do_lec
[04/27 14:27:15     50s]                         # for the default golden netlist comparison file names.
[04/27 14:27:15     50s]   init_sync_relative_path(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=false, indices={}
[04/27 14:27:15     50s]                         # Synchronize Relative paths
[04/27 14:27:15     50s]   init_timing_enabled(root)
[04/27 14:27:15     50s]                         # bool, read-only, default=true, indices={}
[04/27 14:27:15     50s]                         # If read_physical is issued before read_mmmc or read_libs in RC and Tempus, an
[04/27 14:27:15     50s]                         # error will be issued. In EDI, doing this will result in init_timing_enabled
[04/27 14:27:15     50s]                         # being set to false by the tool.  EDI is now in physical only mode, and any
[04/27 14:27:15     50s]                         # attempt to set timing data will result in an error.  By default,
[04/27 14:27:15     50s]                         # init_timing_enabled is set to true.
[04/27 14:27:15     50s]   insts(root)           # inst*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # insts of current design
[04/27 14:27:15     50s]   io_constraints(root)  # io_constraint*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Short-cut for [get_db current_design .io_constraints]
[04/27 14:27:15     50s]   is_ilm_flattened(root)
[04/27 14:27:15     50s]                         # bool, read-only, default=false, indices={}
[04/27 14:27:15     50s]                         # Is true if you have ILMs, and the flatten_ilm command has flattened them so the
[04/27 14:27:15     50s]                         # internal ILM insts are visible.  unflatten_ilm will set it back to false.
[04/27 14:27:15     50s]   is_ilm_read(root)     # bool, read-only, default=false, indices={}
[04/27 14:27:15     50s]                         # Is true if you have read in any ILMs with read_ilm. It is not affected by
[04/27 14:27:15     50s]                         # flatten_ilm/unflatten_ilm.
[04/27 14:27:15     50s]   layer_name_no_abbreviation(root)
[04/27 14:27:15     50s]                         # bool, read/write, default=true, indices={}
[04/27 14:27:15     50s]                         # By default this value is true, and most command -layer <layer> options require
[04/27 14:27:15     50s]                         # a LEF/OA layer name, or a routing-layer index value (e.g. 1 for the first
[04/27 14:27:15     50s]                         # routing layer, 2 for the second, etc.) for input. If this global is false, then
[04/27 14:27:15     50s]                         # an older style abbreviation is also allowed (e.g. M1 for the first routing
[04/27 14:27:15     50s]                         # layer, M2 for the second routing layer, etc.).This layer abbreviation style is
[04/27 14:27:15     50s]                         # not recommended, and is only allowed for backward compatibility to migrate
[04/27 14:27:15     50s]                         # older scripts.  Eventually this global will be removed, so you should modify
[04/27 14:27:15     50s]                         # your scripts to use LEF/OA layer names, or routing-layer index values for
[04/27 14:27:15     50s]                         # -layer options to avoid problems in the future.
[04/27 14:27:15     50s]   layers(root)          # layer*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # All the layers defined in the LEF or OA techfile.
[04/27 14:27:15     50s]   lib_arcs(root)        # lib_arc*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # lib_arcs
[04/27 14:27:15     50s]   lib_cells(root)       # lib_cell*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # lib_cells
[04/27 14:27:15     50s]   lib_pins(root)        # lib_pin*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # lib_pins
[04/27 14:27:15     50s]   libraries(root)       # library*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the libraries in the design.
[04/27 14:27:15     50s]   library_sets(root)    # library_set*, read-only, default={}, indices={}
[04/27 14:27:15     50s]                         # Returns the information about the library sets in the design.
[04/27 14:27:15     50s]   log_file(root)        # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The log file name of the program. It can be changed in the session to direct
[04/27 14:27:15     50s]                         # log file output to a different file. Type 'man log_file' for more details.
[04/27 14:27:15     50s]   log_verbose_style(root)
[04/27 14:27:15     50s]                         # enum {debug echo echo_comments}, read/write, default=echo, indices={}
[04/27 14:27:15     50s]                         # When verbose logging is enabled (see source_verbose, flow_verbose, or
[04/27 14:27:15     50s]                         # set_proc_verbose), the logging style for each command is controllable.  It is
[04/27 14:27:15     50s]                         # sometimes helpful to include line numbers and comments for script debug and
[04/27 14:27:15     50s]                         # other times this is too much information.  You can switch between settings in
[04/27 14:27:15     50s]                         # the middle of a script. 'debug' will output the file name, line number,
[04/27 14:27:15     50s]                         # commands, comments, and empty lines. 'echo' will output only the commands and
[04/27 14:27:15     50s]                         # line number. 'echo_comments' will output commands, comments, empty lines, and
[04/27 14:27:15     50s]                         # line number.
[04/27 14:27:15     50s]   log_verbose_type(root)
[04/27 14:27:15     50s]                         # enum {pre post both}, read/write, default=pre, indices={}
[04/27 14:27:15     50s]                         # When verbose logging is enabled (see source_verbose, flow_verbose, or
[04/27 14:27:15     50s]                         # set_proc_verbose), the default logging of each commands is pre-Tcl expansion.
[04/27 14:27:15     50s]                         # In some cases it is helpful to see post-Tcl expansion, or even both pre-Tcl and
[04/27 14:27:15     50s]                         # post-Tcl expansion when doing detailed debugging. You can switch between
[04/27 14:27:15     50s]                         # settings in the middle of a script. Type 'man log_file' for more details.
[04/27 14:27:15     50s]   logv_file(root)       # string, read/write, default={}, indices={}
[04/27 14:27:15     50s]                         # The verbose log file name of the program. It can be changed in the session to
[04/27 14:27:15     50s]                         # direct logv file output to a different file. Type 'man log_file' for more
[04/27 14:27:15     50s]                         # details.
[04/27 14:27:15     50s]   machine_learning_app_deployment(root)
