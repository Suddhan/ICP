@file 71: # Set buffer cells that the clock tree synthesis can use
@file 72: # Explanation : The cells used in the clock tree needs to be balanced. Hence, we only use cells from the CLOCK library.
@file 73: #               The buffer cells in the clock library have are named on the format HS65_LL_CNBFX<value>. By setting it to `*CNBF*` we are guaranteed to have added all clock buffer cells.
@@file 74: set_db cts_buffer_cells {*CNBF*}
