add_tracks
gui_select -point {0.07000 0.04400}
create_tracks
set sram0 [lindex [get_db [get_db insts -if {.name == *sram_inst}] .name ] 0]
create_relative_floorplan -place $sram0 -ref_type core_boundary -horizontal_edge_separate {1 0 1} -vertical_edge_separate {0 0 0}
create_floorplan -site CORE -utilization 0.70 -margins 30 30 30 30
plan_design
gui_select -point {-836.46100 722.76900}
gui_select -point {-481.59100 1491.65400}
set_db [get_db insts -if {.name == *sram*}] .place_status fixed
create_place_halo -insts [get_db insts -if {.is_macro == true}] -halo_deltas {10 10 10 10}
create_place_halo -insts [get_db insts -if {.is_macro == true} .name] -halo_deltas {10 10 10 10}
create_place_halo -insts *sram* -halo_deltas {10 10 10 10}
set leftPads [get_db [get_db insts -if {.lib_cells == *IO65*}] -if {.orient == r270}]
gui_select -point {192.19800 -309.07300}
deselect_obj -all
select_obj $leftPads
space_selected -fix_side top -space 90
space_selected -fix_side top -space 26
space_selected -fix_side top -space 20
space_selected -fix_side top -space 10
gui_select -point {223.97900 509.66200}
exit
