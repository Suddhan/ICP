@file 194:
@file 195: ## Well taps
@@file 196: delete_inst -inst *WELLTAP* ;
**WARN: (IMPSYC-295):	Found no instance name matching wildcard "*WELLTAP*"
@file 196: # In case any well taps has been placed prior, delete these
@file 197: # Set well tap cell to be used
@@file 198: set_db add_well_taps_cell HS65_LH_FILLERNPWPFP4
@file 199:
@file 200: # Create well taps
@file 201: # Explanation : We need to add well taps, to bias the bulk of the transistors to the correct potential
@file 202: #               According to the documentation, the maximum distance a cell can have to a well tap is 30um.
@file 203: #               This means that if we space the well taps with 60um, all cells will be within the 30um range of a tap.
@@file 204: add_well_taps -cell_interval 60
