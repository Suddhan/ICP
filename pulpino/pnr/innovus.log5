                        # specify when to give up on irresolvable violations
  route_design_detail_stub_routing_in_first_layer(root)
                        # string, read/write, default=false, indices={}
                        # to use Minimum routing in the first routing layer defined in the LEF
  route_design_detail_use_multi_cut_via_effort(root)
                        # string, read/write, default=low, indices={}
                        # specify the effort to use multi-cut via during routing
  route_design_diode_insertion_for_clock_nets(root)
                        # bool, read/write, default=false, indices={}
                        # allow diode insertion on clock nets
  route_design_eco_ignore_existing_route(root)
                        # string, read/write, default={}, indices={}
                        # Ignore existing route in eco, mode: {all | signal}
  route_design_enable_route_rule_si_limit_length(root)
                        # string, read/write, default=false, indices={}
                        # use MAR wire length as NDR PRL requirement for metal spacing check
  route_design_enforce_route_rule_on_special_net_wire(root)
                        # string, read/write, default=false, indices={}
                        # enforce ndr rule on all special wire segments of specified nets
  route_design_extra_via_enclosure(root)
                        # double, read/write, default=0.0, indices={}
                        # specify an extra via enclosure to use when connecting to block pins and special
                        # net wires
  route_design_fix_clock_nets(root)
                        # bool, read/write, default=false, indices={}
                        # set clock nets routing status to fixed or routed
  route_design_high_freq_constraint_groups(root)
                        # string, read/write, default={}, indices={}
                        # only route specified constraint groups, legal values are {net match bus pair
                        # shield}, add "order" in front to control route order
  route_design_high_freq_match_report_file(root)
                        # string, read/write, default={}, indices={}
                        # specify match report file name
  route_design_high_freq_num_reserved_layers(root)
                        # int, read/write, default=1, indices={}
                        # number of layers reserved for standard cell pin access
  route_design_high_freq_remove_floating_shield(root)
                        # bool, read/write, default=false, indices={}
                        # remove floating shield segments for high frequency nets
  route_design_high_freq_search_repair(root)
                        # string, read/write, default=auto, indices={}
                        # run search and repair to remove violations, legal value is one of {auto false
                        # true only}
  route_design_high_freq_shield_trim_length(root)
                        # double, read/write, default=0.0, indices={}
                        # specify minimum length of shielding wire to be kept
  route_design_honor_exclusive_region(root)
                        # bool, read/write, default=true, indices={}
                        # honor exclusive region routing
  route_design_honor_power_domain(root)
                        # bool, read/write, default=false, indices={}
                        # honor power domain routing
  route_design_ignore_antenna_top_cell_pin(root)
                        # bool, read/write, default=true, indices={}
                        # ignore antenna check on block I/O pins
  route_design_ignore_follow_pin_shapes(root)
                        # bool, read/write, default=false, indices={}
                        # Ignore follow pin via shapes
  route_design_interposer_allow_diagonal_trunk(root)
                        # string, read/write, default={}, indices={}
                        # allow_diagonal_trunk
  route_design_interposer_interlayer_shielding_layers(root)
                        # string, read/write, default={}, indices={}
                        # interlayer shielding layers
  route_design_interposer_interlayer_shielding_nets(root)
                        # string, read/write, default={}, indices={}
                        # interlayer shielding nets
  route_design_interposer_interlayer_shielding_offsets(root)
                        # string, read/write, default={}, indices={}
                        # interlayer shielding offsets
  route_design_interposer_interlayer_shielding_widths(root)
                        # string, read/write, default={}, indices={}
                        # interlayer shielding widths
  route_design_interposer_same_layer_shielding_net(root)
                        # string, read/write, default={}, indices={}
                        # same_layer_shielding_net
  route_design_interposer_same_layer_shielding_width_spacing(root)
                        # string, read/write, default={}, indices={}
                        # same_layer_shielding_width_spacing
  route_design_interposer_trunk_routing_layers(root)
                        # string, read/write, default={}, indices={}
                        # trunk_routing_layers
  route_design_interposer_trunk_routing_width_spacing(root)
                        # string, read/write, default={}, indices={}
                        # trunk_routing_width_spacing
  route_design_number_fail_limit(root)
                        # int, read/write, default=0, indices={}
                        # set limit for number of fails
  route_design_number_thread(root)
                        # int, read/write, default=1, indices={}
                        # set the number of processors to be used in one workstation for multi-threading
  route_design_number_warning_limit(root)
                        # int, read/write, default=0, indices={}
                        # set limit for number of warnings
  route_design_process_node(root)
                        # string, read/write, default={}, indices={}
                        # Specify the process node
  route_design_rc_extraction_corner(root)
                        # string, read/write, default={}, indices={}
                        # specific which RC extraction corner to use in routing
  route_design_relaxed_route_rule_spacing_to_power_ground_nets(root)
                        # string, read/write, default=none, indices={}
                        # relax the spacing requirement from NDR spacing for the layers
  route_design_reserve_space_for_multi_cut(root)
                        # bool, read/write, default=false, indices={}
                        # Reserves space to insert multicut vias in postroute stage. This option has to
                        # be set before routing. After routing with this parameter specified, you can add
                        # double-cut vias or larger overhang vias by using the "route_design -via_opt"
                        # command. For examples, see route_design.
  route_design_reverse_direction(root)
                        # string, read/write, default={}, indices={}
