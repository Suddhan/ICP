                        # edges at common pin
  timing_cppr_propagate_thru_latches(root)
                        # bool, read/write, default=false, indices={}
                        # When set to true, the cppr of a timing path crossing a latch (or latches) is
                        # calculated using the common pin of its origin flop and the capture device at
                        # the end of the path. Otherwise the usual segment-based cppr calculation is
                        # performed. This cppr setting is considered only when the latch thru analysis
                        # mode is enabled.
  timing_cppr_remove_clock_to_data_pessimism(root)
                        # bool, read/write, default=false, indices={}
