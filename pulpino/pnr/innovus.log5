                        # top_lyr and bot_lyr could be either layer name or layer routing id
  route_design_route_clock_nets_first(root)
                        # bool, read/write, default=true, indices={}
                        # route clock nets first
  route_design_selected_net_only(root)
                        # bool, read/write, default=false, indices={}
                        # route selected net only
  route_design_shield_crosstie_offset(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the offset in terms of number of tracks for adding crossties. The
                        # default is 0 for all layers. The syntax is 'layer_name:numTrack1
                        # layer_name2:numTrack2... '.
  route_design_shield_report_skip_status(root)
                        # bool, read/write, default=false, indices={}
                        # generate report file on if a net is skipped for shielding
  route_design_shield_tap_cell_insertion(root)
                        # bool, read/write, default=false, indices={}
                        # insert tap cell for shielding
  route_design_shield_tap_cell_name(root)
                        # string, read/write, default={}, indices={}
                        # specify the tap cell names for shielding
  route_design_skip_analog(root)
                        # bool, read/write, default=false, indices={}
                        # skip routing nets or pins marked + USE ANALOG in the DEF file
  route_design_strict_honor_route_rule(root)
                        # string, read/write, default=false, indices={}
                        # Strictly enforce non-default rules
  route_design_stripe_layer_range(root)
                        # string, read/write, default={}, indices={}
                        # specify the target layer range of stripes for tie net connection
  route_design_third_party_data(root)
                        # bool, read/write, default=false, indices={}
                        # Allow third party data as input
  route_design_tieoff_to_shapes(root)
                        # string, read/write, default=auto, indices={}
                        # specify the target special wire shapes or target instance pin for tie net
                        # connection: [auto stripe ring powergroundpin]
  route_design_trim_pull_back_distance_from_boundary(root)
                        # string, read/write, default={},
                        # indices={}
                        # route_trim_pull_back_distance_from_boundary {<layer>:<value> ...}
  route_design_trunk_with_cluster_target_size(root)
                        # int, read/write, default=1, indices={}
                        # global control of trunk routing pattern for nets with TRUNK pattern attribute.
                        # 0: nets with TRUNK pattern will be routed as Steiner tree; 1: default, nets
                        # will be routed as traditional trunk pattern, i.e., each pin directly connects
                        # to SNET trunk separately; >1: define a proximate max cluster size (in number of
                        # pins), and nets will be routed as fishbone style, i.e., several pins in a
                        # column are clustered together, and then connects to SNET trunk.
  route_design_unconnected_ports(root)
                        # bool, read/write, default=false, indices={}
                        # Route unconnected ports
  route_design_use_auto_via(root)
                        # string, read/write, default=auto, indices={}
                        # allow to use internal generated vias
  route_design_via_weight(root)
                        # string, read/write, default={}, indices={}
                        # set weight for vias
  route_design_with_eco(root)
                        # bool, read/write, default=false, indices={}
                        # enable eco routing
  route_design_with_litho_driven(root)
                        # bool, read/write, default=false, indices={}
                        # enable the litho-driven routing
  route_design_with_si_driven(root)
                        # bool, read/write, default=false, indices={}
                        # enable si driven routing
  route_design_with_timing_driven(root)
                        # bool, read/write, default=false, indices={}
                        # enable timing driven routing
  route_design_with_trim_metal(root)
                        # string, read/write, default={}, indices={}
                        # set cut metal dgrid for short pin extension generated
  route_design_with_via_in_pin(root)
                        # string, read/write, default=false, indices={}
                        # enclose via in pin shape
  route_design_with_via_only_for_block_cell_pin(root)
                        # string, read/write, default=false, indices={}
                        # enclose via in pin shape for macro cell pins
  route_design_with_via_only_for_stdcell_pin(root)
                        # string, read/write, default=false, indices={}
                        # disable planar access to standard cell pins
  route_early_global_effort_level(root)
                        # enum {low medium standard}, read/write, default=standard, indices={}
                        # Specifies the congestion effort level. Default is "standard", where congestion
                        # is more accurate and runtime is larger. If set to "medium", runtime will be
                        # much smaller and congestion report will have less accuracy. Setting to "low",
                        # it will be faster than "medium" however less accurate.
  route_early_global_honor_partition_allow_feedthru(root)
                        # string, read/write, default={}, indices={}
                        # Honor partition fences with feedthrough for <list_of_ptn_cell_names>.
  route_early_global_honor_partition_fence(root)
                        # string, read/write, default={}, indices={}
                        # Honor partition fences for <list_of_ptn_cell_names>.
  route_early_global_honor_partition_pin(root)
                        # string, read/write, default={}, indices={}
                        # Honor partition fences and single-entry constraint for
                        # <list_of_ptn_cell_names>.
  route_early_global_honor_partition_pin_guide(root)
                        # bool, read/write, default=true, indices={}
                        # Honor partition pin guides. Default is true
  route_early_global_honor_power_domain(root)
                        # bool, read/write, default=false, indices={}
                        # consider MSV constraints while routing
  route_early_global_horizontal_supply_scale_factor(root)
                        # double, read/write, default=1.0, indices={}
                        # Horizontal supply scale factor
  route_early_global_num_tracks_per_clock_wire(root)
                        # int, read/write, default=0, indices={}
                        # Specify special number of tracks per clock wires.
  route_early_global_reverse_direction_regions(root)
                        # string, read/write, default={}, indices={}
                        # Reverse routing direction in the given region on the specified layer-range.
                        # Example: "(x1 y1 x2 y2) M1:M2 (x3 y3 x4 y4) M3:M4 ..."
  route_early_global_route_selected_net_only(root)
                        # bool, read/write, default=false, indices={}
                        # Only route the nets which are selected in the DB.
  route_early_global_secondary_pg(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies whether secondary PG pins needs to be routed or not
  route_early_global_secondary_pg_max_fanout(root)
                        # int, read/write, default=no_value, indices={}
                        # Specifies the max fanout limit for each secondary PG subnet
  route_early_global_stripe_layer_range(root)
                        # string, read/write, default={}, indices={}
                        # Route secondary PG pins to access to the PG stripes in the given layer range.
  route_early_global_vertical_supply_scale_factor(root)
                        # double, read/write, default=1.0, indices={}
                        # Vertical supply scale factor
  route_rules(root)     # route_rule*, read-only, default={}, indices={}
                        # All the route_rules. It is initialized from LEF NONDEFAULTRULES section or from
                        # OA equivalents.  It includes the reserved name "default" for the implicit LEF 
                        # default rule or the OA LEFDefaultRouteSpec.   It also includes design specific
                        # route_rules from create_route_rule or read in from DEF or an OA cellview.
  route_special_allow_non_preferred_direction_route(root)
                        # bool, read/write, default=false, indices={}
                        # allow wrong way route
  route_special_avoid_over_core_row_layer(root)
                        # string, read/write, default=max layer of standard cell pin, indices={}
                        # specify number of layers to avoid routing over core row area
  route_special_block_pin_connect_ring_pin_corners(root)
                        # bool, read/write, default=false, indices={}
                        # Extend the ring pins at the corners
  route_special_block_pin_route_with_pin_width(root)
                        # bool, read/write, default=false, indices={}
                        # Connect using pin width only
  route_special_connect_broken_core_pin(root)
                        # bool, read/write, default=false, indices={}
                        # Break followpin for standard cell pin or obs
  route_special_core_pin_ignore_obs(root)
                        # enum* {none placement_blockage overlap_obs block_halo}, read/write,
                        # default=none, indices={}
                        # ignore specified blockage when connecting follow pin
  route_special_core_pin_length(root)
                        # double, read/write, default=0.0, indices={}
                        # connect core pins of at least specified length
  route_special_core_pin_length_as_inst(root)
                        # bool, read/write, default=false, indices={}
                        # connect core pins if their lengths are the same as the instances
  route_special_core_pin_max_via_scale(root)
                        # string, read/write, default={}, indices={}
                        # Maximum via width and height at stripe crossover for standcell pins (%)
  route_special_core_pin_merge_limit(root)
                        # double, read/write, default=0.0, indices={}
                        # gaps smaller than this variable cause followpin rails to be joined
  route_special_core_pin_refer_to_follow_pin(root)
                        # bool, read/write, default=false, indices={}
                        # M2 followpin generation uses follow pin wire
  route_special_core_pin_reference_macro(root)
                        # string, read/write, default={}, indices={}
                        # use specified macro as reference for followpin creation
  route_special_core_pin_site_rail_width(root)
                        # string, read/write, default={}, indices={}
                        # follow pin width at layer for specified site
  route_special_core_pin_snap_to(root)
                        # enum* {m1_pin opt_routing_track grid half_grid}, read/write, default=m1_pin,
                        # indices={}
                        # snap M2 followpin referred to M1 pin to position
  route_special_core_pin_stop_route(root)
                        # enum {RowEnd CellPinEnd}, read/write, default=RowEnd, indices={}
  route_special_endcap_as_core(root)
                        # bool, read/write, default=false, indices={}
                        # route_special treat Endcap macro as Core macro
  route_special_extend_nearest_target(root)
                        # bool, read/write, default=false, indices={}
                        # extend nearest target so that it can be connected
  route_special_jog_threshold_ratio(root)
                        # double, read/write, default=10.0, indices={}
                        # distance ratio between a jogging target and a straight target
  route_special_layer_non_preferred_direction_cost(root)
                        # string, read/write, default={}, indices={}
                        # layer cost of non-preferred direction
  route_special_layer_preferred_direction_cost(root)
                        # string, read/write, default={}, indices={}
                        # layer cost of preferred direction
  route_special_pad_pin_min_via_size(root)
                        # double, read/write, default=20.0, indices={}
                        # Minimum via width percent between pad and ring.
  route_special_pad_pin_split(root)
                        # string, read/write, default={}, indices={}
                        # Split width and spacing for wide pad pins
  route_special_pad_ring_use_lef(root)
                        # bool, read/write, default=true, indices={}
                        # Keep user LEF input for pad rings
  route_special_pg_pin_as_signal(root)
                        # string, read/write, default={}, indices={}
                        # List of cell/pin information NOT extract from CPF
  route_special_secondary_pin_max_gap(root)
                        # double, read/write, default=0.0, indices={}
                        # gaps bigger than this variable cause level shifter rail to break for them
  route_special_secondary_pin_rail_width(root)
                        # double, read/write, default=0.0, indices={}
                        # width of followpin rail
  route_special_signal_pin_as_pg(root)
                        # bool, read/write, default=false, indices={}
                        # signal pins as PG pins
  route_special_split_long_via(root)
                        # string, read/write, default=0 0 -1 -1, indices={}
                        # Split vias longer than <threshold> into smaller vias with specified <step> and
                        # bottom/left end <offset> and vertical/horizontal <height>
  route_special_target_number(root)
                        # int, read/write, default=0, indices={}
                        # number of target to connect
  route_special_target_search_distance(root)
                        # double, read/write, default=0.0, indices={}
                        # target search distance
  route_special_time_limit(root)
                        # double, read/write, default=0.0, indices={}
                        # time limit (in seconds) that the router is allowed in routing each port
  route_special_via_connect_to_shape(root)
                        # enum* {padring ring stripe blockring blockpin coverpin noshape blockwire
                        # corewire followpin iowire}, read/write, default=padring ring stripe blockring
                        # blockpin coverpin noshape blockwire corewire followpin iowire, indices={}
                        # Make via connection to specified shapes
  route_special_via_through_to_closest_ring(root)
                        # bool, read/write, default=false, indices={}
                        # A via should connect only to closest ring layer when multiple rings overlap
  route_special_welltap_as_endcap(root)
                        # string, read/write, default={}, indices={}
                        # route_special treat Welltap macro as Endcap macro
  route_trial_max_print_ignored_pad_nets(root)
                        # int, read/write, default=0, indices={}
                        # Number of nets to be printed connecting a pad term to a fterm without geometry
  route_types(root)     # route_type*, read-only, default={}, indices={}
                        # All the route_types from create_route_type command.
  rows(root)            # row*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .rows]
  run_abstract_abstract_blockage_cut_around_pin(root)
                        # string, read/write, default={}, indices={}
                        # For std cell, we do not want cover obs on pin. So:
                        # If -input_cell_type {std}, setting the value to all metal and via layer name
                        # list.
                        # If -input_cell_type {block} or -input_cell_type {io}, setting the value to all
                        # via layer name list.
  run_abstract_antenna_connectivity(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers for which connectivity is to be extracted. The syntax is
                        # {<layer1> <connect_layer> <layer2>}.
  run_abstract_antenna_diffusion_geometry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies diffusion layer, followed by expression to remove gate channel area
                        # from diffusion region.
  run_abstract_antenna_gate_geometry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies poly layer that forms a gate, and then the layer expression to derive
                        # the gate area. This option also triggers the creation of antenna models.
  run_abstract_blockage_detailed_layers(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers for which a detailed blockage model is to be created. The
                        # detailed blockage model generates blockages only where there are real shapes in
                        # the cell on the layer. This only applies to IO cells and block cells, it does
                        # not apply to standard cells.
  run_abstract_boundary_layers(root)
                        # string, read/write, default={}, indices={}
                        # By default this list is empty, and the prBoundary is used. The prBoundary comes
                        # from an explicit GDS layer that is used to compute the LEF SIZE (and OVERLAP
                        # OBS shapes for rectilinear boundaries). If there is no explicit GDS prBoundary
                        # layer, the boundary can be computed from the bounding box of geometries on this
                        # list of layers. Note, this option is almost never correct for core standard
                        # cells.
  run_abstract_cell_symmetry(root)
                        # string, read/write, default={}, indices={}
                        # Specifies a property value for cell symmetry. The valid values for the property
                        # symmetry include: {R0 | X | Y | R90 | X Y | X R90 | Y R90 | X Y R90}. Default
                        # {X Y}
  run_abstract_export_lef_version(root)
                        # enum {5.3 5.4 5.5 5.6 5.7 5.8}, read/write, default=5.7, indices={}
                        # Version of LEF to export. The default version is the same  as the version of
                        # technology LEF file being imported.
  run_abstract_extract_layers_power(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers through which the extractor extracts  each power net. This
                        # is used to reduce the search space if abstract is taking too much run time for
                        # each cell. Usually not applicable to standard cells. For blocks it is common to
                        # only extract the power nets on the top one or two metal layers.
  run_abstract_extract_layers_signal(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the layers through which the extractor extracts  each net. This is
                        # used to reduce the search space if abstract is taking too much run time for
                        # each cell. Usually not applicable to standard cells.
  run_abstract_extract_pin_layers_power(root)
                        # string, read/write, default={}, indices={}
                        # Determines which of the shapes found by the extractor should be turned into
                        # pins. This argument is valid only if the associated layer, geometry
                        # specification and connectivity have been provided in the technology LEF.
                        # Usually not applicable to standard cells.
  run_abstract_extract_pin_layers_signal(root)
                        # string, read/write, default={}, indices={}
                        # Determines which of the shapes found by the extractor  should be turned into
                        # pins. This argument is valid only if the associated layer, geometry
                        # specification and connectivity have been provided in the technology LEF.
                        # Usually not applicable to standard cells.
  run_abstract_input_cell_type(root)
                        # enum {std io block}, read/write, default=std, indices={}
                        # Choose the cell type being translated with abstract. The tool adjusts its
                        # settings based on this selection. Optional.
  run_abstract_input_lef_tech_file(root)
                        # string, read/write, default={}, indices={}
                        # Input technology LEF file. This is used to get all the layer names, their types
                        # (routing, cut, etc.) and the layer order for extracting connectivity. Required.
  run_abstract_input_stream_layer_map_file(root)
                        # string, read/write, default={}, indices={}
                        # Specify the file that maps GDS layer number / data type to LEF layer names in
                        # the Virtuoso format. Required.
                        # For example, the gds file is not colorized, you could use the common virtuoso
                        # format gds layer map to stream gds file.
                        # #layer name #purpose name #stream layer #stream data type
                        # V0 drawing 35 0
                        # V0 drawing 35 235
                        # V0 drawing 35 236
                        # M1 drawing 15 0
                        # M1 drawing 15 235
                        # M1 drawing 15 236
                        # M1 drawing 15 239
                        # For example, the gds file is colorized, you could specify the mask color in gds
                        # layer map to stream gds file.
                        # #layer name #purpose name #stream layer #stream data type #photo mask color
                        # #color state
                        # V0 drawing 35 0
                        # V0 drawing 35 235 mask1Color unlocked
                        # V0 drawing 35 236 mask2Color unlocked
                        # M1 drawing 15 0
                        # M1 drawing 15 235 mask1Color unlocked
                        # M1 drawing 15 236 mask2Color unlocked
                        # M1 drawing 15 239 mask3Color unlocked
  run_abstract_keep_output_files(root)
                        # bool, read/write, default=false, indices={}
                        # Do not clean up temporary files/libraries that are created in the process after
                        # command finishes.
  run_abstract_pins_analog_names(root)
                        # string, read/write, default={}, indices={}
                        # Identifies analog  pin names based on label strings in the Abstract to set the
                        # LEF "USE ANALOG" property. Enter a list of possible names for the analog pins.
                        # This can be a list of regular expressions, each separated by a space.
  run_abstract_pins_clock_names(root)
                        # string, read/write, default={}, indices={}
                        # Identifies clock pin names based on label strings in the Abstract to set the
                        # LEF "USE CLOCK" property. Enter a list of possible names for the clock pins.
                        # This can be a list of regular expressions, each separated by a space.
  run_abstract_pins_ground_names(root)
                        # string, read/write, default={}, indices={}
                        # Identifies ground pins based on label strings in the Abstract to set the LEF
                        # "USE GROUND" property. Enter a list of possible names for the ground pins. This
                        # can be a list of regular expressions, each separated by a space.
  run_abstract_pins_output_names(root)
                        # string, read/write, default={}, indices={}
                        # Identifies output pins based on label strings in the GDS to set the LEF
                        # direction to OUTPUT. Enter a list of regular expressions separated by spaces.
  run_abstract_pins_power_names(root)
                        # string, read/write, default={}, indices={}
                        # Identifies power pin names based on label strings in the Abstract to set the
                        # LEF "USE POWER" property. Enter a list of possible names for the power pins.
                        # This can be a list of regular expressions, each separated by a space.
  run_abstract_pins_text_pin_map(root)
                        # string, read/write, default={}, indices={}
                        # Maps text labels to pins on nets. Specify the layer purpose pairs based on
                        # which you want the abstract generator to search for geometry of any given
                        # layer-purpose pair with a text label.
  run_abstract_pre_abstract_script(root)
