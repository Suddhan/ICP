                        # string, read/write, default={}, indices={}
                        # Instead of appending color pattern to normal cell names, use user specified
                        # suffix. This applies to fixed color shift (flip) pattern only. i.e., only
                        # single shift (flip) pattern applied to the design.
  write_stream_check_map_file(root)
                        # bool, read/write, default=false, indices={}
                        # Check the specified map file. If the objects existed in innovus, but the
                        # objects have no objects mapping in map file, print the missed objects mapping
                        # and missed objects in log file, only the main objects mapping are checked by
                        # the option.
  write_stream_compatible(root)
                        # bool, read/write, default=false, indices={}
                        # Output instance only is FOREIGN is specified.
  write_stream_define_via_name(root)
                        # string, read/write, default=default, indices={}
                        # Specifies the naming convention that the write_stream command uses for via
                        # cells declared in the DEF file.
  write_stream_ignore_fixed_mask(root)
                        # bool, read/write, default=false, indices={}
                        # Ignore macro FIXEDMASK keywords, enable color flip function.
  write_stream_label_all_pin_shape(root)
                        # bool, read/write, default=false, indices={}
                        # If true, label pin name to its all shapes.
  write_stream_merge_append(root)
                        # bool, read/write, default=false, indices={}
                        # Append cell color information in current design to cell geometries that are
                        # from merging files. This option is for TSMC 10nm fixed-mask design. It is
                        # exclusive with write_stream_ignore_inst_color attribute and
                        # write_stream_ignore_inst_cce_color attribute, it will set those two attributes
                        # to false automatically when it is set to true.
  write_stream_merge_trim_shapes(root)
                        # string, read/write, default={}, indices={}
                        # Specify the setting for trim shapes merge. layers, specify the layer list which
                        # need merge trim shapes. gap merge, the trim shapes when end to end gap is less
                        # the value. max_trim_num, specify the max trim shapes number are merged. masks,
                        # specify the trim shapes color need to be merged.
  write_stream_oasis_cell_offset(root)
                        # bool, read/write, default=false, indices={}
                        # Include cell offset table to declare the byte offset from the beginning of the
                        # file (byte 0) to where the corresponding CELL record appears in the file.
  write_stream_oasis_compression(root)
                        # bool, read/write, default=true, indices={}
                        # CBLOCK compression is partial-selective encryption technology uses OASIS CBLOCK
                        # records to encrypt arbitrarily encapsulated sets of data records within an
                        # OASIS layout file.
                        # REPETITION compression supports an 'array' of cell placements, geometries, or
                        # text elements, instead of write each the element separate only different in
                        # position, this can save duplicate information for an OASIS layout file size.
  write_stream_oasis_layer_name(root)
                        # bool, read/write, default=false, indices={}
                        # Support LAYERNAME in OASIS file.
  write_stream_pin_text_orientation(root)
                        # string, read/write, default={}, indices={}
                        # Output pin name on the boundary of design to improve readability.
  write_stream_remove_nets(root)
                        # string, read/write, default={}, indices={}
                        # Don't output nets in the list.
  write_stream_snap_to_mfg(root)
                        # bool, read/write, default=false, indices={}
                        # Snap net's wire to manufacture grid if it is not.
  write_stream_stream_convert_rect_to_path(root)
                        # bool, read/write, default=false, indices={}
                        # When enabled, DEF SPECIALNETS path/rect and FILLS shapes are converted to
                        # GDSII/stream PATH data instead of BOUNDARY data. Conversion to path data can
                        # result in significantly smaller output database when there are many rectangle
                        # shapes (example: after metal fill is included).
  write_stream_stream_version(root)
                        # int, read/write, default=3, indices={}
                        # Specify GDSII version to output.
  write_stream_text_size(root)
                        # double, read/write, default=1.0, indices={}
                        # Changes the size of the text used in the text labels.
  write_stream_uniquify_cell_names_prefix(root)
                        # bool, read/write, default=false, indices={}
                        # Adds a prefix, instead of a suffix, to uniquified cell names.
  write_stream_via_names(root)
                        # bool, read/write, default=false, indices={}
                        # Determines the naming convention used for vias declared in the LEF file.
  write_stream_virtual_connection(root)
                        # bool, read/write, default=true, indices={}
                        # Specifies whether a colon (:) label is appended to pin names for DEF pins with
                        # the .extraN syntax and to LEF pins with multiple ports (if -output_macros is
                        # specified for LEF pin ports that have disjoint shapes).

