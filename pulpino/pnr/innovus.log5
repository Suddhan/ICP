  generate_special_via_reference_boundary(root)
                        # enum {design core}, read/write, default=design, indices={}
                        # Sets reference boundary
  generate_special_via_respect_stdcell_geometry(root)
                        # bool, read/write, default=false, indices={}
                        # Respects all standard cell patterns
  generate_special_via_respect_wire_ndr(root)
                        # bool, read/write, default=false, indices={}
                        # Control whether viagen support ndr rules
  generate_special_via_rule_preference(root)
                        # string, read/write, default=default, indices={}
                        # Specifies via rule preference
  generate_special_via_set_via_expand_dir(root)
                        # enum {auto horizontal vertical}, read/write, default=auto, indices={}
                        # Sets via expansion direction
  generate_special_via_snap_via_center_to_grid(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the via center alignment style per routing layer
  generate_special_via_split_long_via_global_grid(root)
                        # string, read/write, default=0 0 0 0 0 0 0 0, indices={}
                        # Controls global grids so vias on them are in line
  generate_special_via_symmetrical_via_only(root)
                        # enum {auto true false}, read/write, default=auto, indices={}
                        # adds symmetrical via only, auto sets true for OA flow, false for non-OA flow.
  generate_special_via_use_track_offset(root)
                        # bool, read/write, default=false, indices={}
                        # Uses track offset
  generate_special_via_use_trim_metal_enclosure(root)
                        # bool, read/write, default=false, indices={}
                        # Force tool to use enclosures with trim layer
  get_db_display_limit(root)
                        # int, read/write, default=10, indices={}
                        # Controls the number of objects that will be displayed when using get_db with an
                        # attribute pattern like '*' rather than single attribute name. If the value is
                        # 10, 'get_db insts .*' will only display 10 inst objects with all their
                        # attributes, and will only display the first 10 objects for any attribute that
                        # is an object list (e.g. the first 10 pins for each inst .pins value).
  group_hinst_suffix(root)
                        # string, read/write, default=i, indices={}
                        # new hinst name is created from the module name with a suffix added as defined
                        # by this tcl global
  groups(root)          # group*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .groups]
  gui_lines(root)       # gui_line*, read-only, default={}, indices={}
                        # Short-cut to all the gui_line objects in the design.
  gui_polygons(root)    # gui_polygon*, read-only, default={}, indices={}
                        # Short-cut to all the gui_polygon objects in the design.
  gui_rects(root)       # gui_rect*, read-only, default={}, indices={}
                        # Short-cut to all the gui_rect objects in the design.
  gui_shapes(root)      # gui_rect* gui_line*, read-only, default={}, indices={}
                        # Short-cut to all the gui_shape objects in the design.
  gui_texts(root)       # gui_text*, read-only, default={}, indices={}
                        # Short-cut to all the gui_text objects in the design.
  gui_verbose(root)     # enum {all db none}, read/write, default=db, indices={}
                        # Controls which GUI actions are logged. The choices are:
                        # all: all GUI actions;
                        # db: GUI actions that affect the DB like gui_select, set_layer_preference, but
                        # not display-only actions like gui_zoom, gui_pan;
                        # none: no gui_* commands are logged, so the .log and .cmd file are incomplete
  hdl_unconnected_marking_done(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies whether the undriven signals have been connected based on the value
                        # of the 'hdl_unconnected_value' attribute.
  hinsts(root)          # hinst*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .hinsts]
  hnets(root)           # hnet*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .hnets]
  hpins(root)           # hpin*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .hpins]
  hports(root)          # hport*, read-only, default={}, indices={}
                        # Short-cut for [get_db hinsts .hports]
  hybrid_hier_anchor_buffer(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the name of anchor buffer cell for master-clone flow
  hybrid_hier_feedthru_after_drv_opt(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies to enable or disable feed-though insertion after drv optimization
  hybrid_hier_feedthru_disable(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies to enable or disable feed-though insertion
  hybrid_hier_feedthru_exclude_nets_file(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the file name with net names. Feedthrough insertion will not be tried
                        # on these nets
  hybrid_hier_feedthru_include_nets_file(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the file name with net names. Feedthrough insertion if any will be
                        # done only on these nets
  hybrid_hier_feedthru_plugin_tcl(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the file name having customized feed-through flow from user
  hybrid_hier_hold_uncertainty_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies hold uncertainty for cts
  hybrid_hier_hold_uncertainty_post_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies hold uncertainty for postcts
  hybrid_hier_hold_uncertainty_pre_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies hold uncertainty for prects
  hybrid_hier_legalize_io(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies to legalize illegal IOs and place unplaced IOs
  hybrid_hier_net_derates(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies to enable or disble net derating
  hybrid_hier_no_inst_in_top(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies design has no instance in top
  hybrid_hier_out_dir(root)
                        # string, read/write, default=., indices={}
                        # Specifies directory name for feedthru, budget and pin assignment reports
  hybrid_hier_partition_place_halo(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies placement halo in microns to be applied around all partition in
                        # design. Default: "pinDepth + 2*minSpacing" of rouing layer M4
  hybrid_hier_partition_route_halo(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies routing halo in microns to be applied around all partition in design.
                        # Default: "pinDepth + 2*minSpacing" of rouing layer M4
  hybrid_hier_pin_assign_plugin_tcl(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the file name having customized pin-assignment flow from user
  hybrid_hier_pin_assign_timing_aware_priority(root)
                        # enum {tns wns}, read/write, default=wns, indices={}
                        # Specifies timing aware priority of pin assignment.
  hybrid_hier_setup_uncertainty_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies setup uncertainty for cts
  hybrid_hier_setup_uncertainty_post_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies setup uncertainty for postcts
  hybrid_hier_setup_uncertainty_pre_cts(root)
                        # double, read/write, default=-1.0, indices={}
                        # Specifies setup uncertainty for prects
  hybrid_hier_timing_budget_plugin_tcl(root)
                        # string, read/write, default={}, indices={}
                        # Specifies the file name having customized time-budgeting flow from user
  ignore_max_via_stack_rule(root)
                        # bool, read/write, default=false, indices={}
                        # If true, the MaxVIASTACK rule in tlef file is ignored.
  ilm_filter_internal_path(root)
                        # bool, read/write, default=false, indices={}
                        # filterInternalPath
  ilm_keep_async(root)  # bool, read/write, default=false, indices={}
                        # Keep paths from asynchronous input ports
  ilm_keep_flatten(root)
                        # bool, read/write, default=true, indices={}
                        # Instruct Innovus to keep in flattened state
  ilm_keep_high_fanout_ports(root)
                        # bool, read/write, default=true, indices={}
                        # Keep high fanout input port paths
  ilm_keep_inst_in_sdc(root)
                        # bool, read/write, default=false, indices={}
                        # Keep instances which have constraints on it
  ilm_keep_loopback(root)
                        # bool, read/write, default=false, indices={}
                        # Keep loop back paths
  ilm_max_num_insts(root)
                        # int, read/write, default=1000, indices={}
                        # Specify the maximum number of instances
  ilm_max_num_registers(root)
                        # int, read/write, default=40, indices={}
                        # Specify the maximum number of registers
  ilm_slack_driven(root)
                        # bool, read/write, default=false, indices={}
                        # slackDriven
  init_check_netlist(root)
                        # bool, read/write, default=false, indices={}
                        # After reading in the netlist, will do the same checks as check_design -netlist
  init_check_output_pin_constant(root)
                        # bool, read/write, default=true, indices={}
                        # Stops the Verilog reader if any output (or inout) signal pins have any 1'b0 or
                        # 1'b1 constants that would cause shorts to power/ground.
  init_delete_floating_hnets(root)
                        # bool, read/write, default=false, indices={}
                        # If true, an hnet (Verilog wire statement) that has nothing connected to it, is
                        # deleted from the netlist. The default value is false in Innovus to allow for
                        # netlist repair, but true in Tempus to delete non-timed nets and reduce memory.
  init_design_netlist_type(root)
                        # string, read/write, default=Verilog, indices={}
                        # Specifies the source of the design netlist. You can specify either "Verilog" or
                        # "OA".
  init_design_uniquify(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies whether the top is uniquified. When set to 1 (true) the design will
                        # be uniquified during the read and flatten process. Optimization is not allowed
                        # on a non-unique design. For use in a master/clone partitioning flow, the value
                        # should be 0 (false). Default = 0 (false).
  init_ground_nets(root)
                        # string, read/write, default={}, indices={}
                        # List of global Ground nets.
  init_ignore_pg_pin_polarity_check(root)
                        # string, read/write, default={}, indices={}
                        # List of leaf cell pin names to ignore power/ground pin polarity check. By
                        # default connect_global_net and CPF check for matching polarity between the net
                        # and pin.
  init_keep_empty_modules(root)
                        # bool, read/write, default=true, indices={}
                        # By default, usage of an empty Verilog module that has no matching library cell
                        # name becomes an empty hinst.  If this value is false, a dummy library cell is
                        # created, and usage of it becomes an inst.  You should then use other commands
                        # to 'fix' the dummy library cell before proceeding in the flow.
  init_lef_files(root)  # string, read/write, default={}, indices={}
                        # List of LEF files to be read. Mutually exclusive with init_oa_ref_lib.
  init_min_dbu_per_micron(root)
                        # int, read/write, default=0, indices={}
                        # Minimum DBU per micron
  init_mmmc_files(root)
                        # string, read/write, default={}, indices={}
                        # Path to MMMC View Definition file.
  init_no_new_assigns(root)
                        # bool, read/write, default=false, indices={}
                        # Turns on an assign-free flow. By default, applications like optimization can
                        # add Verilog assigns to remove unnecessary buffers and reduce power. If you have
                        # external tools that do not support Verilog assigns, you can set this value to
                        # true to prevent applications from adding any new assign statements to the
                        # Verilog netlist. If there are existing assigns in the Verilog netlist you can
                        # remove them with the delete_assigns command.
  init_oa_abstract_views(root)
                        # string, read/write, default={}, indices={}
                        # List of OpenAccess view names to be processed as abstracts (LEF MACRO
                        # equivalent). The read_netlist command uses init_oa_abstract_views list for
                        # on-demand loading of missing cells. Used by the read_physical and read_netlist
                        # commands.
  init_oa_default_rule(root)
                        # string, read/write, default={}, indices={}
                        # The default rule to be used in OpenAccess. Typically used to specify a metal
                        # stack LEFDefaultRouteSpec type constraint group to read from the technology
                        # library if the library contains multiple metal stacks. Used by the
                        # read_physical command.
  init_oa_design_cell(root)
                        # string, read/write, default={}, indices={}
                        # OpenAccess design cell name that was read. Set by the read_netlist
                        # -oa_cell_view command.
  init_oa_design_lib(root)
                        # string, read/write, default={}, indices={}
                        # OpenAccess design lib name that was read. Set by the read_netlist -oa_cell_view
                        # command.
  init_oa_design_view(root)
                        # string, read/write, default={}, indices={}
                        # OpenAccess design view name that was read. Set by the read_netlist
                        # -oa_cell_view command.
  init_oa_foundry_rule(root)
                        # string, read/write, default={}, indices={}
                        # The foundry constraint group to be used in OpenAccess. Typically used to
                        # specify a foundry_innovus_XXXX  constraint group to read from the technology
                        # library if the library contains multiple foundry_innovus_XXXX constraint
                        # groups. Used by the read_physical command.
  init_oa_layout_views(root)
                        # string, read/write, default={}, indices={}
                        # List of OpenAccess view names to be processed for cell layout viewing (GDSII
                        # equivalent). Also used in the case where a Verilog netlist is read and views
                        # from the init_oa_layout_views list are used in the Quick Abstract Inference
                        # flow to derive abstract information from layout views for cells that were not
                        # processed from the libraries in the read_physical -oa_ref_libs list. The
                        # read_netlist command uses init_oa_layout_view list for on-demand loading of
                        # missing cells. Used by the read_physical and read_netlist commands.
  init_oa_ref_libs(root)
                        # string, read/write, default={}, indices={}
                        # List of OpenAccess reference libraries. The first library in the list indicates
                        # the library that  was used for technology information unless read_physical
                        # -oa_tech_lib is specified. All cells from the specified libraries are read. It
                        # is important to include the standard cell library in the list to make sure that
                        # cells that are not in the current netlist are read and available for
                        # optimization. The init_oa_abstract_views and init_oa_layout_views lists specify
                        # which views of the cells are read. Set by the read_physical -oa_ref_libs
                        # command.
  init_oa_search_libs(root)
                        # string, read/write, default=*, indices={}
                        # List of OpenAccess reference libraries to be searched when cells are used in
                        # the Verilog netlist that are not found in the list of cells read from the
                        # libraries specified by read_physical -oa_ref_libs command, by default all
                        # libraries in the cds.lib are searched. The init_oa_abstract_views and
                        # init_oa_layout_views lists are used to indicate which view names are looked for
                        # during the search. Applies only when read_netlist command is used to process a
                        # Verilog netlist specify the connectivity to be read. Set by the read_physical
                        # -oa_search_libs command and used by the read_netlist command.
  init_oa_special_rule(root)
                        # string, read/write, default={}, indices={}
                        # The special rule to be used in OpenAccess to define the via search order for
                        # power routing. Typically used to specify a metal stack LEFSpecialRouteRouteSpec
                        # type constraint group to read from the technology library if the library
                        # contains multiple metal stacks. Used by the read_physical command.
  init_oa_tech_lib(root)
                        # string, read/write, default={}, indices={}
                        # OpenAccess library to use as source of technology information. If not
                        # specified, the first library in the read_physical -oa_ref_libs list will be
                        # used. Applies only when read_netlist is used to process a Verilog netlist. Set
                        # by the read_physical -oa_tech_lib command.
  init_power_intent_files(root)
                        # string*, read-only, default={}, indices={}
                        # Power intent files(s) read by last 'read_power_intent' command.
  init_power_nets(root)
                        # string, read/write, default={}, indices={}
                        # List of global Power nets.
  init_read_netlist_allow_port_mismatch(root)
                        # bool, read/write, default=false, indices={}
                        # If false, a Verilog instance with ports that do not match the Verilog module or
                        # library cell definition will cause an error and exit.  If true, an error
                        # message occurs, but the extra ports are added to the module or library cell
                        # definition to allow the inconsistent netlist to be read in and debugged
                        # further. The default is true for Innovus to allow repair of 'dirty netlists',
                        # but false for Tempus that normally does not tolerate 'dirty netlists'.
  init_read_netlist_allow_undefined_cells(root)
                        # bool, read/write, default=true, indices={}
                        # If false, a Verilog reference to an undefined cell (e.g. a Verilog module name
                        # that has no matching library cell and no Verilog module definition) causes an
                        # error and an exit after parsing the netlist. If true, an empty Verilog module
                        # is created with a warning.  The default value is true in Innovus to allow
                        # repair of 'dirty netlists' while it is false in Tempus to stop on 'dirty
                        # netlists'. An empty module will become an hinst or inst depending on the value
                        # of init_keep_empty_modules.
  init_read_netlist_files(root)
                        # string, read/write, default={}, indices={}
                        # A list of Verilog files read in during initialization. read_netlist will set
                        # this root attribute to the list of input files given to it. The original input
                        # file names are retained thru the flow for reference, and used by write_do_lec
                        # for the default golden netlist comparison file names.
  init_sync_relative_path(root)
                        # bool, read/write, default=false, indices={}
                        # Synchronize Relative paths
  init_timing_enabled(root)
                        # bool, read-only, default=true, indices={}
                        # If read_physical is issued before read_mmmc or read_libs in RC and Tempus, an
                        # error will be issued. In EDI, doing this will result in init_timing_enabled
                        # being set to false by the tool.  EDI is now in physical only mode, and any
                        # attempt to set timing data will result in an error.  By default,
                        # init_timing_enabled is set to true.
  insts(root)           # inst*, read-only, default={}, indices={}
                        # insts of current design
  io_constraints(root)  # io_constraint*, read-only, default={}, indices={}
                        # Short-cut for [get_db current_design .io_constraints]
  is_ilm_flattened(root)
                        # bool, read-only, default=false, indices={}
                        # Is true if you have ILMs, and the flatten_ilm command has flattened them so the
                        # internal ILM insts are visible.  unflatten_ilm will set it back to false.
  is_ilm_read(root)     # bool, read-only, default=false, indices={}
                        # Is true if you have read in any ILMs with read_ilm. It is not affected by
                        # flatten_ilm/unflatten_ilm.
  layer_name_no_abbreviation(root)
                        # bool, read/write, default=true, indices={}
                        # By default this value is true, and most command -layer <layer> options require
                        # a LEF/OA layer name, or a routing-layer index value (e.g. 1 for the first
                        # routing layer, 2 for the second, etc.) for input. If this global is false, then
                        # an older style abbreviation is also allowed (e.g. M1 for the first routing
                        # layer, M2 for the second routing layer, etc.).This layer abbreviation style is
                        # not recommended, and is only allowed for backward compatibility to migrate
                        # older scripts.  Eventually this global will be removed, so you should modify
                        # your scripts to use LEF/OA layer names, or routing-layer index values for
                        # -layer options to avoid problems in the future.
  layers(root)          # layer*, read-only, default={}, indices={}
                        # All the layers defined in the LEF or OA techfile.
  lib_arcs(root)        # lib_arc*, read-only, default={}, indices={}
                        # lib_arcs
  lib_cells(root)       # lib_cell*, read-only, default={}, indices={}
                        # lib_cells
  lib_pins(root)        # lib_pin*, read-only, default={}, indices={}
                        # lib_pins
  libraries(root)       # library*, read-only, default={}, indices={}
                        # Returns the information about the libraries in the design.
  library_sets(root)    # library_set*, read-only, default={}, indices={}
                        # Returns the information about the library sets in the design.
  log_file(root)        # string, read/write, default={}, indices={}
                        # The log file name of the program. It can be changed in the session to direct
                        # log file output to a different file. Type 'man log_file' for more details.
  log_verbose_style(root)
                        # enum {debug echo echo_comments}, read/write, default=echo, indices={}
                        # When verbose logging is enabled (see source_verbose, flow_verbose, or
                        # set_proc_verbose), the logging style for each command is controllable.  It is
                        # sometimes helpful to include line numbers and comments for script debug and
                        # other times this is too much information.  You can switch between settings in
                        # the middle of a script. 'debug' will output the file name, line number,
                        # commands, comments, and empty lines. 'echo' will output only the commands and
                        # line number. 'echo_comments' will output commands, comments, empty lines, and
                        # line number.
  log_verbose_type(root)
                        # enum {pre post both}, read/write, default=pre, indices={}
                        # When verbose logging is enabled (see source_verbose, flow_verbose, or
                        # set_proc_verbose), the default logging of each commands is pre-Tcl expansion.
                        # In some cases it is helpful to see post-Tcl expansion, or even both pre-Tcl and
                        # post-Tcl expansion when doing detailed debugging. You can switch between
                        # settings in the middle of a script. Type 'man log_file' for more details.
  logv_file(root)       # string, read/write, default={}, indices={}
                        # The verbose log file name of the program. It can be changed in the session to
                        # direct logv file output to a different file. Type 'man log_file' for more
                        # details.
  machine_learning_app_deployment(root)
                        # string, read/write, default={}, indices={}
                        # Specify deployment apps and their options settings
  machine_learning_app_dir(root)
                        # string, read/write, default=./, indices={}
                        # Specify dl app directory
  machine_learning_app_python_exe(root)
                        # string, read/write, default=python, indices={}
                        # Specify dl app training python binary path, default is os python path
  machine_learning_app_training(root)
                        # string, read/write, default={}, indices={}
                        # Specify training apps and their options settings
  machine_learning_deployment(root)
                        # string, read/write, default={}, indices={}
                        # Specify machine learning model file name of each model type
  machine_learning_slew(root)
                        # bool, read/write, default=false, indices={}
                        # predict pin slew
  machine_learning_training(root)
                        # enum {none net_delay net_cell_delay}, read/write, default=none,
                        # indices={}
                        # Specify machine learning training model type.
  machine_learning_write_in_post_route_opt(root)
                        # bool, read/write, default=true, indices={}
                        # dump training data in post route optimization
  markers(root)         # marker, read-only, default={}, indices={}
                        # Short-cut to all the marker objects in the design.
  messages(root)        # message*, read-only, default={}, indices={}
                        # A list of all the message objects.
  metric_advanced_url_endpoint(root)
                        # string, read/write, default={}, indices={}
                        # Base URL for the advanced metric server.
  metric_capture_depth(root)
                        # int, read/write, default=1, indices={}
                        # Depth for capturing hinst design and power metrics.
  metric_capture_design_image(root)
                        # bool, read/write, default=true, indices={}
                        # Capture design image.
  metric_capture_design_image_blockages(root)
                        # bool, read/write, default=true, indices={}
                        # Capture blockages in design image.
  metric_capture_design_image_power_intent(root)
                        # bool, read/write, default=true, indices={}
                        # Capture power intent objects in design image.
  metric_capture_design_image_route_drc(root)
                        # bool, read/write, default=true, indices={}
                        # Capture route drc markers in design image.
  metric_capture_max_drc_markers(root)
                        # int, read/write, default=1000, indices={}
                        # Maximum number of DRC markers to include in metric image.
  metric_capture_min_count(root)
                        # int, read/write, default=1000, indices={}
                        # Minimum instance count for capturing hinst design and power metrics.
  metric_capture_overwrite(root)
                        # bool, read/write, default=false, indices={}
                        # Overwrite pending metrics during create_snapshot category capture.
  metric_capture_pba_tns_histogram(root)
                        # bool, read/write, default=false, indices={}
                        # Capture path based analysis histogram data for TNS.
  metric_capture_per_view(root)
                        # bool, read/write, default=true, indices={}
                        # Capture timing metrics per analysis_view.
  metric_capture_timing_analysis_mode(root)
                        # enum {gba pba epba ipba}, read/write, default=gba, indices={}
                        # Timing analysis mode for metric capture during create_snapshot categories setup
                        # and hold; gba, pba, epba, ipba.
  metric_capture_timing_path_groups(root)
                        # string, read/write, default={}, indices={}
                        # Defines user path groups to capture for detailed display.
  metric_capture_timing_paths(root)
                        # int, read/write, default=10, indices={}
                        # Number of paths to capture for detailed display.
  metric_capture_tns_histogram(root)
                        # bool, read/write, default=true, indices={}
                        # Capture histogram data for TNS.
  metric_capture_tns_histogram_buckets(root)
                        # int, read/write, default=50, indices={}
                        # Number of buckets for the TNS histogram.
  metric_capture_tns_histogram_max_slack(root)
                        # int, read/write, default=0, indices={}
