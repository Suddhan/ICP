                        # the difference between early and late clock arrival time of the common point
  timing_cppr_skip_clock_reconvergence(root)
                        # bool, read/write, default=false, indices={}
                        # Specifies the branch point to use for computing clock path pessimism removal
                        # (CPPR) adjustment when there is reconvergence in the clock tree
  timing_cppr_skip_clock_reconvergence_for_unmatched_clocks(root)
                        # bool, read/write, default=false, indices={}
