[05/12 11:24:26    763s]   assign_pins_promoted_macro_bottom_layer(root)
[05/12 11:24:26    763s]                         # string, read/write, default=31, indices={}
[05/12 11:24:26    763s]                         # Specifies the minimum metal layer name for promoting macro pins
[05/12 11:24:26    763s]   assign_pins_promoted_macro_top_layer(root)
[05/12 11:24:26    763s]                         # string, read/write, default=31, indices={}
[05/12 11:24:26    763s]                         # Specifies the maximum metal layer name for promoting macro pins
[05/12 11:24:26    763s]   assign_pins_restricted_boundary_macro_distance(root)
[05/12 11:24:26    763s]                         # double, read/write, default=30.0, indices={}
[05/12 11:24:26    763s]                         # This option blocks automatic pin assignment, from putting pins on the part of partition boundary facing block on layers with OBS, in the places where channel width between partition
[05/12 11:24:26    763s]                         # boundary and block is less than the value specified. For channel width below specified value: OBS area on the layer, channel length and channel width considered to allow suitable number
[05/12 11:24:26    763s]                         # of pins on boundary facing this channel.
[05/12 11:24:26    763s]   assign_pins_strict_abutment(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
