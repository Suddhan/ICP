[05/12 11:24:26    763s]   bump_grids(root)      # bump_grid*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # List of bump_grid object.
[05/12 11:24:26    763s]   bumps(root)           # bump*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .bumps]
[05/12 11:24:26    763s]   bus_sink_groups(root)
[05/12 11:24:26    763s]                         # bus_sink_group*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # A group of sinks (loads) that some floorplan and routing commands use to control adding buffers and routing for a bus. See 'help *bus_sink*' for a list of commands related to this
[05/12 11:24:26    763s]                         # object.
[05/12 11:24:26    763s]   busses(root)          # bus*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .busses]
[05/12 11:24:26    763s]   categories(root)      # string, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # available categories of root attributes
[05/12 11:24:26    763s]   ccopt_auto_limit_insertion_delay_factor(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1.5, indices={}
[05/12 11:24:26    763s]                         # CCOpt attempts to keep the insertion delays of each clock tree a fixed multiple
[05/12 11:24:26    763s]                         # of the longest insertion delay that would result from a global skew approach.
[05/12 11:24:26    763s]                         # This multiple can be modified by design timing and the presence of other clock
[05/12 11:24:26    763s]                         # trees, but will start at a fixed fraction above the global skew insertion delay.
[05/12 11:24:26    763s]                         # This attribute specifies that fixed fraction.
[05/12 11:24:26    763s]                         # Valid values: real
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s] See also:
[05/12 11:24:26    763s]   . ccopt_auto_limit_insertion_delay_factor_skew_group
