[05/12 11:24:26    763s]   budget_snap_feedthru_budget_to(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the minimum delay value (in picoseconds) for the path from partition input port to partition output port.
[05/12 11:24:26    763s]   budget_snap_input_budget_to(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the minimum delay (in picoseconds) for the path from the partition input port to the internal register.
[05/12 11:24:26    763s]   budget_snap_negative_only(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Considers the only negative slack paths when used with budget_snap_input_budget_to and budget_snap_output_budget_to.
[05/12 11:24:26    763s]   budget_snap_output_budget_to(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the min delay (in picoseconds) for the path from the internal register to the partition output port.
[05/12 11:24:26    763s]   budget_stage_based_fanout_driving_factor(root)
[05/12 11:24:26    763s]                         # int, read/write, default=-1, indices={}
