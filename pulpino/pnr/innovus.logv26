[05/12 11:24:26    763s]   route_special_core_pin_max_via_scale(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Maximum via width and height at stripe crossover for standcell pins (%)
[05/12 11:24:26    763s]   route_special_core_pin_merge_limit(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # gaps smaller than this variable cause followpin rails to be joined
[05/12 11:24:26    763s]   route_special_core_pin_refer_to_follow_pin(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # M2 followpin generation uses follow pin wire
[05/12 11:24:26    763s]   route_special_core_pin_reference_macro(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
