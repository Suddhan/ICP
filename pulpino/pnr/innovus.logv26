[05/12 11:24:26    763s]                         # Consider max length in the trim shape layer.
[05/12 11:24:26    763s]   check_drc_uncolored(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # report color change violation when the dpt layer shape is free color.
[05/12 11:24:26    763s]   check_drc_use_min_spacing_on_block_obs(root)
