[05/12 11:24:26    763s]                         # Vertical supply scale factor
[05/12 11:24:26    763s]   route_rules(root)     # route_rule*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # All the route_rules. It is initialized from LEF NONDEFAULTRULES section or from OA equivalents.  It includes the reserved name "default" for the implicit LEF  default rule or the OA
[05/12 11:24:26    763s]                         # LEFDefaultRouteSpec.   It also includes design specific route_rules from create_route_rule or read in from DEF or an OA cellview.
[05/12 11:24:26    763s]   route_special_allow_non_preferred_direction_route(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # allow wrong way route
[05/12 11:24:26    763s]   route_special_avoid_over_core_row_layer(root)
