[05/12 11:24:26    763s]   gui_texts(root)       # gui_text*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut to all the gui_text objects in the design.
[05/12 11:24:26    763s]   gui_verbose(root)     # enum {all db none}, read/write, default=db, indices={}
[05/12 11:24:26    763s]                         # Controls which GUI actions are logged. The choices are:
[05/12 11:24:26    763s]                         # all: all GUI actions;
[05/12 11:24:26    763s]                         # db: GUI actions that affect the DB like gui_select, set_layer_preference, but not display-only actions like gui_zoom, gui_pan;
[05/12 11:24:26    763s]                         # none: no gui_* commands are logged, so the .log and .cmd file are incomplete
[05/12 11:24:26    763s]   hdl_unconnected_marking_done(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies whether the undriven signals have been connected based on the value of the 'hdl_unconnected_value' attribute.
[05/12 11:24:26    763s]   hinsts(root)          # hinst*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .hinsts]
[05/12 11:24:26    763s]   hnets(root)           # hnet*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .hnets]
[05/12 11:24:26    763s]   hpins(root)           # hpin*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .hpins]
[05/12 11:24:26    763s]   hports(root)          # hport*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db hinsts .hports]
[05/12 11:24:26    763s]   hybrid_hier_anchor_buffer(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the name of anchor buffer cell for master-clone flow
[05/12 11:24:26    763s]   hybrid_hier_feedthru_after_drv_opt(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies to enable or disable feed-though insertion after drv optimization
[05/12 11:24:26    763s]   hybrid_hier_feedthru_disable(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies to enable or disable feed-though insertion
[05/12 11:24:26    763s]   hybrid_hier_feedthru_exclude_nets_file(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the file name with net names. Feedthrough insertion will not be tried on these nets
[05/12 11:24:26    763s]   hybrid_hier_feedthru_include_nets_file(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the file name with net names. Feedthrough insertion if any will be done only on these nets
[05/12 11:24:26    763s]   hybrid_hier_feedthru_plugin_tcl(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the file name having customized feed-through flow from user
[05/12 11:24:26    763s]   hybrid_hier_hold_uncertainty_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies hold uncertainty for cts
[05/12 11:24:26    763s]   hybrid_hier_hold_uncertainty_post_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies hold uncertainty for postcts
[05/12 11:24:26    763s]   hybrid_hier_hold_uncertainty_pre_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies hold uncertainty for prects
[05/12 11:24:26    763s]   hybrid_hier_legalize_io(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies to legalize illegal IOs and place unplaced IOs
[05/12 11:24:26    763s]   hybrid_hier_net_derates(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies to enable or disble net derating
[05/12 11:24:26    763s]   hybrid_hier_no_inst_in_top(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies design has no instance in top
[05/12 11:24:26    763s]   hybrid_hier_out_dir(root)
[05/12 11:24:26    763s]                         # string, read/write, default=., indices={}
[05/12 11:24:26    763s]                         # Specifies directory name for feedthru, budget and pin assignment reports
[05/12 11:24:26    763s]   hybrid_hier_partition_place_halo(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies placement halo in microns to be applied around all partition in design. Default: "pinDepth + 2*minSpacing" of rouing layer M4
[05/12 11:24:26    763s]   hybrid_hier_partition_route_halo(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies routing halo in microns to be applied around all partition in design. Default: "pinDepth + 2*minSpacing" of rouing layer M4
[05/12 11:24:26    763s]   hybrid_hier_pin_assign_plugin_tcl(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the file name having customized pin-assignment flow from user
[05/12 11:24:26    763s]   hybrid_hier_pin_assign_timing_aware_priority(root)
[05/12 11:24:26    763s]                         # enum {tns wns}, read/write, default=wns, indices={}
[05/12 11:24:26    763s]                         # Specifies timing aware priority of pin assignment.
[05/12 11:24:26    763s]   hybrid_hier_setup_uncertainty_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies setup uncertainty for cts
[05/12 11:24:26    763s]   hybrid_hier_setup_uncertainty_post_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies setup uncertainty for postcts
[05/12 11:24:26    763s]   hybrid_hier_setup_uncertainty_pre_cts(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies setup uncertainty for prects
[05/12 11:24:26    763s]   hybrid_hier_timing_budget_plugin_tcl(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the file name having customized time-budgeting flow from user
[05/12 11:24:26    763s]   ignore_max_via_stack_rule(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If true, the MaxVIASTACK rule in tlef file is ignored.
[05/12 11:24:26    763s]   ilm_filter_internal_path(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # filterInternalPath
[05/12 11:24:26    763s]   ilm_keep_async(root)  # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Keep paths from asynchronous input ports
[05/12 11:24:26    763s]   ilm_keep_flatten(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Instruct Innovus to keep in flattened state
[05/12 11:24:26    763s]   ilm_keep_high_fanout_ports(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Keep high fanout input port paths
[05/12 11:24:26    763s]   ilm_keep_inst_in_sdc(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Keep instances which have constraints on it
[05/12 11:24:26    763s]   ilm_keep_loopback(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Keep loop back paths
[05/12 11:24:26    763s]   ilm_max_num_insts(root)
[05/12 11:24:26    763s]                         # int, read/write, default=1000, indices={}
[05/12 11:24:26    763s]                         # Specify the maximum number of instances
[05/12 11:24:26    763s]   ilm_max_num_registers(root)
[05/12 11:24:26    763s]                         # int, read/write, default=40, indices={}
[05/12 11:24:26    763s]                         # Specify the maximum number of registers
[05/12 11:24:26    763s]   ilm_slack_driven(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # slackDriven
[05/12 11:24:26    763s]   init_check_netlist(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # After reading in the netlist, will do the same checks as check_design -netlist
[05/12 11:24:26    763s]   init_check_output_pin_constant(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Stops the Verilog reader if any output (or inout) signal pins have any 1'b0 or 1'b1 constants that would cause shorts to power/ground.
[05/12 11:24:26    763s]   init_delete_floating_hnets(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If true, an hnet (Verilog wire statement) that has nothing connected to it, is deleted from the netlist. The default value is false in Innovus to allow for netlist repair, but true in
[05/12 11:24:26    763s]                         # Tempus to delete non-timed nets and reduce memory.
[05/12 11:24:26    763s]   init_design_netlist_type(root)
[05/12 11:24:26    763s]                         # string, read/write, default=Verilog, indices={}
[05/12 11:24:26    763s]                         # Specifies the source of the design netlist. You can specify either "Verilog" or "OA".
[05/12 11:24:26    763s]   init_design_uniquify(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies whether the top is uniquified. When set to 1 (true) the design will be uniquified during the read and flatten process. Optimization is not allowed on a non-unique design. For
[05/12 11:24:26    763s]                         # use in a master/clone partitioning flow, the value should be 0 (false). Default = 0 (false).
[05/12 11:24:26    763s]   init_ground_nets(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of global Ground nets.
[05/12 11:24:26    763s]   init_ignore_pg_pin_polarity_check(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of leaf cell pin names to ignore power/ground pin polarity check. By default connect_global_net and CPF check for matching polarity between the net and pin.
[05/12 11:24:26    763s]   init_keep_empty_modules(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # By default, usage of an empty Verilog module that has no matching library cell name becomes an empty hinst.  If this value is false, a dummy library cell is created, and usage of it
[05/12 11:24:26    763s]                         # becomes an inst.  You should then use other commands to 'fix' the dummy library cell before proceeding in the flow.
[05/12 11:24:26    763s]   init_lef_files(root)  # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of LEF files to be read. Mutually exclusive with init_oa_ref_lib.
[05/12 11:24:26    763s]   init_min_dbu_per_micron(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # Minimum DBU per micron
[05/12 11:24:26    763s]   init_mmmc_files(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Path to MMMC View Definition file.
[05/12 11:24:26    763s]   init_no_new_assigns(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Turns on an assign-free flow. By default, applications like optimization can add Verilog assigns to remove unnecessary buffers and reduce power. If you have external tools that do not
[05/12 11:24:26    763s]                         # support Verilog assigns, you can set this value to true to prevent applications from adding any new assign statements to the Verilog netlist. If there are existing assigns in the
[05/12 11:24:26    763s]                         # Verilog netlist you can remove them with the delete_assigns command.
[05/12 11:24:26    763s]   init_oa_abstract_views(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of OpenAccess view names to be processed as abstracts (LEF MACRO equivalent). The read_netlist command uses init_oa_abstract_views list for on-demand loading of missing cells. Used
[05/12 11:24:26    763s]                         # by the read_physical and read_netlist commands.
[05/12 11:24:26    763s]   init_oa_default_rule(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # The default rule to be used in OpenAccess. Typically used to specify a metal stack LEFDefaultRouteSpec type constraint group to read from the technology library if the library contains
[05/12 11:24:26    763s]                         # multiple metal stacks. Used by the read_physical command.
[05/12 11:24:26    763s]   init_oa_design_cell(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # OpenAccess design cell name that was read. Set by the read_netlist -oa_cell_view command.
[05/12 11:24:26    763s]   init_oa_design_lib(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # OpenAccess design lib name that was read. Set by the read_netlist -oa_cell_view command.
[05/12 11:24:26    763s]   init_oa_design_view(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # OpenAccess design view name that was read. Set by the read_netlist -oa_cell_view command.
[05/12 11:24:26    763s]   init_oa_foundry_rule(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # The foundry constraint group to be used in OpenAccess. Typically used to specify a foundry_innovus_XXXX  constraint group to read from the technology library if the library contains
[05/12 11:24:26    763s]                         # multiple foundry_innovus_XXXX constraint groups. Used by the read_physical command.
[05/12 11:24:26    763s]   init_oa_layout_views(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of OpenAccess view names to be processed for cell layout viewing (GDSII equivalent). Also used in the case where a Verilog netlist is read and views from the init_oa_layout_views
[05/12 11:24:26    763s]                         # list are used in the Quick Abstract Inference flow to derive abstract information from layout views for cells that were not processed from the libraries in the read_physical
[05/12 11:24:26    763s]                         # -oa_ref_libs list. The read_netlist command uses init_oa_layout_view list for on-demand loading of missing cells. Used by the read_physical and read_netlist commands.
[05/12 11:24:26    763s]   init_oa_ref_libs(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of OpenAccess reference libraries. The first library in the list indicates the library that  was used for technology information unless read_physical -oa_tech_lib is specified. All
[05/12 11:24:26    763s]                         # cells from the specified libraries are read. It is important to include the standard cell library in the list to make sure that cells that are not in the current netlist are read and
[05/12 11:24:26    763s]                         # available for optimization. The init_oa_abstract_views and init_oa_layout_views lists specify which views of the cells are read. Set by the read_physical -oa_ref_libs command.
[05/12 11:24:26    763s]   init_oa_search_libs(root)
[05/12 11:24:26    763s]                         # string, read/write, default=*, indices={}
[05/12 11:24:26    763s]                         # List of OpenAccess reference libraries to be searched when cells are used in the Verilog netlist that are not found in the list of cells read from the libraries specified by
[05/12 11:24:26    763s]                         # read_physical -oa_ref_libs command, by default all libraries in the cds.lib are searched. The init_oa_abstract_views and init_oa_layout_views lists are used to indicate which view names
[05/12 11:24:26    763s]                         # are looked for during the search. Applies only when read_netlist command is used to process a Verilog netlist specify the connectivity to be read. Set by the read_physical
[05/12 11:24:26    763s]                         # -oa_search_libs command and used by the read_netlist command.
[05/12 11:24:26    763s]   init_oa_special_rule(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # The special rule to be used in OpenAccess to define the via search order for power routing. Typically used to specify a metal stack LEFSpecialRouteRouteSpec type constraint group to
[05/12 11:24:26    763s]                         # read from the technology library if the library contains multiple metal stacks. Used by the read_physical command.
[05/12 11:24:26    763s]   init_oa_tech_lib(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # OpenAccess library to use as source of technology information. If not specified, the first library in the read_physical -oa_ref_libs list will be used. Applies only when read_netlist is
[05/12 11:24:26    763s]                         # used to process a Verilog netlist. Set by the read_physical -oa_tech_lib command.
[05/12 11:24:26    763s]   init_power_intent_files(root)
[05/12 11:24:26    763s]                         # string*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Power intent files(s) read by last 'read_power_intent' command.
[05/12 11:24:26    763s]   init_power_nets(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of global Power nets.
[05/12 11:24:26    763s]   init_read_netlist_allow_port_mismatch(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If false, a Verilog instance with ports that do not match the Verilog module or library cell definition will cause an error and exit.  If true, an error message occurs, but the extra
[05/12 11:24:26    763s]                         # ports are added to the module or library cell definition to allow the inconsistent netlist to be read in and debugged further. The default is true for Innovus to allow repair of 'dirty
[05/12 11:24:26    763s]                         # netlists', but false for Tempus that normally does not tolerate 'dirty netlists'.
[05/12 11:24:26    763s]   init_read_netlist_allow_undefined_cells(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If false, a Verilog reference to an undefined cell (e.g. a Verilog module name that has no matching library cell and no Verilog module definition) causes an error and an exit after
[05/12 11:24:26    763s]                         # parsing the netlist. If true, an empty Verilog module is created with a warning.  The default value is true in Innovus to allow repair of 'dirty netlists' while it is false in Tempus to
[05/12 11:24:26    763s]                         # stop on 'dirty netlists'. An empty module will become an hinst or inst depending on the value of init_keep_empty_modules.
[05/12 11:24:26    763s]   init_read_netlist_files(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # A list of Verilog files read in during initialization. read_netlist will set this root attribute to the list of input files given to it. The original input file names are retained thru
[05/12 11:24:26    763s]                         # the flow for reference, and used by write_do_lec for the default golden netlist comparison file names.
[05/12 11:24:26    763s]   init_sync_relative_path(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Synchronize Relative paths
[05/12 11:24:26    763s]   init_timing_enabled(root)
[05/12 11:24:26    763s]                         # bool, read-only, default=true, indices={}
[05/12 11:24:26    763s]                         # If read_physical is issued before read_mmmc or read_libs in RC and Tempus, an error will be issued. In EDI, doing this will result in init_timing_enabled being set to false by the tool.
[05/12 11:24:26    763s]                         # EDI is now in physical only mode, and any attempt to set timing data will result in an error.  By default, init_timing_enabled is set to true.
[05/12 11:24:26    763s]   insts(root)           # inst*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # insts of current design
[05/12 11:24:26    763s]   io_constraints(root)  # io_constraint*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .io_constraints]
[05/12 11:24:26    763s]   is_ilm_flattened(root)
[05/12 11:24:26    763s]                         # bool, read-only, default=false, indices={}
[05/12 11:24:26    763s]                         # Is true if you have ILMs, and the flatten_ilm command has flattened them so the internal ILM insts are visible.  unflatten_ilm will set it back to false.
[05/12 11:24:26    763s]   is_ilm_read(root)     # bool, read-only, default=false, indices={}
[05/12 11:24:26    763s]                         # Is true if you have read in any ILMs with read_ilm. It is not affected by flatten_ilm/unflatten_ilm.
[05/12 11:24:26    763s]   layer_name_no_abbreviation(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # By default this value is true, and most command -layer <layer> options require a LEF/OA layer name, or a routing-layer index value (e.g. 1 for the first routing layer, 2 for the second,
[05/12 11:24:26    763s]                         # etc.) for input. If this global is false, then an older style abbreviation is also allowed (e.g. M1 for the first routing layer, M2 for the second routing layer, etc.).This layer
[05/12 11:24:26    763s]                         # abbreviation style is not recommended, and is only allowed for backward compatibility to migrate older scripts.  Eventually this global will be removed, so you should modify your
[05/12 11:24:26    763s]                         # scripts to use LEF/OA layer names, or routing-layer index values for -layer options to avoid problems in the future.
