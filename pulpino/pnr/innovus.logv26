[05/12 11:24:26    763s]   route_special_pad_pin_min_via_size(root)
[05/12 11:24:26    763s]                         # double, read/write, default=20.0, indices={}
[05/12 11:24:26    763s]                         # Minimum via width percent between pad and ring.
[05/12 11:24:26    763s]   route_special_pad_pin_split(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Split width and spacing for wide pad pins
[05/12 11:24:26    763s]   route_special_pad_ring_use_lef(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Keep user LEF input for pad rings
[05/12 11:24:26    763s]   route_special_pg_pin_as_signal(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # List of cell/pin information NOT extract from CPF
[05/12 11:24:26    763s]   route_special_secondary_pin_max_gap(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
