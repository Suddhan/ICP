[05/12 11:24:26    763s]                         # clocks
[05/12 11:24:26    763s]   cmd_file(root)        # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # The cmd file name of the program. It has each command run in the current session. It can be changed during the session to direct cmd file output to a different file. Type 'man log_file'
[05/12 11:24:26    763s]                         # for more details.
[05/12 11:24:26    763s]   constraint_modes(root)
[05/12 11:24:26    763s]                         # constraint_mode*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Returns the information about the constraint modes in the design.
[05/12 11:24:26    763s]   cts_add_port_driver_max_distance_from_port(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # This attribute specifies the allowable distance, in um if no units suffix is specified, that a port driver is allowed to be placed from the port being buffered. If the driver cannot be
[05/12 11:24:26    763s]                         # added close enough to the port it will not be added at all. This attribute, if set, overrides any value set in the attribute cts_add_port_driver_max_distance_from_port_rows.
[05/12 11:24:26    763s]   cts_add_port_driver_max_distance_from_port_rows(root)
[05/12 11:24:26    763s]                         # int, read/write, default=50, indices={}
[05/12 11:24:26    763s]                         # This attribute specifies the allowable distance, in standard cell row heights, that a port driver is allowed to be placed from the port being buffered. If the driver cannot be added
[05/12 11:24:26    763s]                         # close enough to the port it will not be added at all. The attribute cts_add_port_driver_max_distance_from_port, if set, overrides this value.
[05/12 11:24:26    763s]   cts_adjacent_rows_legal(root)
[05/12 11:24:26    763s]                         # string, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Defines the clock halo in the y direction. If set to true the y direction clock halo is zero and other clock instances are allowed in adjacent rows.
[05/12 11:24:26    763s]                         # The following attributes can be used to assign y direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_y
[05/12 11:24:26    763s]                         # cts_adjacent_rows_legal
[05/12 11:24:26    763s]                         # cts_cell_halo_rows
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the y direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y direction clock halo. The attributes cts_adjacent_rows_legal and cts_cell_halo_rows have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a non-auto value then cts_adjacent_rows_legal defines the clock halo in the y direction. The attribute
[05/12 11:24:26    763s]                         # cts_cell_halo_rows has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then cts_cell_halo_rows defines the clock halo in the y direction.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]   . cts_cell_halo_y
[05/12 11:24:26    763s]   . cts_cell_halo_rows
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_allow_non_std_clock_gate_inputs(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If this attribute is set, CTS will allow the use of clock gates with non-standard pins. CCOpt considers the following pin types to be standard: clock pins, enable pins, test enable
[05/12 11:24:26    763s]                         # pins, retention pins and power gating pins. Before starting CTS CCOpt will emit a warning, indicating which pin(s) it considers non-standard.
[05/12 11:24:26    763s]   cts_balance_mode(root)
[05/12 11:24:26    763s]                         # string, read/write, default=full, indices={}
[05/12 11:24:26    763s]                         # Replace CCOpt mode setting cts_opt_type {full | cluster | trial}. If not full, causes CCOpt and CCOpt CTS to halt before final completion of the clock tree to facilitate clock tree
[05/12 11:24:26    763s]                         # inspection.
[05/12 11:24:26    763s]                         # The possible values for this attribute are as follows:
[05/12 11:24:26    763s]                         # - full       - default value, a full CTS is performed.
[05/12 11:24:26    763s]                         # - cluster    - a cluster-only CTS is performed. The clock tree has no balancing delay applied.
[05/12 11:24:26    763s]                         # - trial      - The clock has only virtual (numeric annotation) balancing delays applied.
[05/12 11:24:26    763s]   cts_blackbox_default_driver_base_pin(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Base pin that will be used for all timing and capacitance modeling for clock roots with a source pin at a blackbox output.
[05/12 11:24:26    763s]   cts_blackbox_default_load_base_pin(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Base pin that will be used for all timing and capacitance modeling for clock sinks at blackbox inputs. Any cts_capacitance_override attribute will be used in preference to this.
[05/12 11:24:26    763s]   cts_buffer_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the buffer cells for CTS. If none are specified CCOpt will choose buffers from the libraries.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different buffer cells may be specified for any combination of clock tree and power domain.
[05/12 11:24:26    763s]                         # To use different buffers for each net type set the cts_buffer_cells_top and cts_buffer_cells_leaf attributes .
[05/12 11:24:26    763s]                         # Some examples follow:
[05/12 11:24:26    763s]                         # To specify buffer cells for all clock trees and all power domains:
[05/12 11:24:26    763s]                         # set_db cts_buffer_cells {bufAX* bufBX*}
[05/12 11:24:26    763s]                         # To specify buffer cells for a particular clock tree and all power domains:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_buffer_cells {bufX20 bufX18}
[05/12 11:24:26    763s]                         # To specify buffer cells for a particular clock tree and power domain:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_buffer_cells -index {power_domain <pd>} {bufX12 bufX8}
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_buffer_cells_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the buffer cells available for CTS to use on leaf nets. If none are specified CCOpt will use the same buffers as on trunk nets
[05/12 11:24:26    763s]                         # (as specified in the cts_buffer_cells attribute).
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different leaf buffer cells may be specified for any combination of clock tree and power domain. 
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s]   cts_buffer_cells_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the buffers cells available for CTS to use on top nets. If none are specified CCOpt will use the same buffers as on trunk nets
[05/12 11:24:26    763s]                         # (as specified in the cts_buffer_cells attribute).
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different top buffer cells may be specified for any combination of clock tree and power domain. 
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s]   cts_cell_density(root)
[05/12 11:24:26    763s]                         # string, read/write, default=0.75, indices={}
[05/12 11:24:26    763s]                         # Specifies the clock halo in the x direction.
[05/12 11:24:26    763s]                         # Any x direction clock halo defined by this attribute is proportional to the cell width.
[05/12 11:24:26    763s]                         # The constant of proportionality is defined by the attribute value. For example:
[05/12 11:24:26    763s]                         # . If cts_cell_density = 0.25 then the x direction clock halo equals 3 * cell width.
[05/12 11:24:26    763s]                         # . If cts_cell_density = 0.5 then the x direction clock halo equals cell width.
[05/12 11:24:26    763s]                         # . If cts_cell_density = 0.75 then the x direction clock halo equals cell width / 3.
[05/12 11:24:26    763s]                         # . If cts_cell_density = 1 then the x direction clock halo equals zero.
[05/12 11:24:26    763s]                         # This attribute can specify the x direction clock halo for all clock trees via:
[05/12 11:24:26    763s]                         # set_db cts_cell_density 0.8
[05/12 11:24:26    763s]                         # This attribute can specify the x direction clock halo per-clock tree via:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_cell_density 0.9
[05/12 11:24:26    763s]                         # The following attributes can be used to assign x direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_x
[05/12 11:24:26    763s]                         # cts_cell_density
[05/12 11:24:26    763s]                         # cts_cell_halo_sites
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the x direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto value then cts_cell_density defines the clock halo in the x direction. The attribute cts_cell_halo_sites
[05/12 11:24:26    763s]                         # has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then cts_cell_halo_sites defines the clock halo in the x direction.
[05/12 11:24:26    763s]                         # Valid values: 0.01 to 1
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]   . cts_cell_halo_x
[05/12 11:24:26    763s]   . cts_cell_halo_sites
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_cell_halo_mode(root)
[05/12 11:24:26    763s]                         # string, read/write, default=max, indices={}
[05/12 11:24:26    763s]                         # Specifies how clock halos are used to determine the minimum legal separation between a pair of clock instances. There are two possible modes 'max' and 'sum'. When set to 'max' the
[05/12 11:24:26    763s]                         # minimum legal separation is the larger of the two clock halos. When set to 'sum' the minimum legal separation is the sum of the two clock halos.
[05/12 11:24:26    763s]                         # Valid values: max sum 
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]                         # . cts_cell_halo_x
[05/12 11:24:26    763s]                         # . cts_cell_halo_y
[05/12 11:24:26    763s]                         # . cts_cell_density
[05/12 11:24:26    763s]                         # . cts_adjacent_rows_legal
[05/12 11:24:26    763s]                         # . cts_cell_halo_sites
[05/12 11:24:26    763s]                         # . cts_cell_halo_rows
[05/12 11:24:26    763s]                         # . cts_effective_clock_halo_x
[05/12 11:24:26    763s]                         # . cts_effective_clock_halo_y
[05/12 11:24:26    763s]                         # . cts_effective_clock_halo_x_source
[05/12 11:24:26    763s]                         # . cts_effective_clock_halo_y_source
[05/12 11:24:26    763s]   cts_cell_halo_rows(root)
[05/12 11:24:26    763s]                         # int, read/write, default=1, indices={}
[05/12 11:24:26    763s]                         # Specifies the clock halo in the y direction in rows for all clock cells.
[05/12 11:24:26    763s]                         # The following attributes can be used to assign y direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_y
[05/12 11:24:26    763s]                         # cts_adjacent_rows_legal
[05/12 11:24:26    763s]                         # cts_cell_halo_rows
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the y direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y direction clock halo. The attributes cts_adjacent_rows_legal and cts_cell_halo_rows have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a non-auto value then cts_adjacent_rows_legal defines the clock halo in the y direction. The attribute
[05/12 11:24:26    763s]                         # cts_cell_halo_rows has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then cts_cell_halo_rows defines the clock halo in the y direction.
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]                         # . cts_cell_halo_y
[05/12 11:24:26    763s]                         # . cts_adjacent_rows_legal
[05/12 11:24:26    763s]   cts_cell_halo_sites(root)
[05/12 11:24:26    763s]                         # int, read/write, default=4, indices={}
[05/12 11:24:26    763s]                         # Specifies the clock halo in the x direction in sites for all clock cells. 
[05/12 11:24:26    763s]                         # The following attributes can be used to assign x direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_x
[05/12 11:24:26    763s]                         # cts_cell_density
[05/12 11:24:26    763s]                         # cts_cell_halo_sites
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the x direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto value then cts_cell_density defines the clock halo in the x direction. The attribute cts_cell_halo_sites
[05/12 11:24:26    763s]                         # has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then cts_cell_halo_sites defines the clock halo in the x direction.
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]   . cts_cell_halo_x
[05/12 11:24:26    763s]   . cts_cell_density
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_cell_halo_x(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the clock halo distance in the x direction. The default value of this attribute is auto.
[05/12 11:24:26    763s]                         # The following attributes can be used to assign x direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_x
[05/12 11:24:26    763s]                         # cts_cell_density
[05/12 11:24:26    763s]                         # cts_cell_halo_sites
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the x direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to a non-auto value, then this defines the x direction clock halo. The attributes cts_cell_density and cts_cell_halo_sites have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_x is set to auto and cts_cell_density is set to a non-auto value then cts_cell_density defines the clock halo in the x direction. The attribute cts_cell_halo_sites
[05/12 11:24:26    763s]                         # has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_x and cts_cell_density are set to auto then cts_cell_halo_sites defines the clock halo in the x direction.
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]                         # . cts_cell_density
[05/12 11:24:26    763s]                         # . cts_cell_halo_sites
[05/12 11:24:26    763s]   cts_cell_halo_y(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the clock halo distance in the y direction. The default value of this attribute is auto.
[05/12 11:24:26    763s]                         # The following attributes can be used to assign y direction clock halos within CCOpt:
[05/12 11:24:26    763s]                         # cts_cell_halo_y
[05/12 11:24:26    763s]                         # cts_adjacent_rows_legal
[05/12 11:24:26    763s]                         # cts_cell_halo_rows
[05/12 11:24:26    763s]                         # Only one of these attributes is used to determine the clock halo in the y direction. The following rules determine which:
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to a non-auto value, then this defines the y direction clock halo. The attributes cts_adjacent_rows_legal and cts_cell_halo_rows have no effect.
[05/12 11:24:26    763s]                         # . If cts_cell_halo_y is set to auto and cts_adjacent_rows_legal is set to a non-auto value then cts_adjacent_rows_legal defines the clock halo in the y direction. The attribute
[05/12 11:24:26    763s]                         # cts_cell_halo_rows has no effect.
[05/12 11:24:26    763s]                         # . If both cts_cell_halo_y and cts_adjacent_rows_legal are set to auto then cts_cell_halo_rows defines the clock halo in the y direction.
[05/12 11:24:26    763s]                         # See also:
[05/12 11:24:26    763s]                         # . cts_adjacent_rows_legal
[05/12 11:24:26    763s]                         # . cts_cell_halo_rows
[05/12 11:24:26    763s]   cts_clock_gate_movement_limit(root)
[05/12 11:24:26    763s]                         # string, read/write, default=10, indices={}
[05/12 11:24:26    763s]                         # Each clock gate is restricted to a Manhattan ball centered on its original location with CTS flow.
[05/12 11:24:26    763s]                         # The radius of the ball is a multiple of the clock gate height. 
[05/12 11:24:26    763s]                         # This controls the default value of that multiple. 
[05/12 11:24:26    763s]   cts_clock_gating_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the clock gates for CTS. If none are specified CCOpt will choose clock gates from the libraries.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different clock gates may be specified for any combination of clock tree and power domain.
[05/12 11:24:26    763s]                         # Some examples follow:
[05/12 11:24:26    763s]                         # To specify clock gates for all clock trees and all power domains:
[05/12 11:24:26    763s]                         # set_db cts_clock_gating_cells {cgAX* cgBX*}
[05/12 11:24:26    763s]                         # To specify clock gates for a particular clock tree and all power domains:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_clock_gating_cells {cgX20 cgX18}
[05/12 11:24:26    763s]                         # To specify clock gates for a particular clock tree and power domain:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_clock_gating_cells -index {power_domain <pd>} {cgX12 cgX8}
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s]   cts_clock_source_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the cells available for CTS to size clock sources if the cts_size_clock_sources attribute is set to true. If none are specified the tool will choose cells from the
[05/12 11:24:26    763s]                         # libraries.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, the tool will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different cells may be specified for clock trees or power domains. Only clock sources that are buffers, inverters, logic and clock gating cells with a single output can be
[05/12 11:24:26    763s]                         # resized.
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_clock_tree_source_group_clock_trees(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # A list of the clock trees relevant to this source group.
[05/12 11:24:26    763s]                         # Valid values: list cts_clock_trees
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_clock_tree_source_input_max_transition_time(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0, indices=delay_corner
[05/12 11:24:26    763s]                         # The slew which will be assumed at the input of the root driver.
[05/12 11:24:26    763s]                         # Valid values: double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_cloning_inst_name_suffix(root)
[05/12 11:24:26    763s]                         # string, read/write, default=clone, indices={}
[05/12 11:24:26    763s]                         # If set, the suffix will be used generally for all insts cloned by CTS, else the suffix will default to "clone".
[05/12 11:24:26    763s]   cts_cloning_inst_name_suffix_source_group_assignment(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Controls the suffix used by multi-tap cloning. If set to a non-empty string, that string will be used when naming cloned instances created by multi-tap cloning. Otherwise, the suffix
[05/12 11:24:26    763s]                         # will be controlled by the attribute cts_cloning_inst_name_suffix.
[05/12 11:24:26    763s]   cts_delay_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the delay cells available for CTS. If none are specified CCOpt will not use delay cells.
[05/12 11:24:26    763s]                         # Setting this attribute to the string 'auto' means that CCOpt will choose delay cells from the libraries to use. 
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different delay cells may be specified for any combination of clock tree and power domain, or by omitting those
[05/12 11:24:26    763s]                         # arguments a global setting can be applied.
[05/12 11:24:26    763s]                         # Some examples follow:
[05/12 11:24:26    763s]                         # To specify delay cells for all clock trees and power domains:
[05/12 11:24:26    763s]                         # set_db cts_delay_cells {delayAX* delayBX*}
[05/12 11:24:26    763s]                         # To specify delay cells for a particular clock tree and all power domains:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_delay_cells {delayX1 delayX2}
[05/12 11:24:26    763s]                         # To specify delay cells for a particular clock tree and power domain:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_delay_cells  -index {power_domain <pd>} {delayX2 delayX3}
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names, or the string 'auto'
[05/12 11:24:26    763s]   cts_detailed_cell_warnings(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to true, CCOpt outputs detailed cell warning diagnostics when it
[05/12 11:24:26    763s]                         # encounters issues with library cell selection, power domains and/or signal
[05/12 11:24:26    763s]                         # levels.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_exit_if_no_placeable_area(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Specifies that CTS should exit if the design has zero placeable area.
[05/12 11:24:26    763s]                         # Setting this attribute may be useful to temporarily work-around problems with row
[05/12 11:24:26    763s]                         # definition and/or blockages causing placeable area to be zero.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_exit_if_skew_target_over_constrained(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Specifies that CCOpt should exit as current skew targets are
[05/12 11:24:26    763s]                         # likely to lead to poor results. By default, CCOpt computes a minimum skew
[05/12 11:24:26    763s]                         # target which should not lead to excessive buffering, and does not allow any
[05/12 11:24:26    763s]                         # skew target to be set lower than this minimum. This attribute overrides that
[05/12 11:24:26    763s]                         # check, and allows any skew target to be used.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_exit_if_stage_delay_sigma_target_over_constrained(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If set, allows any max stage delay sigma target to be set. If the target is too low, it is likely to lead to runtime problems.
[05/12 11:24:26    763s]   cts_exit_if_transition_target_over_constrained(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Specifies that CCOpt should exit, as with current slew targets it is
[05/12 11:24:26    763s]                         # likely to lead to runtime problems. By default, CCOpt computes a minimum slew
[05/12 11:24:26    763s]                         # target which should not lead to runtime problems, and does not allow any slew
[05/12 11:24:26    763s]                         # target to be set lower than this minimum. This attribute overrides that check,
[05/12 11:24:26    763s]                         # and allows any slew target to be used.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_fix_clock_sinks(root)
[05/12 11:24:26    763s]                         # string, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to true, we will DEF lock clock tree sinks after routing in addition to any clock node locking (fixed).
[05/12 11:24:26    763s]                         # If set to soft, we will DEF lock clock tree sinks after routing in addition to any clock node soft_locking (softFixed).
[05/12 11:24:26    763s]                         # Valid values: true false soft
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_flexible_htree_placement_legalization_effort(root)
[05/12 11:24:26    763s]                         # string, read/write, default=low, indices={}
[05/12 11:24:26    763s]                         # The legalization effort for finding placement unblocked points on the synthesis grid for flexible H-trees. High placement legalization effort can avoid having to relax placement
[05/12 11:24:26    763s]                         # constraints when implementing H-trees but may lead to increased runtime.
[05/12 11:24:26    763s]                         # Valid values: low, high (default low)
[05/12 11:24:26    763s]   cts_ignore_problematic_skew_as_result_of_dont_touch_nets(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set, sinks directly connected to nets that are causing unfixable skew problems will be ignored for skew balancing.
[05/12 11:24:26    763s]   cts_inst_name_prefix(root)
[05/12 11:24:26    763s]                         # string, read/write, default=CTS, indices={}
[05/12 11:24:26    763s]                         # The name prefix of instances created by CTS. The default value is 
[05/12 11:24:26    763s] "CTS". The default names of instances are CTS_*.
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s] Valid values: string
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_inverter_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the inverter cells available for CTS. If none are specified CCOpt will choose inverters from the libraries.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different inverter cells may be specified for any combination of clock tree and power domain. 
[05/12 11:24:26    763s]                         # To use different inverters for each net type set the cts_inverter_cells_top and cts_inverter_cells_leaf attributes .
[05/12 11:24:26    763s]                         # Some examples follow:
[05/12 11:24:26    763s]                         # To specify inverter cells for all clock trees and all power domains:
[05/12 11:24:26    763s]                         # set_db cts_inverter_cells {invAX* invBX*}
[05/12 11:24:26    763s]                         # To specify inverter cells for a particular clock tree and all power domains:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_inverter_cells {invX20 invX18}
[05/12 11:24:26    763s]                         # To specify inverter cells for a particular clock tree and power domain:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_inverter_cells -index {power_domain <pd>} {invX12 invX8}
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_inverter_cells_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the inverter cells available for CTS to use on leaf nets. If none are specified CCOpt will use the same inverters as on trunk nets
[05/12 11:24:26    763s]                         # (as specified in the cts_inverter_cells attribute).
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different leaf inverter cells may be specified for any combination of clock tree and power domain. 
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s]   cts_inverter_cells_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the inverter cells available for CTS to use on top nets. If none are specified CCOpt will use the same inverters as on trunk nets
[05/12 11:24:26    763s]                         # (as specified in the cts_inverter_cells attribute).
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different top inverter cells may be specified for any combination of clock tree and power domain. 
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s]   cts_load_capacitance_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the load capacitance cells available for CTS. CTS will use cells from this collection for load capacitance optimizations.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names.
[05/12 11:24:26    763s]   cts_logic_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices=power_domain
[05/12 11:24:26    763s]                         # Specifies the clock logics for CTS. If none are specified CCOpt will choose clock logics from the libraries.
[05/12 11:24:26    763s]                         # Cell names may be specified as a Tcl list of names, or as a Tcl list of patterns to be expanded to match names. 
[05/12 11:24:26    763s]                         # If set explicitly, CCOpt will ignore any dont_use settings for the cells specified. 
[05/12 11:24:26    763s]                         # Different logic cells may be specified for any combination of clock tree and power domain.
[05/12 11:24:26    763s]                         # Some examples follow:
[05/12 11:24:26    763s]                         # To specify logic cells for all clock trees and all power domains:
[05/12 11:24:26    763s]                         # set_db cts_logic_cells {and* mux*}
[05/12 11:24:26    763s]                         # To specify logic cells for a particular clock tree and all power domains:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_logic_cells {andX20 andX18}
[05/12 11:24:26    763s]                         # To specify logic cells for a particular clock tree and power domain:
[05/12 11:24:26    763s]                         # set_db clock_tree:<clk> .cts_logic_cells -index {power_domain <pd>} {andX12 andX8}
[05/12 11:24:26    763s]                         # Valid values: a list of library cell names, or a list of patterns to expand to library cell names
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_manage_power_intent_violations(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If this attribute is set, the CTS algorithm will work around power management
[05/12 11:24:26    763s]                         # illegalities in the clock tree, as opposed to failing with an error when it
[05/12 11:24:26    763s]                         # encounters them. This allows the clock tree to be synthesized, but any power
[05/12 11:24:26    763s]                         # management illegalities will remain in the exported design.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_max_fanout(root)  # int, read/write, default=100, indices={}
[05/12 11:24:26    763s]                         # The maximum fanout at any point in the clock tree.
[05/12 11:24:26    763s]                         # Valid values: integer ranged between 2 and 1000 inclusive
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_max_source_to_sink_net_length(root)
[05/12 11:24:26    763s]                         # string, read/write, default=top auto trunk auto leaf auto, indices={}
[05/12 11:24:26    763s]                         # The maximum routing length in microns between driving source pin and driven
[05/12 11:24:26    763s]                         # sink pin on each net that clock tree synthesis should observe.
[05/12 11:24:26    763s]                         # This constraint can be applied to either a pin, a clock tree, or a net type.
[05/12 11:24:26    763s]                         # By default (if this attribute is not set) no explicit clock tree net length
[05/12 11:24:26    763s]                         # constraint is enforced. However, other clock tree constraints such as maximum
[05/12 11:24:26    763s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[05/12 11:24:26    763s]                         # net length.
[05/12 11:24:26    763s]                         # Valid values: double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_max_source_to_sink_net_length_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # The maximum routing length in microns between driving source pin and driven
[05/12 11:24:26    763s]                         # sink pin on each net that clock tree synthesis should observe.
[05/12 11:24:26    763s]                         # This constraint can be applied to either a pin, a clock tree, or a net type.
[05/12 11:24:26    763s]                         # By default (if this attribute is not set) no explicit clock tree net length
[05/12 11:24:26    763s]                         # constraint is enforced. However, other clock tree constraints such as maximum
[05/12 11:24:26    763s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[05/12 11:24:26    763s]                         # net length.
[05/12 11:24:26    763s]                         # Valid values: double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_max_source_to_sink_net_length_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # The maximum routing length in microns between driving source pin and driven
[05/12 11:24:26    763s]                         # sink pin on each net that clock tree synthesis should observe.
[05/12 11:24:26    763s]                         # This constraint can be applied to either a pin, a clock tree, or a net type.
[05/12 11:24:26    763s]                         # By default (if this attribute is not set) no explicit clock tree net length
[05/12 11:24:26    763s]                         # constraint is enforced. However, other clock tree constraints such as maximum
[05/12 11:24:26    763s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[05/12 11:24:26    763s]                         # net length.
[05/12 11:24:26    763s]                         # Valid values: double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_max_source_to_sink_net_length_trunk(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # The maximum routing length in microns between driving source pin and driven
[05/12 11:24:26    763s]                         # sink pin on each net that clock tree synthesis should observe.
[05/12 11:24:26    763s]                         # This constraint can be applied to either a pin, a clock tree, or a net type.
[05/12 11:24:26    763s]                         # By default (if this attribute is not set) no explicit clock tree net length
[05/12 11:24:26    763s]                         # constraint is enforced. However, other clock tree constraints such as maximum
[05/12 11:24:26    763s]                         # slew (transition) and maximum capacitance will indirectly limit the maximum
[05/12 11:24:26    763s]                         # net length.
[05/12 11:24:26    763s]                         # Valid values: double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_merge_clock_gates(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to true, clock gate merging is enabled. If this is false, merging of all
[05/12 11:24:26    763s]                         # clock gates is disabled, including clock gates which may have been cloned by
[05/12 11:24:26    763s]                         # CTS.
[05/12 11:24:26    763s]                         # Note that this attribute only impacts 'ccopt_design -cts'. See also attribute
[05/12 11:24:26    763s] ccopt_merge_clock_gates.
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s] Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_merge_clock_logic(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to true, clock logic merging is enabled. If this is false, merging of all
[05/12 11:24:26    763s]                         # clock logics is disabled, including clock logics which may have been cloned by
[05/12 11:24:26    763s]                         # CTS.
[05/12 11:24:26    763s]                         # Note that this attribute only impacts 'ccopt_design -cts'. See also attribute
[05/12 11:24:26    763s] ccopt_merge_clock_logic.
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s] Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_mixed_fanout_net_type(root)
[05/12 11:24:26    763s]                         # string, read/write, default=leaf, indices={}
[05/12 11:24:26    763s]                         # Controls how CCOpt considers nets that have fanout consisting partially but not entirely of sinks. By default, having any sinks (eg. DFFs) will make the net be considered leaf, but when
[05/12 11:24:26    763s]                         # set to trunk, a net has to drive only sinks to be considered leaf. For example, a net driving a clock gate and a DFF would no longer count as a leaf net.
[05/12 11:24:26    763s]                         # Valid values: leaf trunk
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_move_clock_gates(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If this attribute is set, the CTS algorithm will move clock gates that appear in the clock tree. Setting this attribute may cause the clock tree to have a lower insertion delay, but
[05/12 11:24:26    763s]                         # might break datapath timing. During optimization, this is not a problem, because the timing will be automatically recovered during the optimization process. If this attribute is false,
[05/12 11:24:26    763s]                         # CTS permits small movements of ICGs for legalization.
[05/12 11:24:26    763s]   cts_move_logic(root)  # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If this attribute is set, the CTS algorithm will move logic that appears in the
[05/12 11:24:26    763s]                         # clock tree. "Logic" does not include clock gates, buffers, and inverters in a
[05/12 11:24:26    763s]                         # clock tree, which are always moved unless they are locked, or clock generators
[05/12 11:24:26    763s]                         # that are above the root of the clock tree. Usually, this will affect
[05/12 11:24:26    763s]                         # multiplexers used for selecting one of a number of clocks, or for switching
[05/12 11:24:26    763s]                         # between a test clock and the main clock. Setting this attribute may cause the
[05/12 11:24:26    763s]                         # clock tree to have a lower insertion delay, but might break datapath timing.
[05/12 11:24:26    763s]                         # During optimization, this is not a problem, because the timing will be
[05/12 11:24:26    763s]                         # automatically recovered during the optimization process.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_net_name_prefix(root)
[05/12 11:24:26    763s]                         # string, read/write, default=CTS, indices={}
[05/12 11:24:26    763s]                         # The name prefix of nets created by CTS. The default value is 
[05/12 11:24:26    763s]                         # "CTS". The default names of nets are CTS, CTS_1, CTS_2... ...
[05/12 11:24:26    763s]                         # Valid values: string
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_override_vias(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # When specified, this attribute defines the vias to be used in RC extraction
[05/12 11:24:26    763s]                         # from routing estimates. The listed vias will be used in place of those configured
[05/12 11:24:26    763s]                         # on the routing rules for the clock network.
[05/12 11:24:26    763s]                         # The order of the list is irrelevant.
[05/12 11:24:26    763s]                         # The vias may also be overridden for each non-default rule (NDR). In this
[05/12 11:24:26    763s]                         # case, the name of the NDR is given as the first element in the list with subsequent
[05/12 11:24:26    763s]                         # entries being the via names. Multiple NDRs can be specified, e.g.
[05/12 11:24:26    763s]                         # {via1d {NDR1 via2d} {NDR2 via2d}} will override via1d in the default rule, and
[05/12 11:24:26    763s]                         # both via1d and via2d in NDR1 and NDR2.
[05/12 11:24:26    763s]                         # Valid values: list via_call
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_post_route_enable(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Enable post-conditioning optimization after clock nets are routed.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_post_route_enable_routing_eco(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to false, post-conditioning will skip its ECO-routing step.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_post_route_repair_drv(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If set to false, post-conditioning will skip its DRV-fixing step.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_post_route_repair_skew_by_buffering(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set to true, post-conditioning will attempt skew-fixing using rebuffering.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_primary_delay_corner(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # This specifies the delay corner in which clock tree balancing applies the
[05/12 11:24:26    763s]                         # slew and insertion delay targets. If more than one timing corner is defined,
[05/12 11:24:26    763s]                         # this must be set before running CCOpt. By default, this is set to the delay corner
[05/12 11:24:26    763s]                         # contained in the first member of the list of setup views provided to the
[05/12 11:24:26    763s]                         # set_analysis_view command.
[05/12 11:24:26    763s]                         # Valid values:  corner name, or empty
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_primary_reporting_skew_groups(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # The primary skew groups used for reporting. 
[05/12 11:24:26    763s]                         # By default, the value is specified as auto that automatically takes the skew group with maximum number of sinks 
[05/12 11:24:26    763s]                         # as the primary reporting skew group. For invalid values, the default (auto) will be considered.
[05/12 11:24:26    763s]                         # Valid values: a list of existing skew group names, auto or none
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_primary_reporting_skew_groups_log_min_max_sinks(root)
[05/12 11:24:26    763s]                         # string, read/write, default=logv, indices={}
[05/12 11:24:26    763s]                         # If set to on, the sinks with the shortest and longest paths in each primary reporting skew group will be logged. If set to logv, they will be logged only to the logv file.
[05/12 11:24:26    763s]                         # Valid values: on, off, logv
[05/12 11:24:26    763s]   cts_repair_drv_by_buffering(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If set, the standalone clock_post_route_repair command called after route_design and the clock_post_route_repair called inside opt_design -post_route will fix clock DRVs by adding
[05/12 11:24:26    763s]                         # buffers, otherwise the tool will not add buffers to fix DRVs.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_report_skew_groups_only_with_targets(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # The skew groups report (run using the report_skew_groups command) displays 
[05/12 11:24:26    763s]                         # insertion delay, skew, and min/max path information for different combinations of skew group,
[05/12 11:24:26    763s]                         # timing corner, and early/late path.
[05/12 11:24:26    763s]                         # Set the cts_report_skew_groups_only_with_targets attribute to false (the default) to report on all skew group/timing corner/path 
[05/12 11:24:26    763s]                         # combinations regardless of whether a skew target has been set.
[05/12 11:24:26    763s]                         # Set the cts_report_skew_groups_only_with_targets attribute to true to report only on skew group/timing corner/path
[05/12 11:24:26    763s]                         # combinations where a skew target has been set (either explicitly or using the 'auto' setting).
[05/12 11:24:26    763s]   cts_route_clock_tree_nets(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Perform detailed routing, during the final implementation clock routing phase.
[05/12 11:24:26    763s]                         # Valid values: true or false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_route_type_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices={}
[05/12 11:24:26    763s]                         # Specifies the route type. Setting this attribute binds an existing user-defined route_type to one or more types of clock tree nets. Binding a route_type to a type of clock tree nets
[05/12 11:24:26    763s]                         # means that all nets of that type (including the nets created by CTS) will be routed according to the specification of that route_type.
[05/12 11:24:26    763s]                         # In the most common usage, the route_type is bound to one of the three types of clock tree nets (top, trunk, or leaf) with the optional -net_type argument. Omitting the -net_type
[05/12 11:24:26    763s]                         # argument causes the route_type to be bound to all three types of clock tree nets. The optional -clock_tree <pattern> argument limits the binding to the clock trees whose name matches
[05/12 11:24:26    763s]                         # <pattern>. Omitting the -clock_tree argument causes the binding to apply to all clock trees.
[05/12 11:24:26    763s]                         # For a route_type to be used in CTS, it must be bound to at least one net type. If net type is not bound to any route_type, a default route_type will be created for that net type at the
[05/12 11:24:26    763s]                         # start of CTS.
[05/12 11:24:26    763s]                         # Valid values: names of route_types created with create_route_type
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_route_type_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices={}
[05/12 11:24:26    763s]                         # Specifies the route type. Setting this attribute binds an existing user-defined route_type to one or more types of clock tree nets. Binding a route_type to a type of clock tree nets
[05/12 11:24:26    763s]                         # means that all nets of that type (including the nets created by CTS) will be routed according to the specification of that route_type.
[05/12 11:24:26    763s]                         # In the most common usage, the route_type is bound to one of the three types of clock tree nets (top, trunk, or leaf) with the optional -net_type argument. Omitting the -net_type
[05/12 11:24:26    763s]                         # argument causes the route_type to be bound to all three types of clock tree nets. The optional -clock_tree <pattern> argument limits the binding to the clock trees whose name matches
[05/12 11:24:26    763s]                         # <pattern>. Omitting the -clock_tree argument causes the binding to apply to all clock trees.
[05/12 11:24:26    763s]                         # For a route_type to be used in CTS, it must be bound to at least one net type. If net type is not bound to any route_type, a default route_type will be created for that net type at the
[05/12 11:24:26    763s]                         # start of CTS.
[05/12 11:24:26    763s]                         # Valid values: names of route_types created with create_route_type
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_route_type_trunk(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices={}
[05/12 11:24:26    763s]                         # Specifies the route type. Setting this attribute binds an existing user-defined route_type to one or more types of clock tree nets. Binding a route_type to a type of clock tree nets
[05/12 11:24:26    763s]                         # means that all nets of that type (including the nets created by CTS) will be routed according to the specification of that route_type.
[05/12 11:24:26    763s]                         # In the most common usage, the route_type is bound to one of the three types of clock tree nets (top, trunk, or leaf) with the optional -net_type argument. Omitting the -net_type
[05/12 11:24:26    763s]                         # argument causes the route_type to be bound to all three types of clock tree nets. The optional -clock_tree <pattern> argument limits the binding to the clock trees whose name matches
[05/12 11:24:26    763s]                         # <pattern>. Omitting the -clock_tree argument causes the binding to apply to all clock trees.
[05/12 11:24:26    763s]                         # For a route_type to be used in CTS, it must be bound to at least one net type. If net type is not bound to any route_type, a default route_type will be created for that net type at the
[05/12 11:24:26    763s]                         # start of CTS.
[05/12 11:24:26    763s]                         # Valid values: names of route_types created with create_route_type
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_routing_preferred_layer_effort(root)
[05/12 11:24:26    763s]                         # string, read/write, default=standard, indices={}
[05/12 11:24:26    763s]                         # Control preferred layer effort for clock routing.
[05/12 11:24:26    763s]   cts_size_clock_gates(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # When set to true (the default), the CTS algorithm sizes clock gates that appear in the clock tree. Setting this attribute may cause the clock tree to have a lower insertion delay, but
[05/12 11:24:26    763s]                         # might change the cell types of logic gates in the clock tree, which in turn may require them to be moved slightly to find a legal location for the new cell.
[05/12 11:24:26    763s]   cts_size_clock_sources(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # When set to true, CTS will try to size the clock source. Only clock sources that are buffers, inverters, logic and clock gating cells with a single output will be sized. The cells
[05/12 11:24:26    763s]                         # available for CTS to size clock sources can be set specified using the attribute 'cts_clock_source_cells'.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_size_logic(root)  # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # When set to true (the default), the CTS algorithm sizes logic that appears in
[05/12 11:24:26    763s]                         # the clock tree. "Logic" does not include clock gates, buffers, and inverters
[05/12 11:24:26    763s]                         # in a clock tree, which are always sized unless they are locked, or clock
[05/12 11:24:26    763s]                         # generators that are above the root of the clock tree. Usually, this affects
[05/12 11:24:26    763s]                         # multiplexers used for selecting one of a number of clocks, or for switching
[05/12 11:24:26    763s]                         # between a test clock and the main clock. Setting this attribute may cause the
[05/12 11:24:26    763s]                         # clock tree to have a lower insertion delay, but might change the cell types of
[05/12 11:24:26    763s]                         # logic gates in the clock tree, which in turn may require them to be moved
[05/12 11:24:26    763s]                         # slightly to find a legal location for the new cell.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_skew_group_report_columns(root)
[05/12 11:24:26    763s]                         # string, read/write, default=name lib_cell event increment time slew capacitance location distance fanout status, indices={}
[05/12 11:24:26    763s]                         # A Tcl list of columns to include in skew group reports produced by the
[05/12 11:24:26    763s]                         # skew group report. You can use this attribute to specify the columns you
[05/12 11:24:26    763s]                         # would like to include in the skew group report, and the order in which the
[05/12 11:24:26    763s]                         # columns should appear.
[05/12 11:24:26    763s]                         # Most of the legal values are straightforward. However, the set of legal values
[05/12 11:24:26    763s]                         # of the following form deserve further explanation:
[05/12 11:24:26    763s]                         # summaryType_summaryLocation[_event]
[05/12 11:24:26    763s]                         # These values let you report the delay value for other paths that go through
[05/12 11:24:26    763s]                         # the pin.
[05/12 11:24:26    763s]                         # summaryType is one of: max (show the longest delay), min (show the shortest
[05/12 11:24:26    763s]                         # delay), or skew (show the skew, that is the difference between the longest and
[05/12 11:24:26    763s]                         # the shortest delay).
[05/12 11:24:26    763s]                         # summaryLocation is one of: above (show the delay/skew above this pin), below
[05/12 11:24:26    763s]                         # (show the delay/skew below this pin), or through (show the delay/skew for
[05/12 11:24:26    763s]                         # paths through this pin).
[05/12 11:24:26    763s]                         # event is one of: rise (show the delay/skew for the rise event at this pin),
[05/12 11:24:26    763s]                         # fall (show the delay/skew for the fall event at this pin), or both (show the
[05/12 11:24:26    763s]                         # delay/skew for both events at this pin).
[05/12 11:24:26    763s]                         # Valid values:
[05/12 11:24:26    763s]                         # capacitance
[05/12 11:24:26    763s]                         # distance
[05/12 11:24:26    763s]                         # event
[05/12 11:24:26    763s]                         # fanout
[05/12 11:24:26    763s]                         # increment
[05/12 11:24:26    763s]                         # length
[05/12 11:24:26    763s]                         # lib_cell
[05/12 11:24:26    763s]                         # load_capacitance
[05/12 11:24:26    763s]                         # location
[05/12 11:24:26    763s]                         # max_above
[05/12 11:24:26    763s]                         # max_above_fall
[05/12 11:24:26    763s]                         # max_above_rise
[05/12 11:24:26    763s]                         # max_below
[05/12 11:24:26    763s]                         # max_below_fall
[05/12 11:24:26    763s]                         # max_below_rise
[05/12 11:24:26    763s]                         # max_through
[05/12 11:24:26    763s]                         # max_through_fall
[05/12 11:24:26    763s]                         # max_through_rise
[05/12 11:24:26    763s]                         # min_above
[05/12 11:24:26    763s]                         # min_above_fall
[05/12 11:24:26    763s]                         # min_above_rise
[05/12 11:24:26    763s]                         # min_below
[05/12 11:24:26    763s]                         # min_below_fall
[05/12 11:24:26    763s]                         # min_below_rise
[05/12 11:24:26    763s]                         # min_through
[05/12 11:24:26    763s]                         # min_through_fall
[05/12 11:24:26    763s]                         # min_through_rise
[05/12 11:24:26    763s]                         # name
[05/12 11:24:26    763s]                         # net
[05/12 11:24:26    763s]                         # pin
[05/12 11:24:26    763s]                         # resistance
[05/12 11:24:26    763s]                         # skew_above
[05/12 11:24:26    763s]                         # skew_above_fall
[05/12 11:24:26    763s]                         # skew_above_rise
[05/12 11:24:26    763s]                         # skew_below
[05/12 11:24:26    763s]                         # skew_below_fall
[05/12 11:24:26    763s]                         # skew_below_rise
[05/12 11:24:26    763s]                         # skew_through
[05/12 11:24:26    763s]                         # skew_through_fall
[05/12 11:24:26    763s]                         # skew_through_rise
[05/12 11:24:26    763s]                         # slew
[05/12 11:24:26    763s]                         # status
[05/12 11:24:26    763s]                         # time
[05/12 11:24:26    763s]                         # wire_capacitance
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_skew_group_report_histogram_bin_size(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # When set to a numeric value, that numeric value will be used as the histogram
[05/12 11:24:26    763s]                         # range size (in library units). For example, if the library time units are set
[05/12 11:24:26    763s]                         # to 1 nanosecond, a value of 0.010 for report_skew_groups_histogram_bin_size
[05/12 11:24:26    763s]                         # will result in histogram ranges of 10 picoseconds.
[05/12 11:24:26    763s]                         # When set to auto, the size of the histogram ranges are dependent on the skew
[05/12 11:24:26    763s]                         # targets that are set. If a skew target is set for a given half corner and skew
[05/12 11:24:26    763s]                         # group combination, then the histogram range size will be 10% of the skew
[05/12 11:24:26    763s]                         # target for that half corner and skew target combination. If no skew target is
[05/12 11:24:26    763s]                         # set for a half corner and skew group combination but a skew target is set for
[05/12 11:24:26    763s]                         # the primary half corner and skew group combination, then the histogram range
[05/12 11:24:26    763s]                         # size will be 10% of the skew target for the primary half corner and skew group
[05/12 11:24:26    763s]                         # combination.
[05/12 11:24:26    763s]                         # In the event that no skew targets are set and
[05/12 11:24:26    763s]                         # report_skew_groups_histogram_bin_size is set to auto, a default value of 10
[05/12 11:24:26    763s]                         # picoseconds will be used for the histogram range size.
[05/12 11:24:26    763s]                         # Valid values: auto | string
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_spec_config_base_pin_trace_through_to(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Clock tree definition will, by default, not continue through certain types of
[05/12 11:24:26    763s]                         # cell arc (for instance, the clock to Q arc in a DFF). This attribute allows
[05/12 11:24:26    763s]                         # you to override this default behavior, permitting the clock tree to trace through
[05/12 11:24:26    763s]                         # all instances of such a cell.
[05/12 11:24:26    763s]                         # This attribute serves the same function as trace_through_to,
[05/12 11:24:26    763s]                         # except that here the clock path is specified at the level of the library
[05/12 11:24:26    763s]                         # cell. 
[05/12 11:24:26    763s]                         # The attribute should be configured on the input library pin at
[05/12 11:24:26    763s]                         # which the clock will arrive. The value of the attribute specifies
[05/12 11:24:26    763s]                         # the output library pin to which the clock should propagate. The specified
[05/12 11:24:26    763s]                         # output pin must be another pin on the same library cell. The output pin may be
[05/12 11:24:26    763s]                         # specified either by its fully qualified name (i.e. inclusive of the cell name),
[05/12 11:24:26    763s]                         # or else simply by its local (cell-relative) name.
[05/12 11:24:26    763s]                         # There must be a pre-existing (library-defined) chain of one or more delay arcs
[05/12 11:24:26    763s]                         # that connect the input and output pins together. It is not possible to use
[05/12 11:24:26    763s]                         # library_trace_through_to to synthesize delay arcs.
[05/12 11:24:26    763s]                         # If multiple input pins are annotated on a given library cell, the value of
[05/12 11:24:26    763s]                         # library_trace_through_to at each of those pins must select the same output pin:
[05/12 11:24:26    763s]                         # i.e. the configuration must identify a single clock output for the cell. If
[05/12 11:24:26    763s]                         # multiple clock outputs are necessary then library_trace_through_to should not
[05/12 11:24:26    763s]                         # be used: instead for each instance of the library cell, define a generated
[05/12 11:24:26    763s]                         # clock tree at each of the clock-carrying outputs.
[05/12 11:24:26    763s]                         # If the configuration of library_trace_through_to settings for a given library
[05/12 11:24:26    763s]                         # cell does not meet these requirements, a warning will be issued and the
[05/12 11:24:26    763s]                         # settings for that cell will be ignored.
[05/12 11:24:26    763s]                         # All instances of the library cell will be affected by this setting. If both
[05/12 11:24:26    763s]                         # trace_through_to and library_trace_through_to are applicable at a given
[05/12 11:24:26    763s]                         # instance pin, the trace_through_to value will take precedence.
[05/12 11:24:26    763s]                         # Valid values: base_pin
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_spec_config_create_clock_tree_source_groups(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Causes create_clock_tree_spec to set up a clock tree source group for SDC clocks with
[05/12 11:24:26    763s]                         # multiple source pins. If this attribute is set to true, create_clock_tree_spec defines one clock tree for each
[05/12 11:24:26    763s]                         # source pin and then uses the create_clock_tree_source_group command to collect those clock trees together, so that
[05/12 11:24:26    763s]                         # CTS can distribute sinks between the clock trees.
[05/12 11:24:26    763s]   cts_spec_config_create_generator_skew_groups(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # This attribute will cause the create_clock_tree_spec command to create skew groups for sequential generators and their adjacent registers. Such skew groups will be specified with the
[05/12 11:24:26    763s]                         # same highest rank so that they can be balanced from the other normal skew groups that share some sinks of them. The adjacent registers of a generator are registers that have a datapath
[05/12 11:24:26    763s]                         # timing path to talk with the generator directly. When this attribute is set to true, one skew group will be created per sequential generator instance, master clock and generated clock
[05/12 11:24:26    763s]                         # tree triple. The resulting skew groups will by default be named in the pattern: 
[05/12 11:24:26    763s]                         # _clock_gen_<master_clock_name>_<generator_local_name><_optional_number>/<constraint_mode_name>. 
[05/12 11:24:26    763s]                         # For example, for a pair of generators, with the same local name "reg_clkgen", CCOpt creates generated clock trees from the same master clock named "fclk" in a constraint mode named
[05/12 11:24:26    763s]                         # "func" the skew groups emitted into the clock tree specification file would be named: 
[05/12 11:24:26    763s]                         # _clock_gen_fclk_reg_clkgen_1/func
[05/12 11:24:26    763s]                         # _clock_gen_fclk_reg_clkgen_2/func
[05/12 11:24:26    763s]                         # The prefix for the names of such skew groups is controlled by the cts_spec_config_create_generator_skew_groups_name_prefix CCOpt attribute and defaults to "_clock_gen" (the start
[05/12 11:24:26    763s]                         # underscore is used to group such skew groups at the end of any skew group listing ordered by name).
[05/12 11:24:26    763s]   cts_spec_config_create_generator_skew_groups_name_prefix(root)
[05/12 11:24:26    763s]                         # string, read/write, default=_clock_gen, indices={}
[05/12 11:24:26    763s]                         # This attribute controls the skew group name prefix used for skew groups generated to balance generator flops with their adjacent flops. Default is "_clock_gen". The default has a start
[05/12 11:24:26    763s]                         # underscore at the beginning to cause listings of skew groups ordered by name to collect such skew groups together at the end of a list.
[05/12 11:24:26    763s]   cts_spec_config_create_reporting_only_skew_groups(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Controls whether spec creation will synthesize reporting-only skew groups.
[05/12 11:24:26    763s]                         # A reporting-only skew group is a skew group whose cts_skew_group_constrains attribute is set to 'none'. Such a skew
[05/12 11:24:26    763s]                         # group imposes no clock balancing constraint and will not be considered by CTS.
[05/12 11:24:26    763s]                         # The typical example is a generated clock that is synchronous to its master
[05/12 11:24:26    763s]                         # clock. The relationship between the two clocks implies that the sinks of both
[05/12 11:24:26    763s]                         # clocks should be balanced together. To model this, a clock spec created for
[05/12 11:24:26    763s]                         # such a design will have the skew group corresponding to the master clock span
[05/12 11:24:26    763s]                         # the domain of both the master clock and also the generated clock. The skew
[05/12 11:24:26    763s]                         # group of the generated clock is then a subset of the master clock skew group:
[05/12 11:24:26    763s]                         # as such it is a redundant constraint, and may be safely omitted. If is
[05/12 11:24:26    763s]                         # synthesized, such a skew group will be created as a reporting-only skew group.
[05/12 11:24:26    763s]                         # When this attribute is set to false, reporting-only skew groups
[05/12 11:24:26    763s]                         # are completely omitted from the generated spec. When set to true,
[05/12 11:24:26    763s]                         # reporting-only skew groups are included in the generated spec, but are marked
[05/12 11:24:26    763s]                         # with the cts_skew_group_constrains attribute set to
[05/12 11:24:26    763s]                         # 'none'. Either way, they impose no balancing constraint.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_capacitance(root)
[05/12 11:24:26    763s]                         # string, read/write, default=top auto trunk auto leaf auto, indices=delay_corner
[05/12 11:24:26    763s]                         # The target maximum capacitive load to allow during clock tree synthesis. This
[05/12 11:24:26    763s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the clock
[05/12 11:24:26    763s]                         # tree synthesis algorithm will allow any given base_pin to drive in a given
[05/12 11:24:26    763s]                         # clock tree when driving a given net_type. It is specified in library units. It
[05/12 11:24:26    763s]                         # currently only constrains the primary delay corner capacitance values - other
[05/12 11:24:26    763s]                         # delay corners can be specified but will not be constrained. This attribute is
[05/12 11:24:26    763s]                         # applied in addition to the max_capacitance constraints read from the liberty
[05/12 11:24:26    763s]                         # library data - the tightest (lowest) of the constraint specified by this
[05/12 11:24:26    763s]                         # attribute and the constraint present in the liberty data will be used. It also
[05/12 11:24:26    763s]                         # does not apply at the root pins of clock trees - to constrain those nets the
[05/12 11:24:26    763s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used instead.
[05/12 11:24:26    763s]                         # Valid values: auto | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_capacitance_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=delay_corner
[05/12 11:24:26    763s]                         # The target maximum capacitive load to allow during clock tree synthesis. This
[05/12 11:24:26    763s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the clock
[05/12 11:24:26    763s]                         # tree synthesis algorithm will allow any given base_pin to drive in a given
[05/12 11:24:26    763s]                         # clock tree when driving a given net_type. It is specified in library units. It
[05/12 11:24:26    763s]                         # currently only constrains the primary delay corner capacitance values - other
[05/12 11:24:26    763s]                         # delay corners can be specified but will not be constrained. This attribute is
[05/12 11:24:26    763s]                         # applied in addition to the max_capacitance constraints read from the liberty
[05/12 11:24:26    763s]                         # library data - the tightest (lowest) of the constraint specified by this
[05/12 11:24:26    763s]                         # attribute and the constraint present in the liberty data will be used. It also
[05/12 11:24:26    763s]                         # does not apply at the root pins of clock trees - to constrain those nets the
[05/12 11:24:26    763s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used instead.
[05/12 11:24:26    763s]                         # Valid values: auto | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_capacitance_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=delay_corner
[05/12 11:24:26    763s]                         # The target maximum capacitive load to allow during clock tree synthesis. This
[05/12 11:24:26    763s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the clock
[05/12 11:24:26    763s]                         # tree synthesis algorithm will allow any given base_pin to drive in a given
[05/12 11:24:26    763s]                         # clock tree when driving a given net_type. It is specified in library units. It
[05/12 11:24:26    763s]                         # currently only constrains the primary delay corner capacitance values - other
[05/12 11:24:26    763s]                         # delay corners can be specified but will not be constrained. This attribute is
[05/12 11:24:26    763s]                         # applied in addition to the max_capacitance constraints read from the liberty
[05/12 11:24:26    763s]                         # library data - the tightest (lowest) of the constraint specified by this
[05/12 11:24:26    763s]                         # attribute and the constraint present in the liberty data will be used. It also
[05/12 11:24:26    763s]                         # does not apply at the root pins of clock trees - to constrain those nets the
[05/12 11:24:26    763s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used instead.
[05/12 11:24:26    763s]                         # Valid values: auto | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_capacitance_trunk(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=delay_corner
[05/12 11:24:26    763s]                         # The target maximum capacitive load to allow during clock tree synthesis. This
[05/12 11:24:26    763s]                         # attribute specifies a maximum (combined pin and wire) capacitance that the clock
[05/12 11:24:26    763s]                         # tree synthesis algorithm will allow any given base_pin to drive in a given
[05/12 11:24:26    763s]                         # clock tree when driving a given net_type. It is specified in library units. It
[05/12 11:24:26    763s]                         # currently only constrains the primary delay corner capacitance values - other
[05/12 11:24:26    763s]                         # delay corners can be specified but will not be constrained. This attribute is
[05/12 11:24:26    763s]                         # applied in addition to the max_capacitance constraints read from the liberty
[05/12 11:24:26    763s]                         # library data - the tightest (lowest) of the constraint specified by this
[05/12 11:24:26    763s]                         # attribute and the constraint present in the liberty data will be used. It also
[05/12 11:24:26    763s]                         # does not apply at the root pins of clock trees - to constrain those nets the
[05/12 11:24:26    763s]                         # cts_clock_tree_source_max_capacitance CCOpt attribute should be used instead.
[05/12 11:24:26    763s]                         # Valid values: auto | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_stage_delay_sigma(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices=delay_corner
[05/12 11:24:26    763s]                         # The max per-stage SOCV delay sigma target to use for CTS.
[05/12 11:24:26    763s]   cts_target_max_transition_time(root)
[05/12 11:24:26    763s]                         # string, read/write, default=top default trunk default leaf default, indices=delay_corner, power_domain
[05/12 11:24:26    763s]                         # The target slew used for clock tree synthesis. This attribute specifies a
[05/12 11:24:26    763s]                         # maximum slew time that the clock tree synthesis algorithm will allow in this
[05/12 11:24:26    763s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and 
[05/12 11:24:26    763s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate value
[05/12 11:24:26    763s]                         # based on the collection of allowed buffer sizes and library parameters,
[05/12 11:24:26    763s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[05/12 11:24:26    763s]                         # CTS does not constrain the corner.
[05/12 11:24:26    763s]                         # Valid values: default | auto | ignore | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_transition_time_leaf(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[05/12 11:24:26    763s]                         # The target slew used for clock tree synthesis. This attribute specifies a
[05/12 11:24:26    763s]                         # maximum slew time that the clock tree synthesis algorithm will allow in this
[05/12 11:24:26    763s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and 
[05/12 11:24:26    763s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate value
[05/12 11:24:26    763s]                         # based on the collection of allowed buffer sizes and library parameters,
[05/12 11:24:26    763s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[05/12 11:24:26    763s]                         # CTS does not constrain the corner.
[05/12 11:24:26    763s]                         # Valid values: default | auto | ignore | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_transition_time_top(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[05/12 11:24:26    763s]                         # The target slew used for clock tree synthesis. This attribute specifies a
[05/12 11:24:26    763s]                         # maximum slew time that the clock tree synthesis algorithm will allow in this
[05/12 11:24:26    763s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and 
[05/12 11:24:26    763s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate value
[05/12 11:24:26    763s]                         # based on the collection of allowed buffer sizes and library parameters,
[05/12 11:24:26    763s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[05/12 11:24:26    763s]                         # CTS does not constrain the corner.
[05/12 11:24:26    763s]                         # Valid values: default | auto | ignore | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_max_transition_time_trunk(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices=delay_corner, power_domain
[05/12 11:24:26    763s]                         # The target slew used for clock tree synthesis. This attribute specifies a
[05/12 11:24:26    763s]                         # maximum slew time that the clock tree synthesis algorithm will allow in this
[05/12 11:24:26    763s]                         # clock tree, in library units. 'default' means 'auto' in primary half corner and 
[05/12 11:24:26    763s]                         # 'ignore' in other half corners. If set to 'auto', CTS picks an appropriate value
[05/12 11:24:26    763s]                         # based on the collection of allowed buffer sizes and library parameters,
[05/12 11:24:26    763s]                         # although this may not give optimal quality of results. If set to 'ignore', 
[05/12 11:24:26    763s]                         # CTS does not constrain the corner.
[05/12 11:24:26    763s]                         # Valid values: default | auto | ignore | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_target_skew(root)
[05/12 11:24:26    763s]                         # string, read/write, default=default, indices=delay_corner
[05/12 11:24:26    763s]                         # This specifies the target skew for clock tree balancing. This may be set to a
[05/12 11:24:26    763s]                         # numeric value, or one of 'auto', 'ignore' or 'default'.
[05/12 11:24:26    763s]                         # If set to 'auto' this indicates that an appropriate skew target should be
[05/12 11:24:26    763s]                         # computed.
[05/12 11:24:26    763s]                         # If set to 'ignore' this indicates that skew should not be balanced for 
[05/12 11:24:26    763s]                         # this corner/path combination.
[05/12 11:24:26    763s]                         # If unspecified then the value of this attribute is 'default'.
[05/12 11:24:26    763s]                         # If the value of the attribute is 'default' the target skew for late delays in the
[05/12 11:24:26    763s]                         # primary delay corner is interpreted as 'auto' and as 'ignore' otherwise.
[05/12 11:24:26    763s]                         # Valid values: default | auto | ignore | double
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_timing_connectivity_based_skew_groups(root)
[05/12 11:24:26    763s]                         # string, read/write, default=off, indices={}
[05/12 11:24:26    763s]                         # SDC false path assertions may render a generated SDC clock asynchronous to its
[05/12 11:24:26    763s]                         # master clock. Under such a condition, the sinks of the generated clock need not
[05/12 11:24:26    763s]                         # be balanced against the sinks of the master clock: there are no timing paths
[05/12 11:24:26    763s]                         # between the two clocks that can be affected by inter-clock skew. This
[05/12 11:24:26    763s]                         # balancing 'relaxation' is realized by adjusting the skew groups that are
[05/12 11:24:26    763s]                         # generated for the two clocks.
[05/12 11:24:26    763s]                         # This attribute specifies which SDC assertions are considered when deciding
[05/12 11:24:26    763s]                         # whether a generated clock is asynchronous to its master. Valid values for this
[05/12 11:24:26    763s]                         # attribute are as follows:
[05/12 11:24:26    763s]                         # off               In this mode, every generated SDC clock is treated as
[05/12 11:24:26    763s]                         # being synchronous to its master SDC clock.
[05/12 11:24:26    763s]                         # clock_false_path  Only Clock/clock set_false_path and set_clock_group assertions
[05/12 11:24:26    763s]                         # are considered.
[05/12 11:24:26    763s]                         # Valid values: off clock_false_path
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_timing_connectivity_based_skew_groups_balance_master_clocks(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # This attribute has no effect if cts_timing_connectivity_based_skew_groups is set to 'off'.
[05/12 11:24:26    763s]                         # With timing connectivity based skew groups enabled, this attribute controls how
[05/12 11:24:26    763s]                         # CCOpt will address the synchrony of disjoint (i.e. non-overlapping) master
[05/12 11:24:26    763s]                         # (i.e. non-generated) SDC clocks.
[05/12 11:24:26    763s]                         # When this attribute is set to false, all disjoint master clocks are assumed to
[05/12 11:24:26    763s]                         # be mutually asynchronous. The skew groups generated by create_clock_tree_spec
[05/12 11:24:26    763s]                         # will not constrain the sinks of two such clocks to be balanced together.
[05/12 11:24:26    763s]                         # When this attribute is set to true, the synchrony of disjoint master clocks is
[05/12 11:24:26    763s]                         # determined by consulting the SDC assertions in accordance with the value of
[05/12 11:24:26    763s]                         # attribute cts_timing_connectivity_based_skew_groups.
[05/12 11:24:26    763s]                         # Additional skew groups will be generated by create_clock_tree_spec,
[05/12 11:24:26    763s]                         # such that the sinks of each pair of synchronous disjoint master clocks
[05/12 11:24:26    763s]                         # will be balanced together by CTS.
[05/12 11:24:26    763s]                         # Valid values true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_timing_connectivity_info(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # This attribute is populated by clock spec creation when timing
[05/12 11:24:26    763s]                         # connectivity based skew groups are enabled. Configuration of this attribute
[05/12 11:24:26    763s]                         # will be written to the generated spec. It documents the clock/clock balancing
[05/12 11:24:26    763s]                         # relationships that were determined for the production of timing connectivity
[05/12 11:24:26    763s]                         # based skew groups. This attribute is documenting only.
[05/12 11:24:26    763s]                         # If timing connectivity based skew groups are not enabled, this
[05/12 11:24:26    763s]                         # attribute is not populated by spec creation.
[05/12 11:24:26    763s]                         # The value of the attribute is a set of nested Tcl dictionaries,
[05/12 11:24:26    763s]                         # four levels in total. The top-level dictionary indicates the information
[05/12 11:24:26    763s]                         # category. Currently there is only one such category: 'clock_relationships'. The
[05/12 11:24:26    763s]                         # second level is keyed on constrained mode name; the lowest level dictionaries
[05/12 11:24:26    763s]                         # are both keyed on SDC clock name. These keys taken together identify two SDC
[05/12 11:24:26    763s]                         # clocks in a given constraint mode. The leaf value specifies the resolved
[05/12 11:24:26    763s]                         # balancing relationships between the two SDC clocks. It an enum with the
[05/12 11:24:26    763s]                         # following members:
[05/12 11:24:26    763s]                         # - direct   - The two clocks are determined to belong to the same clock group 
[05/12 11:24:26    763s]                         # and must be balanced together.
[05/12 11:24:26    763s]                         # - indirect - The two clocks do not belong to the same clock group; however
[05/12 11:24:26    763s]                         # by transitive closure they must balance together.
[05/12 11:24:26    763s]                         # Clocks in a direct or indirect balancing relationship will share one or more
[05/12 11:24:26    763s]                         # skew groups so as to ensure that their sinks are balanced together by CTS.
[05/12 11:24:26    763s]                         # Missing entries should be taken as 'need not balance'; i.e. the pair of SDC
[05/12 11:24:26    763s]                         # clocks have neither a direct nor indirect balancing relationship.
[05/12 11:24:26    763s]                         # The indirect balancing relationship can be explored in more detail using this
[05/12 11:24:26    763s]                         # same Tcl dictionary to probe out the transitive closure over the direct
[05/12 11:24:26    763s]                         # balancing relationships that link two indirect balance clocks together. For
[05/12 11:24:26    763s]                         # example if clock A directly balances with clock B only, and clock B directly
[05/12 11:24:26    763s]                         # balances with clock C only; then clock A indirectly balances with clock C.
[05/12 11:24:26    763s]                         # Below is an example dict value, corresponding to clock groups {clkA clkB} {clkB
[05/12 11:24:26    763s]                         # clkC} in constraint mode cm1, and clock groups {clkP clkQ} {clkR clkS} in
[05/12 11:24:26    763s]                         # constraint mode cm2.
[05/12 11:24:26    763s]                         # {clock_relationships  {cm1 {clkA {clkB direct clkC indirect}  clkB {clkA direct clkC direct}  clkC {clkA indirect clkB direct}}  cm2 {clkP {clkQ direct}  clkQ {clkP direct}  clkR {clkS
[05/12 11:24:26    763s]                         # direct}  clkS {clkR direct}}}}
[05/12 11:24:26    763s]                         # Notice that although they are in separate clock groups, clkA and clkC
[05/12 11:24:26    763s]                         # nevertheless indirectly balance. This is due to fact that clkB is present in
[05/12 11:24:26    763s]                         # both clock groups. Note also that we omit information about the relationship
[05/12 11:24:26    763s]                         # between clkP and clkS: they are 'need not balance'.
[05/12 11:24:26    763s]   cts_top_fanout_threshold(root)
[05/12 11:24:26    763s]                         # string, read/write, default=unset, indices={}
[05/12 11:24:26    763s]                         # Minimum number of transitive fanout in the clock tree for a net to be routed
[05/12 11:24:26    763s]                         # as a top net. Nets with at least this many sinks in their transitive fanout in
[05/12 11:24:26    763s]                         # the clock tree will have the special routing rules applied to them.
[05/12 11:24:26    763s]                         # Valid values: integer
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_update_clock_latency(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Determine whether to update IO latencies within ccopt_design.
[05/12 11:24:26    763s]                         # Valid values: true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_use_inverters(root)
[05/12 11:24:26    763s]                         # string, read/write, default=auto, indices={}
[05/12 11:24:26    763s]                         # Specifies whether clock tree synthesis should prefer to use inverters rather
[05/12 11:24:26    763s]                         # than buffers when balancing the clock tree. If set to true, CTS will use
[05/12 11:24:26    763s]                         # inverters for the clock tree balancing process. If set to false, CTS will use
[05/12 11:24:26    763s]                         # the minimum number of levels of inverters required to maintain logical
[05/12 11:24:26    763s]                         # correctness. If set to auto (the default) CTS will use what it considers to be
[05/12 11:24:26    763s]                         # the best combination of buffers and inverters to get optimal quality of
[05/12 11:24:26    763s]                         # results.
[05/12 11:24:26    763s]                         # Valid values: auto true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   cts_use_receiver_model_capacitance_for_drv(root)
[05/12 11:24:26    763s]                         # string, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # If auto, CCOpt will use receiver model capacitance for drv if global variable timing_report_use_receiver_model_capacitance is true.
[05/12 11:24:26    763s]                         # If true, CCOpt will use receiver model capacitance for drv even if timing_report_use_receiver_model_capacitance is false.
[05/12 11:24:26    763s]                         # If false, CCOpt will not use receiver model capacitance for drv.
[05/12 11:24:26    763s]                         # Valid values: auto true false
[05/12 11:24:26    763s] 
[05/12 11:24:26    763s]   current_design(root)  # design, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # current design
[05/12 11:24:26    763s]   dataflow_hinsts(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # specify hinst to be placed
[05/12 11:24:26    763s]   delay_corners(root)   # delay_corner*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Returns the information about the delay corners in the design.
[05/12 11:24:26    763s]   delaycal_accuracy_level(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # set accuracy level for delay calculation
[05/12 11:24:26    763s]   delaycal_advanced_node_pin_cap_settings(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Enable advanced node pin cap settings.
[05/12 11:24:26    763s]   delaycal_advanced_pin_cap_mode(root)
[05/12 11:24:26    763s]                         # enum {0 1 2}, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # Enable advanced receiver pin cap mode for base delay.
[05/12 11:24:26    763s]   delaycal_aging_activity_propagation_mode(root)
[05/12 11:24:26    763s]                         # enum {probabilistic worst_case}, read/write, default=probabilistic, indices={}
[05/12 11:24:26    763s]                         # activity (duty cycle and toggle rate) propagation mode
[05/12 11:24:26    763s]   delaycal_aging_constraints(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # enable aging constraints
[05/12 11:24:26    763s]   delaycal_aging_max_duty_cycle(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1.0, indices={}
[05/12 11:24:26    763s]                         # default maximum duty cycle
[05/12 11:24:26    763s]   delaycal_aging_max_toggle_rate(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1e+08, indices={}
[05/12 11:24:26    763s]                         # default maximum toggle rate (number of transitions per second)
[05/12 11:24:26    763s]   delaycal_aging_min_duty_cycle(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # default minimum duty cycle
[05/12 11:24:26    763s]   delaycal_aging_min_toggle_rate(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # default minimum toggle rate (number of transitions per second)
[05/12 11:24:26    763s]   delaycal_aging_recovery(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # enable aging recovery analysis
[05/12 11:24:26    763s]   delaycal_aging_sequential_activity_propagation(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # enable activity propagation through sequentials
[05/12 11:24:26    763s]   delaycal_aging_sequential_max_duty_cycle(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1.0, indices={}
[05/12 11:24:26    763s]                         # default sequential maximum duty cycle
[05/12 11:24:26    763s]   delaycal_aging_sequential_max_toggle_rate(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1e+08, indices={}
[05/12 11:24:26    763s]                         # default sequential maximum toggle rate (number of transitions per second)
[05/12 11:24:26    763s]   delaycal_aging_sequential_min_duty_cycle(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # default sequential minimum duty cycle
[05/12 11:24:26    763s]   delaycal_aging_sequential_min_toggle_rate(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # default sequential minimum toggle rate (number of transitions per second)
[05/12 11:24:26    763s]   delaycal_aging_type(root)
[05/12 11:24:26    763s]                         # enum {bti hci all}, read/write, default=all, indices={}
[05/12 11:24:26    763s]                         # type of aging analysis
[05/12 11:24:26    763s]   delaycal_aging_use_fixed_duty_cycle(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # enable fixed duty cycle instead of propagated duty cycle for aging
[05/12 11:24:26    763s]   delaycal_combine_mmmc(root)
[05/12 11:24:26    763s]                         # enum {none early_late early_late_corner}, read/write, default=early_late_corner, indices={}
[05/12 11:24:26    763s]                         # Specifies whether delay calculation runs are to be combined for delay calculation simulations
[05/12 11:24:26    763s]   delaycal_default_net_delay(root)
[05/12 11:24:26    763s]                         # string, read/write, default=1000ps, indices={}
[05/12 11:24:26    763s]                         # set default net delay.
[05/12 11:24:26    763s]   delaycal_default_net_load(root)
[05/12 11:24:26    763s]                         # string, read/write, default=0.5pf, indices={}
[05/12 11:24:26    763s]                         # set default net load.
[05/12 11:24:26    763s]   delaycal_degrade_slew_on_early_nets(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # Controls interconnect slew degradation for early paths.
[05/12 11:24:26    763s]   delaycal_early_irdrop_data_type(root)
[05/12 11:24:26    763s]                         # enum {best_average worst best average worst_average}, read/write, default=worst, indices={}
[05/12 11:24:26    763s]                         # IRDrop EIV DB EivMethod for early corner
[05/12 11:24:26    763s]   delaycal_enable_high_fanout(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Enables the default net delay which will be annotated on high fanout nets
[05/12 11:24:26    763s]   delaycal_enable_quiet_receivers_for_hold(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]   delaycal_enable_si(root)
[05/12 11:24:26    763s]                         # enum {true false}, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Enables SIAware delay calculation that also includes cross-talk induced delays.
[05/12 11:24:26    763s]   delaycal_enable_wire_load_model(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
