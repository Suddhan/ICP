[05/12 11:24:26    763s]   route_special_core_pin_site_rail_width(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # follow pin width at layer for specified site
[05/12 11:24:26    763s]   route_special_core_pin_snap_to(root)
[05/12 11:24:26    763s]                         # enum* {m1_pin opt_routing_track grid half_grid}, read/write, default=m1_pin, indices={}
[05/12 11:24:26    763s]                         # snap M2 followpin referred to M1 pin to position
[05/12 11:24:26    763s]   route_special_core_pin_stop_route(root)
[05/12 11:24:26    763s]                         # enum {RowEnd CellPinEnd}, read/write, default=RowEnd, indices={}
[05/12 11:24:26    763s]   route_special_endcap_as_core(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # route_special treat Endcap macro as Core macro
[05/12 11:24:26    763s]   route_special_extend_nearest_target(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # extend nearest target so that it can be connected
[05/12 11:24:26    763s]   route_special_jog_threshold_ratio(root)
[05/12 11:24:26    763s]                         # double, read/write, default=10.0, indices={}
[05/12 11:24:26    763s]                         # distance ratio between a jogging target and a straight target
[05/12 11:24:26    763s]   route_special_layer_non_preferred_direction_cost(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # layer cost of non-preferred direction
[05/12 11:24:26    763s]   route_special_layer_preferred_direction_cost(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
