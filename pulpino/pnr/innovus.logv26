[05/12 11:24:26    763s]   assign_pins_max_channel_width_as_abutted(root)
[05/12 11:24:26    763s]                         # double, read/write, default=3.0, indices={}
[05/12 11:24:26    763s]                         # If you set this parameter value then all channel less than equal to specified value will be considered as abutted and abutment rules will be applied
[05/12 11:24:26    763s]   assign_pins_max_distance_pair(root)
[05/12 11:24:26    763s]                         # double, read/write, default=50.0, indices={}
[05/12 11:24:26    763s]                         # Ignores moving corresponding connected pins of 2-pin-connection nets where distance (in microns) between the pins is equal or greater than distance specified
[05/12 11:24:26    763s]   assign_pins_off_stripe(root)
[05/12 11:24:26    763s]                         # enum {below all none}, read/write, default=none, indices={}
[05/12 11:24:26    763s]                         # Prevents the generation of pins on metal layers with respect to the power and ground stripe
[05/12 11:24:26    763s]   assign_pins_pin_to_stripe_distance(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Layer specific, keep distance (in microns) from pin to stripe
[05/12 11:24:26    763s]   assign_pins_pin_to_via_distance_non_preferred_direction(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
