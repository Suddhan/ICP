[05/12 11:24:26    763s]   route_special_signal_pin_as_pg(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # signal pins as PG pins
[05/12 11:24:26    763s]   route_special_split_long_via(root)
[05/12 11:24:26    763s]                         # string, read/write, default=0 0 -1 -1, indices={}
[05/12 11:24:26    763s]                         # Split vias longer than <threshold> into smaller vias with specified <step> and bottom/left end <offset> and vertical/horizontal <height>
[05/12 11:24:26    763s]   route_special_target_number(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # number of target to connect
[05/12 11:24:26    763s]   route_special_target_search_distance(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # target search distance
[05/12 11:24:26    763s]   route_special_time_limit(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # time limit (in seconds) that the router is allowed in routing each port
[05/12 11:24:26    763s]   route_special_via_connect_to_shape(root)
[05/12 11:24:26    763s]                         # enum* {padring ring stripe blockring blockpin coverpin noshape blockwire corewire followpin iowire}, read/write, default=padring ring stripe blockring blockpin coverpin noshape
[05/12 11:24:26    763s]                         # blockwire corewire followpin iowire, indices={}
[05/12 11:24:26    763s]                         # Make via connection to specified shapes
[05/12 11:24:26    763s]   route_special_via_through_to_closest_ring(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # A via should connect only to closest ring layer when multiple rings overlap
[05/12 11:24:26    763s]   route_special_welltap_as_endcap(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # route_special treat Welltap macro as Endcap macro
[05/12 11:24:26    763s]   route_trial_max_print_ignored_pad_nets(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # Number of nets to be printed connecting a pad term to a fterm without geometry
[05/12 11:24:26    763s]   route_types(root)     # route_type*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # All the route_types from create_route_type command.
[05/12 11:24:26    763s]   rows(root)            # row*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Short-cut for [get_db current_design .rows]
[05/12 11:24:26    763s]   run_abstract_abstract_blockage_cut_around_pin(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # For std cell, we do not want cover obs on pin. So:
[05/12 11:24:26    763s]                         # If -input_cell_type {std}, setting the value to all metal and via layer name list.
[05/12 11:24:26    763s]                         # If -input_cell_type {block} or -input_cell_type {io}, setting the value to all via layer name list.
[05/12 11:24:26    763s]   run_abstract_antenna_connectivity(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the layers for which connectivity is to be extracted. The syntax is {<layer1> <connect_layer> <layer2>}.
[05/12 11:24:26    763s]   run_abstract_antenna_diffusion_geometry(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies diffusion layer, followed by expression to remove gate channel area from diffusion region.
[05/12 11:24:26    763s]   run_abstract_antenna_gate_geometry(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies poly layer that forms a gate, and then the layer expression to derive the gate area. This option also triggers the creation of antenna models.
[05/12 11:24:26    763s]   run_abstract_blockage_detailed_layers(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the layers for which a detailed blockage model is to be created. The detailed blockage model generates blockages only where there are real shapes in the cell on the layer.
[05/12 11:24:26    763s]                         # This only applies to IO cells and block cells, it does not apply to standard cells.
[05/12 11:24:26    763s]   run_abstract_boundary_layers(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # By default this list is empty, and the prBoundary is used. The prBoundary comes from an explicit GDS layer that is used to compute the LEF SIZE (and OVERLAP OBS shapes for rectilinear
[05/12 11:24:26    763s]                         # boundaries). If there is no explicit GDS prBoundary layer, the boundary can be computed from the bounding box of geometries on this list of layers. Note, this option is almost never
[05/12 11:24:26    763s]                         # correct for core standard cells.
[05/12 11:24:26    763s]   run_abstract_cell_symmetry(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies a property value for cell symmetry. The valid values for the property symmetry include: {R0 | X | Y | R90 | X Y | X R90 | Y R90 | X Y R90}. Default {X Y}
[05/12 11:24:26    763s]   run_abstract_export_lef_version(root)
[05/12 11:24:26    763s]                         # enum {5.3 5.4 5.5 5.6 5.7 5.8}, read/write, default=5.7, indices={}
[05/12 11:24:26    763s]                         # Version of LEF to export. The default version is the same  as the version of technology LEF file being imported.
[05/12 11:24:26    763s]   run_abstract_extract_layers_power(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the layers through which the extractor extracts  each power net. This is used to reduce the search space if abstract is taking too much run time for each cell. Usually not
[05/12 11:24:26    763s]                         # applicable to standard cells. For blocks it is common to only extract the power nets on the top one or two metal layers.
[05/12 11:24:26    763s]   run_abstract_extract_layers_signal(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the layers through which the extractor extracts  each net. This is used to reduce the search space if abstract is taking too much run time for each cell. Usually not
[05/12 11:24:26    763s]                         # applicable to standard cells.
[05/12 11:24:26    763s]   run_abstract_extract_pin_layers_power(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Determines which of the shapes found by the extractor should be turned into pins. This argument is valid only if the associated layer, geometry specification and connectivity have been
[05/12 11:24:26    763s]                         # provided in the technology LEF. Usually not applicable to standard cells.
[05/12 11:24:26    763s]   run_abstract_extract_pin_layers_signal(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Determines which of the shapes found by the extractor  should be turned into pins. This argument is valid only if the associated layer, geometry specification and connectivity have been
[05/12 11:24:26    763s]                         # provided in the technology LEF. Usually not applicable to standard cells.
[05/12 11:24:26    763s]   run_abstract_input_cell_type(root)
[05/12 11:24:26    763s]                         # enum {std io block}, read/write, default=std, indices={}
[05/12 11:24:26    763s]                         # Choose the cell type being translated with abstract. The tool adjusts its settings based on this selection. Optional.
[05/12 11:24:26    763s]   run_abstract_input_lef_tech_file(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Input technology LEF file. This is used to get all the layer names, their types (routing, cut, etc.) and the layer order for extracting connectivity. Required.
[05/12 11:24:26    763s]   run_abstract_input_stream_layer_map_file(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specify the file that maps GDS layer number / data type to LEF layer names in the Virtuoso format. Required.
[05/12 11:24:26    763s]                         # For example, the gds file is not colorized, you could use the common virtuoso format gds layer map to stream gds file.
[05/12 11:24:26    763s]                         # #layer name #purpose name #stream layer #stream data type
[05/12 11:24:26    763s]                         # V0 drawing 35 0
[05/12 11:24:26    763s]                         # V0 drawing 35 235
[05/12 11:24:26    763s]                         # V0 drawing 35 236
[05/12 11:24:26    763s]                         # M1 drawing 15 0
[05/12 11:24:26    763s]                         # M1 drawing 15 235
[05/12 11:24:26    763s]                         # M1 drawing 15 236
[05/12 11:24:26    763s]                         # M1 drawing 15 239
[05/12 11:24:26    763s]                         # For example, the gds file is colorized, you could specify the mask color in gds layer map to stream gds file.
[05/12 11:24:26    763s]                         # #layer name #purpose name #stream layer #stream data type #photo mask color #color state
[05/12 11:24:26    763s]                         # V0 drawing 35 0
[05/12 11:24:26    763s]                         # V0 drawing 35 235 mask1Color unlocked
[05/12 11:24:26    763s]                         # V0 drawing 35 236 mask2Color unlocked
[05/12 11:24:26    763s]                         # M1 drawing 15 0
[05/12 11:24:26    763s]                         # M1 drawing 15 235 mask1Color unlocked
[05/12 11:24:26    763s]                         # M1 drawing 15 236 mask2Color unlocked
[05/12 11:24:26    763s]                         # M1 drawing 15 239 mask3Color unlocked
[05/12 11:24:26    763s]   run_abstract_keep_output_files(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Do not clean up temporary files/libraries that are created in the process after command finishes.
[05/12 11:24:26    763s]   run_abstract_pins_analog_names(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Identifies analog  pin names based on label strings in the Abstract to set the LEF "USE ANALOG" property. Enter a list of possible names for the analog pins. This can be a list of
[05/12 11:24:26    763s]                         # regular expressions, each separated by a space.
[05/12 11:24:26    763s]   run_abstract_pins_clock_names(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Identifies clock pin names based on label strings in the Abstract to set the LEF "USE CLOCK" property. Enter a list of possible names for the clock pins. This can be a list of regular
[05/12 11:24:26    763s]                         # expressions, each separated by a space.
[05/12 11:24:26    763s]   run_abstract_pins_ground_names(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Identifies ground pins based on label strings in the Abstract to set the LEF "USE GROUND" property. Enter a list of possible names for the ground pins. This can be a list of regular
[05/12 11:24:26    763s]                         # expressions, each separated by a space.
[05/12 11:24:26    763s]   run_abstract_pins_output_names(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Identifies output pins based on label strings in the GDS to set the LEF direction to OUTPUT. Enter a list of regular expressions separated by spaces.
[05/12 11:24:26    763s]   run_abstract_pins_power_names(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Identifies power pin names based on label strings in the Abstract to set the LEF "USE POWER" property. Enter a list of possible names for the power pins. This can be a list of regular
[05/12 11:24:26    763s]                         # expressions, each separated by a space.
[05/12 11:24:26    763s]   run_abstract_pins_text_pin_map(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Maps text labels to pins on nets. Specify the layer purpose pairs based on which you want the abstract generator to search for geometry of any given layer-purpose pair with a text
[05/12 11:24:26    763s]                         # label.
[05/12 11:24:26    763s]   run_abstract_pre_abstract_script(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # a skill file that will be executed in abstract before the auto-generated script is executed. Optional.
[05/12 11:24:26    763s]   run_abstract_selected_cells(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Select cells to create abstract for using regex style expressions. Optional.
[05/12 11:24:26    763s]   run_abstract_site_name(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Site to be used for macros. This site will be added to all the cells.
[05/12 11:24:26    763s]   run_abstract_verbose(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Verbose mode with extra print.
[05/12 11:24:26    763s]   script_search_path(root)
[05/12 11:24:26    763s]                         # string, read/write, default=., indices={}
[05/12 11:24:26    763s]                         # The variable provides a set of directories for the software to search for files that sourced using the Tcl 'source' command.  The software will search in each search path directory for
[05/12 11:24:26    763s]                         # the specified file. 
[05/12 11:24:26    763s]   selected(root)        # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # The list of currently selected objects. It can be set to a list of objects as long as they are selectable.
[05/12 11:24:26    763s]   set_db_verbose(root)  # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specifies additional messages are issued describing what attribute is being set on what object.
[05/12 11:24:26    763s]   setup_views(root)     # analysis_view*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # Returns the information about the setup analysis views in the design.
[05/12 11:24:26    763s]   si_accumulated_small_aggressor_factor(root)
[05/12 11:24:26    763s]                         # double, read/write, default=1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the multiplication factor that controls the effect of the cap mode accumulated small attacker.
[05/12 11:24:26    763s]   si_accumulated_small_aggressor_mode(root)
[05/12 11:24:26    763s]                         # enum {cap current zero_mean}, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specifies the multiplication factor that controls the effect of the cap mode accumulated small attacker.
[05/12 11:24:26    763s]   si_accumulated_small_aggressor_threshold(root)
[05/12 11:24:26    763s]                         # double, read/write, default=10.01, indices={}
[05/12 11:24:26    763s]                         # Specifies whether to use the current-matching based method for accumulated small attackers.
[05/12 11:24:26    763s]   si_aggressor_alignment(root)
