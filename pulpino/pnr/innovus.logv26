[05/12 11:24:26    763s]                         # Ignore geometries of cell blockage.
[05/12 11:24:26    763s]   check_drc_ignore_non_rectangle_shapes(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # ignore non-rectangle shapes.
[05/12 11:24:26    763s]   check_drc_ignore_trial_route(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Ignore trial route when check drc.
[05/12 11:24:26    763s]   check_drc_inside_via_def(root)
