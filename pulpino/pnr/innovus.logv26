[05/12 11:24:26    763s]                         # finfet placement grid. The default is placement_grid. For Finfet design, the default is finfet_placement_grid.
[05/12 11:24:26    763s]   floorplan_snap_die_grid(root)
[05/12 11:24:26    763s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst finfet_manufacturing finfet_placement}, read/write, default=placement, indices={}
[05/12 11:24:26    763s]                         # Specify the die snap rules. It can be set to snap to manufacture grid, instance grid, placement grid, user-define grid, layer_track grid, finfet manufacture grid, finfet instance grid,
[05/12 11:24:26    763s]                         # finfet placement grid. The default is placement_grid. For Finfet design, the default is finfet_placement_grid.
[05/12 11:24:26    763s]   floorplan_snap_io_grid(root)
