[05/12 11:24:26    763s]   assign_pins_allow_non_ndr_net_pins_on_ndr_tracks(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # A true value allows general pins to be placed on ndr tracks if available. Alternately, if the value is set to false, the ndr-track rule is followed strictly and the net's pins are
[05/12 11:24:26    763s]                         # placed on matching ndr tracks only.
[05/12 11:24:26    763s]   assign_pins_allow_unconnected_in_abutted_edge(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
[05/12 11:24:26    763s]                         # If you use this parameter, unconnected partition pin can be placed in abutted edge
[05/12 11:24:26    763s]   assign_pins_blocked_boundary_macro_distance(root)
[05/12 11:24:26    763s]                         # double, read/write, default=3.0, indices={}
[05/12 11:24:26    763s]                         # This option blocks automatic pin assignment, from putting pins on the part of partition boundary facing block on layers with OBS, in the places where channel width between partition
[05/12 11:24:26    763s]                         # boundary and block is less than the value specified. For channel width below specified value, block all pins on boundary facing this channel on layers with OBS.
[05/12 11:24:26    763s]   assign_pins_edit_in_batch(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # To enable/disable pin-editing in batch mode.
[05/12 11:24:26    763s]   assign_pins_force_abutment_with_fixed(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=true, indices={}
