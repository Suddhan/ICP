[05/12 11:24:26    763s]   check_drc_limit(root)
[05/12 11:24:26    763s]                         # int, read/write, default=1000, indices={}
[05/12 11:24:26    763s]                         # Specifies the maximum number of errors to report
[05/12 11:24:26    763s]   check_drc_max_wrong_way_halo(root)
[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the maximum wrong way halo
[05/12 11:24:26    763s]   check_drc_ndr_spacing(root)
