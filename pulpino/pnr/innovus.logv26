[05/12 11:24:26    763s]   clock_tree_source_groups(root)
[05/12 11:24:26    763s]                         # clock_tree_source_group*, read-only, default={}, indices={}
[05/12 11:24:26    763s]                         # list of clock_tree_source_group
[05/12 11:24:26    763s]   clock_trees(root)     # clock_tree*, read-only, default={}, indices={}
