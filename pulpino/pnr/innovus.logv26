[05/12 11:24:26    763s]   check_drc_short_only(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Exclude all DRC check except short.
[05/12 11:24:26    763s]   check_drc_trim_length(root)
