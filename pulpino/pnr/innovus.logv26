[05/12 11:24:26    763s]                         # double, read/write, default=-1.0, indices={}
[05/12 11:24:26    763s]                         # Specifies the minimum % of total available budget set aside for the top level
[05/12 11:24:26    763s]   budget_top_level_delay_per_length(root)
[05/12 11:24:26    763s]                         # int, read/write, default=180, indices={}
[05/12 11:24:26    763s]                         # Specifies the top-level estimated delay (in picoseconds) per millimeter length.
[05/12 11:24:26    763s]   budget_top_level_min_delay_per_net(root)
[05/12 11:24:26    763s]                         # int, read/write, default=100, indices={}
[05/12 11:24:26    763s]                         # Specifies the top-level minimum delay-per-net value in picoseconds/millimeter units.
[05/12 11:24:26    763s]   budget_use_boundary_condition(root)
[05/12 11:24:26    763s]                         # enum {optimized template actual empty}, read/write, default=template, indices={}
[05/12 11:24:26    763s]                         # Mechanism used for finding buffers to be used as driver/load
[05/12 11:24:26    763s]   budget_use_real_cell_for_timing_model(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Use actual gate connected to the partition port to write out the model timing arc, else medium size buffer is used
[05/12 11:24:26    763s]   budget_virtual_opt_engine(root)
[05/12 11:24:26    763s]                         # enum {none opt early_timing_engine proto}, read/write, default=none, indices={}
