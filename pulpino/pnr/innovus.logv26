[05/12 11:24:26    763s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[05/12 11:24:26    763s]                         # The inst grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin is lower left corner of core box (e.g. the core rows). The x_pitch is default technical site's width and
[05/12 11:24:26    763s]                         # separates the vertical grid lines. The y_pitch is default technical site¡¯s height and separates the horizontal grid lines.
[05/12 11:24:26    763s]   floorplan_keep_rows_when_moving_power_domain(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # specify whether to keep all existing rows in disjoint power domain when moving, resizing or reshaping a power domain on GUI or by command. 
[05/12 11:24:26    763s]   floorplan_layer_track_grid(root)
[05/12 11:24:26    763s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[05/12 11:24:26    763s]                         # The layer_track grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin is lower left corner of die box  (the design .boundary). The x_pitch is the pitch of lowest vertical
[05/12 11:24:26    763s]                         # metal layer and separates the vertical grid lines. The y_pitch is the pitch of lowest horizontal metal layer and separates the horizontal grid lines.
[05/12 11:24:26    763s]   floorplan_manufacturing_grid(root)
[05/12 11:24:26    763s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[05/12 11:24:26    763s]                         # The manufacturing grid is in the format {x_origin y_origin x_pitch y_pitch} from the LEF global MANUFACTURINGGRID statement. The x_origin y_origin is lower left corner of die box(the
[05/12 11:24:26    763s]                         # design .boundary). See the layer .mfg_grid values if the mfg_grid varies per layer.
[05/12 11:24:26    763s]   floorplan_max_io_height(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Use maximum IO height to calculate a die box with IO placement. By default, minimum IO height is used.
[05/12 11:24:26    763s]   floorplan_minimum_sites(root)
[05/12 11:24:26    763s]                         # int, read/write, default=0, indices={}
[05/12 11:24:26    763s]                         # Specify the number of minimal sites (N) that check_floorplan will check for the same length site rule. When same_length_site is specified in floorplan_check_types, this option is
[05/12 11:24:26    763s]                         # required.
[05/12 11:24:26    763s]   floorplan_move_macros_with_constraint(root)
[05/12 11:24:26    763s]                         # enum* {guide region fence none all}, read/write, default=fence, indices={}
[05/12 11:24:26    763s]                         # Specify macros move with constraint modules at the same time.
[05/12 11:24:26    763s]   floorplan_move_preplaced_std_cell_only(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specify only pre-placed std cells move with constraint modules at the same time.
[05/12 11:24:26    763s]   floorplan_move_std_cell_with_constraint(root)
[05/12 11:24:26    763s]                         # enum* {guide region fence none all}, read/write, default=none, indices={}
[05/12 11:24:26    763s]                         # Specify std cells move with constraint modules at the same time.
[05/12 11:24:26    763s]   floorplan_narrow_channel_threshold(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # Reports narrow channels whose width (in micros) is smaller than the specified value. When narrow_channel is specified in floorplan_check_types, this option is required.
[05/12 11:24:26    763s]   floorplan_no_cut_row(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specify no need to do cut row before other operations.
[05/12 11:24:26    763s]   floorplan_placement_grid(root)
[05/12 11:24:26    763s]                         # rect, read-only, default=0.0 0.0 0.0 0.0, indices={}
[05/12 11:24:26    763s]                         # The placement grid {x_origin y_origin x_pitch y_pitch}. The x_origin y_origin is lower left corner of die box (the design .boundary). The x_pitch is the pitch of lowest  vertical metal
[05/12 11:24:26    763s]                         # layer and separates the vertical grid lines. The y_pitch is pitch of lowest horizontal metal layer and separates the horizontal grid lines.
[05/12 11:24:26    763s]   floorplan_power_rail_layer(root)
[05/12 11:24:26    763s]                         # string, read/write, default={}, indices={}
[05/12 11:24:26    763s]                         # Specify the layers for calculating power/ground on bottom attribute of cell or techsite. By default, the lowest metal layer is used.
[05/12 11:24:26    763s]   floorplan_row_site_height(root)
[05/12 11:24:26    763s]                         # enum {any odd even}, read/write, default=any, indices={}
[05/12 11:24:26    763s]                         # Specify the odd even row height constraints.
[05/12 11:24:26    763s]   floorplan_row_site_width(root)
[05/12 11:24:26    763s]                         # enum {any odd even}, read/write, default=any, indices={}
[05/12 11:24:26    763s]                         # Specify the odd even row width constraints.
[05/12 11:24:26    763s]   floorplan_snap_all_corners_to_grid(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
[05/12 11:24:26    763s]                         # Specify to snap all corners of object to grid.
[05/12 11:24:26    763s]   floorplan_snap_block_grid(root)
[05/12 11:24:26    763s]                         # enum {manufacturing inst placement user_define layer_track finfet_inst finfet_manufacturing finfet_placement}, read/write, default=manufacturing, indices={}
[05/12 11:24:26    763s]                         # Specify the block snap rules. It can be set to snap to manufacture grid, instance grid, placement grid, user-define grid, layer_track grid, finfet manufacture grid, finfet instance
[05/12 11:24:26    763s]                         # grid, finfet placement grid. The default is manufacturing_grid. For Finfet design, the default is finfet_manufacturing_grid.
[05/12 11:24:26    763s]   floorplan_snap_constraint_grid(root)
