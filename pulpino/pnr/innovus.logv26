[05/12 11:24:26    763s]   route_special_core_pin_length(root)
[05/12 11:24:26    763s]                         # double, read/write, default=0.0, indices={}
[05/12 11:24:26    763s]                         # connect core pins of at least specified length
[05/12 11:24:26    763s]   route_special_core_pin_length_as_inst(root)
[05/12 11:24:26    763s]                         # bool, read/write, default=false, indices={}
