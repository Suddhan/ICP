[05/12 11:24:26    763s]                         # enum* {jog2jog_spacing eol_spacing cut_spacing min_cut enclosure color min_step protrusion min_area out_of_die off_manufacturing_grid off_routing_track}, read/write, default={},
[05/12 11:24:26    763s]                         # indices={}
