create_clock -name "CLK" -period 8.0 -waveform {0.0 4.0} [get_ports clk]
create_clock -name "JTAG_CLK" -period 100.0 -waveform {0.0 50.0} [get_ports tck_i]
create_clock -name "SPI_CLK" -period 40.0 -waveform {0.0 20.0} [get_ports spi_clk_i]
create_clock -name "VCLK_ASYNC" -period 100.0 -waveform {0.0 50.0} 
set_load -pin_load 0.05 [get_ports tdo_o]
set_load -pin_load 0.05 [get_ports uart_tx]
set_load -pin_load 0.05 [get_ports spi_sdo0_o]
set_load -pin_load 0.05 [get_ports spi_sdo1_o]
set_load -pin_load 0.05 [get_ports spi_sdo2_o]
set_load -pin_load 0.05 [get_ports spi_sdo3_o]
set_load -pin_load 0.05 [get_ports {spi_mode_o[1]}]
set_load -pin_load 0.05 [get_ports {spi_mode_o[0]}]
set_load -pin_load 0.05 [get_ports pad_gpio]
set_false_path -from [get_ports rst_n]
set_clock_groups -name "clock_groups_CLK_to_JTAG_CLK_to_SPI_CLK_to_VCLK_ASYNC" -asynchronous -group [get_clocks CLK] -group [get_clocks JTAG_CLK] -group [get_clocks SPI_CLK] -group [get_clocks VCLK_ASYNC]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports rst_n]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports uart_rx]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports spi_sdi0_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports spi_sdi1_i]
