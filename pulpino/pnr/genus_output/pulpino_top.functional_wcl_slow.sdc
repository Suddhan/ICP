set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports spi_sdi3_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports spi_cs_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports tms_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports tdi_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports trstn_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports scl_pad_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports sda_pad_i]
set_input_delay -clock [get_clocks VCLK_ASYNC] -add_delay 1.6 [get_ports fetch_enable_i]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports tdo_o]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports uart_tx]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports spi_sdo0_o]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports spi_sdo1_o]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports spi_sdo2_o]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports spi_sdo3_o]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports {spi_mode_o[1]}]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports {spi_mode_o[0]}]
set_output_delay -clock [get_clocks CLK] -add_delay 1.6 [get_ports pad_gpio]
set_driving_cell -lib_cell HS65_LL_BFX2 -library CORE65LPLVT -pin "Z" [get_ports clk]
set_driving_cell -lib_cell HS65_LL_BFX2 -library CORE65LPLVT -pin "Z" [get_ports rst_n]
set_driving_cell -lib_cell HS65_LL_BFX2 -library CORE65LPLVT -pin "Z" [get_ports tck_i]
