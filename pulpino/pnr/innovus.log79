@file 199: # Set well tap cell to be used
@@file 200: set_db add_well_taps_cell HS65_LH_FILLERNPWPFP4
@file 201:
@file 202: # Create well taps
@file 203: # Explanation : We need to add well taps, to bias the bulk of the transistors to the correct potential
@file 204: #               According to the documentation, the maximum distance a cell can have to a well tap is 30um.
@file 205: #               This means that if we space the well taps with 60um, all cells will be within the 30um range of a tap.
@@file 206: add_well_taps -cell_interval 60
