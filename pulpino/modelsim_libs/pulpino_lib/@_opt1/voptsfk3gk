library verilog;
use verilog.vl_types.all;
entity boot_code is
    port(
        CLK             : in     vl_logic;
        RSTN            : in     vl_logic;
        CSN             : in     vl_logic;
        A               : in     vl_logic_vector(9 downto 0);
        Q               : out    vl_logic_vector(31 downto 0)
    );
end boot_code;
