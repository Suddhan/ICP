library verilog;
use verilog.vl_types.all;
entity spi_master_controller is
    port(
        clk             : in     vl_logic;
        rstn            : in     vl_logic;
        eot             : out    vl_logic;
        spi_clk_div     : in     vl_logic_vector(7 downto 0);
        spi_clk_div_valid: in     vl_logic;
        spi_status      : out    vl_logic_vector(6 downto 0);
        spi_addr        : in     vl_logic_vector(31 downto 0);
        spi_addr_len    : in     vl_logic_vector(5 downto 0);
        spi_cmd         : in     vl_logic_vector(31 downto 0);
        spi_cmd_len     : in     vl_logic_vector(5 downto 0);
        spi_data_len    : in     vl_logic_vector(15 downto 0);
        spi_dummy_rd    : in     vl_logic_vector(15 downto 0);
        spi_dummy_wr    : in     vl_logic_vector(15 downto 0);
        spi_csreg       : in     vl_logic_vector(3 downto 0);
        spi_swrst       : in     vl_logic;
        spi_rd          : in     vl_logic;
        spi_wr          : in     vl_logic;
        spi_qrd         : in     vl_logic;
        spi_qwr         : in     vl_logic;
        spi_ctrl_data_tx: in     vl_logic_vector(31 downto 0);
        spi_ctrl_data_tx_valid: in     vl_logic;
        spi_ctrl_data_tx_ready: out    vl_logic;
        spi_ctrl_data_rx: out    vl_logic_vector(31 downto 0);
        spi_ctrl_data_rx_valid: out    vl_logic;
        spi_ctrl_data_rx_ready: in     vl_logic;
        spi_clk         : out    vl_logic;
        spi_csn0        : out    vl_logic;
        spi_csn1        : out    vl_logic;
        spi_csn2        : out    vl_logic;
        spi_csn3        : out    vl_logic;
        spi_mode        : out    vl_logic_vector(1 downto 0);
        spi_sdo0        : out    vl_logic;
        spi_sdo1        : out    vl_logic;
        spi_sdo2        : out    vl_logic;
        spi_sdo3        : out    vl_logic;
        spi_sdi0        : in     vl_logic;
        spi_sdi1        : in     vl_logic;
        spi_sdi2        : in     vl_logic;
        spi_sdi3        : in     vl_logic
    );
end spi_master_controller;
